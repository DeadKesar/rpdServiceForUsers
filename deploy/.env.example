# Образец настроек стенда. Скопируйте в deploy/.env и заполните; .env в git не попадает.
# Пароли базы и сертификатов — только латинские буквы и цифры (пароль базы входит в строку подключения).
# Пароль администратора и пароль почты берите в одинарные кавычки: тогда $ и # не читаются как служебные знаки.

# --- Обязательные ---

# Имя стенда в сети кафедры (или его постоянный адрес), по которому его открывают пользователи: без https:// и порта,
# имя — строчными латинскими буквами. Из него строятся Auth:PublicUrl и Mail:PublicUrl.
STAND_HOST=

# Постоянный адрес IPv4 компьютера: попадает в сертификат вместе с именем. Нет постоянного адреса — оставьте пустым.
STAND_IP=

# Пароль базы данных. Действует с первого запуска: смена здесь не меняет пароль в уже созданной базе.
DB_PASSWORD=

# Пароль файлов сертификатов входа (signing.pfx, encryption.pfx).
CERT_PASSWORD=

# --- Первый администратор: заполнить до первого запуска, после первого входа очистить обе строки ---

# Пароль — не короче 8 символов: заглавная и строчная буквы, цифра, спецсимвол.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Почта: пусто — выключена ---

# true — письма отправляются. Пусто — не отправляются; уведомления в интерфейсе работают.
MAIL_ENABLED=
# Куда хост отдаёт письма. Пусто — свой почтовый сервер стенда (служба mail). Корпоративный сервер — его имя, порт,
# вход и режим шифрования; тогда службу mail можно остановить.
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
# Auto, None, StartTls или SslOnConnect. Пусто — None (своя почта стенда во внутренней сети).
MAIL_SECURITY=
# Отправитель: «Имя <адрес>» или адрес.
MAIL_FROM=

# --- Свой почтовый сервер стенда (служба mail) ---

# Домен адреса отправителя из MAIL_FROM: письма от других доменов сервер не принимает.
MAIL_DOMAIN=
# Имя сервера в приветствии. Пусто — STAND_HOST. Для антиспама должно совпадать с обратной записью адреса стенда.
MAIL_HOSTNAME=
# Ретранслятор «[сервер]:порт» (например [smtp.example.ru]:587) и вход на нём. Пусто — доставка напрямую получателям.
MAIL_RELAY=
MAIL_RELAY_USER=
MAIL_RELAY_PASSWORD=
# Любое значение (например 1) — письма подписываются DKIM; нужен свой домен.
MAIL_DKIM=
