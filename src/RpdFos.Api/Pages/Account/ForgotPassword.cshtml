@page
@model RpdFos.Api.Pages.Account.ForgotPasswordModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Восстановление пароля";
}
<h1>Забыли пароль?</h1>
@if (Model.Sent)
{
    @* Один и тот же ответ на любой адрес: страница не выдаёт, зарегистрирован ли он. *@
    <p class="ok" role="status">Если адрес зарегистрирован, письмо со ссылкой для нового пароля отправлено.</p>
    <p>Письмо может прийти не сразу. Если его нет, проверьте папку «Спам» или обратитесь к администратору.</p>
}
else
{
    <p>Укажите email, на который заведена учётная запись: на него придёт ссылка для нового пароля.</p>
    <form method="post">
        <label asp-for="Email">Email</label>
        <input asp-for="Email" autocomplete="username" />
        <span class="err" asp-validation-for="Email"></span>
        <button type="submit">Отправить ссылку</button>
    </form>
}
<p><a asp-page="Login">Ко входу</a></p>
