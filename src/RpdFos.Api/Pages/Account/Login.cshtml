@page
@model RpdFos.Api.Pages.Account.LoginModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Вход";
}
<h1>Вход</h1>
<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />

    <label asp-for="Email">Email</label>
    <input asp-for="Email" autocomplete="username" />
    <span class="err" asp-validation-for="Email"></span>

    <label asp-for="Password">Пароль</label>
    <input asp-for="Password" autocomplete="current-password" />
    <span class="err" asp-validation-for="Password"></span>

    @if (Model.Error is not null)
    {
        <p class="err">@Model.Error</p>
    }

    <button type="submit">Войти</button>
</form>
<p><a asp-page="ForgotPassword">Забыли пароль?</a></p>
