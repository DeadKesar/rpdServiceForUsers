@page
@model RpdFos.Api.Pages.Account.SetPasswordModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Новый пароль";
}
<h1>Новый пароль</h1>
@if (Model.Done)
{
    <p class="ok" role="status">Пароль задан. Теперь можно войти.</p>
    @* Адрес запускает вход клиента: на его начальной странице (/) «Войдите» пришлось бы нажимать ещё раз. *@
    <p><a href="/authentication/login">Войти</a></p>
}
else
{
    <form method="post">
        @* Идентификатор и токен приходят во фрагменте адреса (после #): браузер не отправляет его серверу, и токен не
           попадает в журналы хоста и прокси. Скрипт переносит их в скрытые поля. *@
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Token" />

        <label asp-for="Password">Новый пароль</label>
        <input asp-for="Password" autocomplete="new-password" />
        <span class="err" asp-validation-for="Password"></span>

        <label asp-for="Confirm">Повторите пароль</label>
        <input asp-for="Confirm" autocomplete="new-password" />
        <span class="err" asp-validation-for="Confirm"></span>

        @foreach (var error in Model.Errors)
        {
            <p class="err">@error</p>
        }

        <button type="submit">Задать пароль</button>
    </form>
    <noscript><p class="err">Для этой страницы нужен включённый JavaScript.</p></noscript>
    <script>
        (function () {
            var parts = new URLSearchParams(location.hash.slice(1));
            var user = parts.get('u'), token = parts.get('t');
            if (!user || !token) return;
            document.getElementById('UserId').value = user;
            document.getElementById('Token').value = token;
        })();
    </script>
    <p>Пароль — не короче 8 символов, с заглавной и строчной буквой, цифрой и знаком (например, «-» или «!»).</p>
    <p><a asp-page="ForgotPassword">Запросить новую ссылку</a></p>
}
