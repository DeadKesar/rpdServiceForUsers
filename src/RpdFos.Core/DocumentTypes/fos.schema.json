{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stankin.ru/schemas/fos/v1.json",
  "title": "Фонд оценочных средств (ФОС)",
  "type": "object",
  "required": ["title_page", "linked_rpd", "competence_indicators", "passport", "approval_sheet"],
  "properties": {

    "title_page": {
      "$ref": "https://stankin.ru/schemas/rpd/v1.json#/properties/title_page"
    },

    "linked_rpd": {
      "type": "object",
      "title": "Связь с РПД",
      "description": "Документ РПД и снимок наследуемых из неё данных на момент создания ФОС или обновления из РПД",
      "required": ["rpd_document_id", "rpd_version"],
      "properties": {
        "rpd_document_id": { "type": "string", "format": "uuid" },
        "rpd_version": { "type": "integer" },
        "snapshot_at": { "type": "string", "format": "date-time", "readOnly": true, "description": "Когда снят снимок данных РПД" },
        "competences": {
          "type": "array",
          "title": "Компетенции и индикаторы РПД",
          "readOnly": true,
          "items": {
            "type": "object",
            "required": ["code", "indicators"],
            "properties": {
              "code": { "$ref": "#/$defs/competence_code" },
              "formulation": { "type": "string" },
              "indicators": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["code"],
                  "properties": {
                    "code": { "$ref": "#/$defs/indicator_code" },
                    "text": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "sections": {
          "type": "array",
          "title": "Разделы РПД",
          "description": "Из тематического плана: название раздела для паспорта — темы раздела через запятую",
          "readOnly": true,
          "items": {
            "type": "object",
            "required": ["number"],
            "properties": {
              "number": { "type": "integer", "minimum": 1 },
              "title": { "type": "string" },
              "semesters": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 12 } },
              "competence_codes": { "type": "array", "items": { "$ref": "#/$defs/competence_code" } },
              "indicator_codes": { "type": "array", "items": { "$ref": "#/$defs/indicator_code" } },
              "current_control_forms": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "semesters": {
          "type": "array",
          "title": "Виды промежуточной аттестации по семестрам РПД",
          "readOnly": true,
          "items": {
            "type": "object",
            "required": ["number"],
            "properties": {
              "number": { "type": "integer", "minimum": 1, "maximum": 12 },
              "control_types": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["exam", "credit", "graded_credit", "course_project", "course_work"],
                  "x-enum-titles": {
                    "exam": "Экзамен", "credit": "Зачёт", "graded_credit": "Дифференцированный зачёт",
                    "course_project": "Курсовой проект", "course_work": "Курсовая работа"
                  }
                }
              }
            }
          }
        }
      },
      "x-validation-rule": "linked_rpd_must_be_approved_or_under_review"
    },

    "competence_indicators": {
      "type": "array",
      "title": "Индикаторы достижения компетенций",
      "x-source": "linked_rpd.competences.indicators",
      "x-readonly": true,
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    },

    "passport": {
      "type": "object",
      "title": "Паспорт ФОС",
      "x-validation-rule": "fos_passport_consistent",
      "properties": {
        "sections": {
          "type": "array",
          "title": "Разделы дисциплины, компетенции и задания",
          "items": {
            "type": "object",
            "required": ["section_number", "competence_codes", "tasks"],
            "properties": {
              "section_number": { "type": "integer", "minimum": 1 },
              "section_title": { "type": "string" },
              "competence_codes": { "type": "array", "items": { "$ref": "#/$defs/competence_code" } },
              "tasks": { "type": "array", "items": { "$ref": "#/$defs/task_ref" } }
            }
          }
        },
        "indicators": {
          "type": "array",
          "title": "Компетенции, индикаторы, разделы РПД и задания",
          "items": {
            "type": "object",
            "required": ["competence_code", "indicator_code", "tasks"],
            "properties": {
              "competence_code": { "$ref": "#/$defs/competence_code" },
              "indicator_code": { "$ref": "#/$defs/indicator_code" },
              "rpd_section_numbers": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
              "tasks": { "type": "array", "items": { "$ref": "#/$defs/task_ref" } }
            }
          }
        }
      }
    },

    "current_control": {
      "type": "object",
      "title": "Текущий контроль",
      "x-validation-rule": "control_forms_match",
      "properties": {
        "forms": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Формы текущей аттестации"
        },
        "activities": {
          "type": "array",
          "description": "Мероприятия текущего контроля по модулям",
          "items": {
            "type": "object",
            "required": ["title"],
            "properties": {
              "module": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string", "x-ui-widget": "richtext" }
            }
          }
        },
        "variants": {
          "type": "array",
          "items": { "type": "string", "x-ui-widget": "richtext" },
          "description": "Программы и типовые варианты"
        },
        "rating": {
          "type": "string",
          "x-ui-widget": "richtext",
          "description": "Модульно-рейтинговые атрибуты (баллы, недели) — текстом; раздел необязательный"
        }
      }
    },

    "evaluation_means": {
      "type": "array",
      "title": "Оценочные средства",
      "description": "Необязательный раздел. В печати — «Методические материалы, определяющие процедуры оценивания»: по каждому средству описание и критерии оценок",
      "x-validation-rule": "all_indicators_have_means",
      "x-ui-widget": "evaluation_means_table",
      "items": {
        "type": "object",
        "required": ["means_type", "title"],
        "properties": {
          "means_type": {
            "type": "string",
            "enum": [
              "test", "oral_survey", "written_survey", "practical_task",
              "lab_report", "essay", "presentation", "case_study",
              "project", "exam_questions", "credit_questions"
            ],
            "x-source-suggestion": "fos_means_recommender"
          },
          "title": { "type": "string", "description": "Наименование средства, например «Реферат»" },
          "description": { "type": "string", "x-ui-widget": "richtext", "description": "Описание средства, структура и требования к оформлению" },
          "criteria": { "type": "string", "x-ui-widget": "richtext", "description": "Критерии оценок по средству; их отсутствие — предупреждение" },
          "indicator_codes": { "type": "array", "items": { "$ref": "#/$defs/indicator_code" }, "description": "Индикаторы, которые проверяет средство" }
        }
      }
    },

    "task_bank": {
      "type": "array",
      "title": "Банк заданий",
      "description": "Именованные группы вопросов, заданий и тестов; нумерация — внутри группы. Число заданий группы в паспорте вычисляется, а не вводится",
      "items": {
        "type": "object",
        "required": ["group", "kind", "control_form", "tasks"],
        "properties": {
          "group": { "type": "string", "description": "Название группы: на него ссылается паспорт; например «Вопросы к зачёту», «Раздел 1»" },
          "kind": {
            "type": "string",
            "enum": ["questions", "tasks", "tests"],
            "x-enum-titles": { "questions": "Вопросы", "tasks": "Задания", "tests": "Тесты" }
          },
          "section_number": { "type": "integer", "minimum": 1, "description": "Раздел РПД; у группы тестов обязателен: номер задания печатается «раздел.номер»" },
          "semesters": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1, "maximum": 12 },
            "description": "Семестры группы; вид промежуточной аттестации берётся из РПД по ним"
          },
          "control_form": {
            "type": "string",
            "enum": ["current", "intermediate"],
            "x-enum-titles": { "current": "Текущий контроль", "intermediate": "Промежуточная аттестация" }
          },
          "title": { "type": "string", "description": "Подзаголовок группы в печати; без него — название группы" },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["number", "text"],
              "properties": {
                "number": { "type": "integer", "minimum": 1 },
                "text": { "type": "string", "x-ui-widget": "richtext", "description": "Текст задания; у теста варианты ответов — списком в тексте" },
                "expected_answer": { "type": "string", "description": "У теста — верные варианты" },
                "max_score": { "type": "number" },
                "indicator_codes": { "type": "array", "items": { "$ref": "#/$defs/indicator_code" } }
              }
            }
          }
        },
        "if": { "required": ["kind"], "properties": { "kind": { "const": "tests" } } },
        "then": { "required": ["section_number"] }
      }
    },

    "exam_tickets": {
      "type": "array",
      "title": "Экзаменационные билеты",
      "description": "Необязательный раздел: билеты с шапкой и подписью заведующего кафедрой. Число вопросов — по усмотрению кафедры",
      "items": {
        "type": "object",
        "required": ["number", "questions"],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "questions": { "type": "array", "minItems": 2, "items": { "type": "string" } }
        }
      }
    },

    "evaluation_scale": {
      "type": "object",
      "title": "Критерии формирования оценок",
      "description": "Необязательный раздел; пустой печатается типовыми критериями по виду аттестации РПД",
      "x-validation-rule": "scale_matches_control_type",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["five_point", "pass_fail", "hundred_point"],
          "description": "Балльная (5), зачёт/незачёт, 100-балльная"
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["grade", "description"],
            "properties": {
              "grade": { "type": "string" },
              "min_score": { "type": "number", "description": "Нижняя граница баллов; в критериях Положения баллов нет" },
              "max_score": { "type": "number" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },

    "approval_sheet": {
      "$ref": "https://stankin.ru/schemas/rpd/v1.json#/properties/approval_sheet"
    }
  },

  "$defs": {
    "competence_code": {
      "type": "string",
      "pattern": "^(УК|ОПК|ПК)-\\d+$"
    },
    "indicator_code": {
      "type": "string",
      "pattern": "^(УК|ОПК|ПК)-\\d+(\\.\\d+){1,2}$"
    },
    "task_ref": {
      "type": "object",
      "description": "Ссылка паспорта на задания банка: группа и диапазон номеров. Без from и to — вся группа, один номер — from равен to",
      "required": ["group"],
      "properties": {
        "group": { "type": "string" },
        "from": { "type": "integer", "minimum": 1 },
        "to": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
