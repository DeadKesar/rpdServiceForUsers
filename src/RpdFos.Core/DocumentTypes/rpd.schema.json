{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stankin.ru/schemas/rpd/v1.json",
  "title": "Рабочая программа дисциплины (РПД)",
  "type": "object",
  "required": ["title_page", "goals_and_objectives", "competences", "thematic_plan", "literature", "approval_sheet"],
  "properties": {

    "title_page": {
      "type": "object",
      "title": "Титульный лист",
      "required": ["discipline_name", "direction_code", "direction_name", "profile_name", "department_name", "education_level", "study_form", "academic_year"],
      "properties": {
        "discipline_name": {
          "type": "string",
          "x-source": "parser.discipline.name",
          "x-readonly-after": "draft"
        },
        "discipline_code": {
          "type": "string",
          "x-source": "parser.discipline.ind",
          "description": "Индекс по учебному плану, например Б1.О.01"
        },
        "direction_code": {
          "type": "string",
          "pattern": "^\\d{2}\\.\\d{2}\\.\\d{2}$",
          "x-source": "reference.direction.code"
        },
        "direction_name": {
          "type": "string",
          "x-source": "reference.direction.name"
        },
        "profile_name": {
          "type": "string",
          "x-source": "reference.profile.name"
        },
        "education_level": {
          "type": "string",
          "enum": ["Бакалавриат", "Магистратура", "Специалитет", "Аспирантура"],
          "x-source": "reference.direction.level"
        },
        "study_form": {
          "type": "string",
          "x-source": "reference.curriculum_plan.education_form"
        },
        "department_name": {
          "type": "string",
          "x-source": "reference.department.name"
        },
        "academic_year": {
          "type": "string",
          "pattern": "^\\d{4}/\\d{4}$",
          "description": "Учебный год, например 2026/2027"
        }
      }
    },

    "goals_and_objectives": {
      "type": "object",
      "title": "Цели и задачи дисциплины",
      "required": ["goals", "objectives"],
      "properties": {
        "goals": {
          "type": "string",
          "minLength": 50,
          "x-ui-widget": "richtext",
          "description": "Цели изучения дисциплины (заполняется преподавателем)"
        },
        "objectives": {
          "type": "array",
          "items": { "type": "string", "minLength": 10 },
          "minItems": 1,
          "x-ui-widget": "list",
          "description": "Задачи дисциплины"
        }
      }
    },

    "learning_outcomes": {
      "type": "object",
      "title": "Результаты обучения по дисциплине",
      "description": "Знать / уметь / владеть — ручной текст, дополняет выбор индикаторов",
      "properties": {
        "knows": { "type": "string", "x-ui-widget": "richtext" },
        "can": { "type": "string", "x-ui-widget": "richtext" },
        "owns": { "type": "string", "x-ui-widget": "richtext" }
      }
    },

    "place_in_structure": {
      "type": "object",
      "title": "Место дисциплины в структуре образовательной программы",
      "properties": {
        "prerequisites": {
          "type": "string",
          "x-ui-widget": "richtext",
          "description": "Входные требования: результаты обучения, приобретённые ранее"
        },
        "postrequisites": {
          "type": "string",
          "x-ui-widget": "richtext",
          "description": "Дисциплины, использующие результаты обучения по данной дисциплине"
        }
      }
    },

    "competences": {
      "type": "array",
      "title": "Компетенции и индикаторы",
      "x-source": "db.competence_matrix.by_discipline",
      "x-ui-widget": "competence_picker",
      "x-validation-rule": "unique_competence_codes",
      "items": {
        "type": "object",
        "required": ["code", "formulation", "indicators"],
        "properties": {
          "code": { "type": "string", "pattern": "^(УК|ОПК|ПК)-\\d+$" },
          "formulation": { "type": "string" },
          "indicators": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "text"],
              "properties": {
                "code": { "$ref": "#/$defs/indicator_code" },
                "text": { "type": "string" },
                "results": {
                  "type": "object",
                  "description": "Результаты обучения по индикатору",
                  "properties": {
                    "knows": { "type": "string" },
                    "can": { "type": "string" },
                    "owns": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },

    "hours_distribution": {
      "type": "object",
      "title": "Распределение часов по семестрам",
      "x-source": "parser.discipline.details",
      "x-ui-widget": "hours_table",
      "x-validation-rule": "hours_match_curriculum",
      "properties": {
        "semesters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "semester": { "type": "integer", "minimum": 1, "maximum": 12 },
              "contact_hours": { "type": "integer", "minimum": 0 },
              "lectures": { "type": "integer", "minimum": 0 },
              "practice": { "type": "integer", "minimum": 0 },
              "lab_hours": { "type": "integer", "minimum": 0 },
              "self_study": { "type": "integer", "minimum": 0 },
              "control": { "type": "integer", "minimum": 0 },
              "credits": { "type": "integer", "minimum": 0 },
              "control_types": {
                "type": "array",
                "description": "Виды промежуточной аттестации в семестре (их может быть несколько)",
                "items": { "type": "string", "enum": ["exam", "credit", "graded_credit", "course_project", "course_work"] }
              }
            }
          }
        },
        "total_credits": { "type": "integer", "x-source": "parser.discipline.ze_total" }
      }
    },

    "thematic_plan": {
      "type": "array",
      "title": "Тематический план",
      "x-ui-widget": "topic_plan_table",
      "x-validation-rule": ["topic_hours_match_total", "all_indicators_covered"],
      "items": {
        "type": "object",
        "required": ["section_number", "topic_title", "hours"],
        "properties": {
          "section_number": { "type": "integer", "minimum": 1 },
          "topic_title": { "type": "string", "minLength": 5 },
          "topic_description": { "type": "string" },
          "hours": {
            "type": "object",
            "properties": {
              "lectures": { "type": "integer", "minimum": 0 },
              "practice": { "type": "integer", "minimum": 0 },
              "lab_hours": { "type": "integer", "minimum": 0 },
              "self_study": { "type": "integer", "minimum": 0 }
            }
          },
          "competence_indicators": {
            "type": "array",
            "items": { "$ref": "#/$defs/indicator_code" },
            "description": "Какие индикаторы формируются в этом разделе"
          },
          "current_control_forms": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Формы текущего контроля по разделу — мероприятия ФОС"
          }
        }
      }
    },

    "practical_classes": {
      "type": "array",
      "title": "Практические занятия (семинары)",
      "x-visible-if": { "source": "parser.discipline.details", "any": "practice" },
      "x-stub-text": "Практические занятия учебным планом не предусмотрены.",
      "items": { "$ref": "#/$defs/class_item" }
    },

    "lab_works": {
      "type": "array",
      "title": "Лабораторные работы",
      "x-visible-if": { "source": "parser.discipline.details", "any": "lab_hours" },
      "x-stub-text": "Лабораторные работы учебным планом не предусмотрены.",
      "items": { "$ref": "#/$defs/class_item" }
    },

    "course_work": {
      "type": "object",
      "title": "Курсовой проект (курсовая работа)",
      "x-visible-if": { "source": "parser.discipline.attestation", "includes": ["course_project", "course_work"] },
      "x-stub-text": "В учебном плане курсовое проектирование для данной дисциплины не предусмотрено.",
      "properties": {
        "kind": { "type": "string", "enum": ["course_project", "course_work"] },
        "topics": { "type": "array", "items": { "type": "string" }, "description": "Примерные темы" },
        "requirements": { "type": "string", "x-ui-widget": "richtext", "description": "Требования к содержанию и оформлению" }
      }
    },

    "education_technologies": {
      "type": "array",
      "title": "Образовательные технологии",
      "items": { "type": "string" },
      "description": "Применяемые методы и технологии обучения"
    },

    "evaluation_means": {
      "type": "object",
      "title": "Оценочные средства (краткий перечень, подробно — в ФОС)",
      "properties": {
        "current_control": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Средства текущего контроля"
        },
        "intermediate_attestation": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Средства промежуточной аттестации"
        }
      }
    },

    "literature": {
      "type": "object",
      "title": "Учебно-методическое обеспечение дисциплины",
      "required": ["main", "additional"],
      "properties": {
        "main": {
          "type": "array",
          "minItems": 1,
          "x-validation-rule": "literature_main_count",
          "items": { "$ref": "#/$defs/literature_item" },
          "description": "Основная литература"
        },
        "additional": {
          "type": "array",
          "items": { "$ref": "#/$defs/literature_item" },
          "description": "Дополнительная литература"
        },
        "periodicals": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Периодические издания"
        },
        "internet_resources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "url"],
            "properties": {
              "title": { "type": "string" },
              "url": { "type": "string", "format": "uri" },
              "accessed_on": { "type": "string", "format": "date", "description": "Дата обращения" }
            }
          }
        },
        "guidelines": {
          "type": "object",
          "title": "Методические указания",
          "properties": {
            "lab_works": {
              "type": "string",
              "x-ui-widget": "richtext",
              "x-visible-if": { "source": "parser.discipline.details", "any": "lab_hours" }
            },
            "practical_classes": {
              "type": "string",
              "x-ui-widget": "richtext",
              "x-visible-if": { "source": "parser.discipline.details", "any": "practice" }
            },
            "course_work": {
              "type": "string",
              "x-ui-widget": "richtext",
              "x-visible-if": { "source": "parser.discipline.attestation", "includes": ["course_project", "course_work"] }
            }
          }
        },
        "software": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Программное обеспечение, базы данных, информационно-справочные системы"
        }
      }
    },

    "material_support": {
      "type": "string",
      "title": "Материально-техническое обеспечение",
      "x-ui-widget": "richtext"
    },

    "approval_sheet": {
      "type": "object",
      "title": "Лист согласования",
      "description": "Только то, что вводит автор. Подписантов определяют правила листа согласования шаблона (signatures_config), отметки согласования хранятся в document_signatures",
      "required": ["developers"],
      "properties": {
        "developers": {
          "type": "array",
          "title": "Составители",
          "description": "По порядку в документе; первый — автор документа",
          "x-source": "db.user.current",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["user_id", "name_for_document"],
            "properties": {
              "user_id": { "type": "string", "format": "uuid", "description": "Запись справочника сотрудников (users.id)" },
              "name_for_document": { "type": "string", "description": "«И. О. Фамилия» на момент ввода" },
              "position": { "type": "string", "description": "Должность на момент ввода" }
            }
          }
        },
        "department_protocol": {
          "type": "object",
          "title": "Протокол заседания кафедры",
          "x-required-for-status": "approval",
          "required": ["number", "date"],
          "properties": {
            "number": { "type": "string", "description": "Номер протокола" },
            "date": { "type": "string", "format": "date", "description": "Дата заседания кафедры" }
          }
        }
      }
    }
  },

  "$defs": {
    "indicator_code": {
      "type": "string",
      "pattern": "^(УК|ОПК|ПК)-\\d+(\\.\\d+){1,2}$",
      "description": "Код индикатора: УК-1.1, ОПК-2.3, ПК-1.1.1 (у ПК — до трёх уровней)"
    },
    "class_item": {
      "type": "object",
      "required": ["number", "title", "hours"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "hours": { "type": "integer", "minimum": 0 },
        "section_number": { "type": "integer", "minimum": 1, "description": "Раздел тематического плана" }
      }
    },
    "literature_item": {
      "type": "object",
      "required": ["citation"],
      "properties": {
        "citation": {
          "type": "string",
          "minLength": 20,
          "description": "Библиографическая запись по ГОСТ Р 7.0.100-2018"
        },
        "year": { "type": "integer", "minimum": 1900 },
        "isbn": { "type": "string" }
      }
    }
  }
}
