{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stankin.ru/schemas/rpd/v1.json",
  "title": "Рабочая программа дисциплины (РПД)",
  "type": "object",
  "required": ["title_page", "goals_and_objectives", "competences", "thematic_plan", "literature", "approval_sheet"],
  "properties": {

    "title_page": {
      "type": "object",
      "title": "Титульный лист",
      "required": ["discipline_name", "direction_code", "direction_name", "profile_name", "department_name", "education_level", "study_form", "academic_year"],
      "properties": {
        "discipline_name": {
          "type": "string",
          "title": "Наименование дисциплины",
          "readOnly": true,
          "x-source": "parser.discipline.name",
          "x-readonly-after": "draft"
        },
        "discipline_code": {
          "type": "string",
          "title": "Индекс дисциплины",
          "readOnly": true,
          "x-source": "parser.discipline.ind",
          "description": "Индекс по учебному плану, например Б1.О.01"
        },
        "direction_code": {
          "type": "string",
          "title": "Код направления подготовки",
          "readOnly": true,
          "pattern": "^\\d{2}\\.\\d{2}\\.\\d{2}$",
          "x-source": "reference.direction.code"
        },
        "direction_name": {
          "type": "string",
          "title": "Направление подготовки",
          "readOnly": true,
          "x-source": "reference.direction.name"
        },
        "profile_name": {
          "type": "string",
          "title": "Направленность (профиль)",
          "readOnly": true,
          "x-source": "reference.profile.name"
        },
        "education_level": {
          "type": "string",
          "title": "Уровень высшего образования",
          "readOnly": true,
          "enum": ["Бакалавриат", "Магистратура", "Специалитет", "Аспирантура"],
          "x-source": "reference.direction.level"
        },
        "study_form": {
          "type": "string",
          "title": "Форма обучения",
          "readOnly": true,
          "x-source": "reference.curriculum_plan.education_form"
        },
        "department_name": {
          "type": "string",
          "title": "Кафедра",
          "readOnly": true,
          "x-source": "reference.department.name"
        },
        "academic_year": {
          "type": "string",
          "title": "Учебный год",
          "pattern": "^\\d{4}/\\d{4}$",
          "x-source": "reference.curriculum_plan.academic_year",
          "description": "Учебный год, например 2026/2027"
        }
      }
    },

    "goals_and_objectives": {
      "type": "object",
      "title": "Цели и задачи дисциплины",
      "required": ["goals", "objectives"],
      "properties": {
        "goals": {
          "type": "string",
          "title": "Цели освоения дисциплины",
          "minLength": 50,
          "x-ui-widget": "richtext",
          "description": "Цели изучения дисциплины (заполняется преподавателем)"
        },
        "objectives": {
          "type": "array",
          "title": "Задачи дисциплины",
          "items": { "type": "string", "minLength": 10 },
          "minItems": 1,
          "x-ui-widget": "list",
          "description": "Задачи дисциплины"
        }
      }
    },

    "learning_outcomes": {
      "type": "object",
      "title": "Результаты обучения по дисциплине",
      "description": "Знать / уметь / владеть — ручной текст, дополняет выбор индикаторов",
      "properties": {
        "knows": { "type": "string", "title": "Знать", "x-ui-widget": "richtext" },
        "can": { "type": "string", "title": "Уметь", "x-ui-widget": "richtext" },
        "owns": { "type": "string", "title": "Владеть", "x-ui-widget": "richtext" }
      }
    },

    "place_in_structure": {
      "type": "object",
      "title": "Место дисциплины в структуре образовательной программы",
      "properties": {
        "index": {
          "type": "string",
          "title": "Индекс",
          "readOnly": true,
          "x-source": "parser.discipline.ind",
          "description": "Индекс по учебному плану"
        },
        "block": {
          "type": "string",
          "title": "Блок",
          "readOnly": true,
          "x-source": "parser.discipline.block",
          "description": "Блок учебного плана"
        },
        "part": {
          "type": "string",
          "title": "Часть",
          "readOnly": true,
          "x-source": "parser.discipline.part_type",
          "description": "Часть блока"
        },
        "prerequisites": {
          "type": "array",
          "title": "Дисциплины и практики, результаты которых нужны для освоения дисциплины",
          "description": "Из учебного плана: изучаются раньше первого семестра дисциплины",
          "x-ui-widget": "discipline_picker",
          "x-plan-disciplines": "earlier",
          "items": { "$ref": "#/$defs/discipline_ref" }
        },
        "prior_outcomes": {
          "type": "object",
          "title": "Предварительные результаты обучения",
          "description": "Что должно быть сформировано у обучающегося до начала изучения дисциплины",
          "properties": {
            "knows": { "type": "string", "title": "Знать", "x-ui-widget": "richtext" },
            "can": { "type": "string", "title": "Уметь", "x-ui-widget": "richtext" },
            "owns": { "type": "string", "title": "Владеть", "x-ui-widget": "richtext" }
          }
        },
        "postrequisites": {
          "type": "array",
          "title": "Дисциплины и практики, где применяются результаты обучения",
          "description": "Из учебного плана: изучаются позже последнего семестра дисциплины",
          "x-ui-widget": "discipline_picker",
          "x-plan-disciplines": "later",
          "items": { "$ref": "#/$defs/discipline_ref" }
        }
      }
    },

    "competences": {
      "type": "array",
      "title": "Компетенции и индикаторы",
      "x-source": "db.competence_matrix.by_discipline",
      "x-ui-widget": "competence_picker",
      "x-validation-rule": ["unique_competence_codes", "competences_match_matrix"],
      "items": {
        "type": "object",
        "required": ["code", "formulation", "indicators"],
        "properties": {
          "code": { "type": "string", "title": "Код компетенции", "pattern": "^(УК|ОПК|ПК)-\\d+$" },
          "formulation": { "type": "string", "title": "Формулировка" },
          "indicators": {
            "type": "array",
            "title": "Индикаторы",
            "items": {
              "type": "object",
              "required": ["code", "text"],
              "properties": {
                "code": { "$ref": "#/$defs/indicator_code" },
                "text": { "type": "string", "title": "Формулировка индикатора" },
                "results": {
                  "type": "object",
                  "title": "Результаты обучения",
                  "description": "Результаты обучения по индикатору",
                  "properties": {
                    "knows": { "type": "string", "title": "Знать" },
                    "can": { "type": "string", "title": "Уметь" },
                    "owns": { "type": "string", "title": "Владеть" }
                  }
                }
              }
            }
          }
        }
      }
    },

    "hours_distribution": {
      "type": "object",
      "title": "Распределение часов по семестрам",
      "description": "Трудоёмкость, часы по видам занятий и виды аттестации — из учебного плана; виды самостоятельной работы — автора",
      "x-ui-widget": "hours_table",
      "x-validation-rule": ["hours_match_curriculum", "self_study_kinds_match_plan"],
      "properties": {
        "semesters": {
          "type": "array",
          "title": "Семестры",
          "readOnly": true,
          "x-source": "parser.discipline.details",
          "items": {
            "type": "object",
            "properties": {
              "semester": { "type": "integer", "title": "Семестр", "minimum": 1, "maximum": 12 },
              "contact_hours": { "type": "integer", "title": "Контактная работа", "minimum": 0 },
              "lectures": { "type": "integer", "title": "Лекции", "minimum": 0 },
              "practice": { "type": "integer", "title": "Практические занятия", "minimum": 0 },
              "lab_hours": { "type": "integer", "title": "Лабораторные работы", "minimum": 0 },
              "self_study": { "type": "integer", "title": "Самостоятельная работа", "minimum": 0 },
              "control": { "type": "integer", "title": "Контроль", "minimum": 0 },
              "credits": { "type": "integer", "title": "Зачётных единиц", "minimum": 0 },
              "control_types": {
                "type": "array",
                "title": "Промежуточная аттестация",
                "description": "Виды промежуточной аттестации в семестре (их может быть несколько)",
                "items": {
                  "type": "string",
                  "enum": ["exam", "credit", "graded_credit", "course_project", "course_work"],
                  "x-enum-titles": {
                    "exam": "Экзамен", "credit": "Зачёт", "graded_credit": "Зачёт с оценкой",
                    "course_project": "Курсовой проект", "course_work": "Курсовая работа"
                  }
                }
              }
            }
          }
        },
        "total_credits": { "type": "integer", "title": "Зачётных единиц", "readOnly": true, "x-source": "parser.discipline.ze_total", "description": "Зачётных единиц" },
        "total_hours": { "type": "integer", "title": "Часов по плану", "readOnly": true, "x-source": "parser.discipline.hours_total", "description": "Академических часов по плану" },
        "self_study_kinds": {
          "type": "array",
          "title": "Виды самостоятельной работы",
          "description": "В каждом семестре сумма часов видов равна самостоятельной работе в распределении часов",
          "x-ui-widget": "self_study_table",
          "x-template-default": true,
          "items": { "$ref": "#/$defs/self_study_kind" }
        }
      }
    },

    "thematic_plan": {
      "type": "array",
      "title": "Тематический план",
      "x-ui-widget": "topic_plan_table",
      "x-validation-rule": ["topic_hours_match_total", "all_indicators_covered"],
      "items": {
        "type": "object",
        "required": ["section_number", "semester", "topic_title", "hours"],
        "properties": {
          "section_number": { "type": "integer", "title": "Раздел", "minimum": 1 },
          "semester": { "type": "integer", "title": "Семестр", "minimum": 1, "maximum": 12, "description": "Семестр из распределения часов документа" },
          "topic_title": { "type": "string", "title": "Тема", "minLength": 5 },
          "topic_description": { "type": "string", "title": "Содержание" },
          "hours": {
            "type": "object",
            "title": "Часы",
            "properties": {
              "lectures": { "type": "integer", "title": "Лекции", "minimum": 0 },
              "practice": { "type": "integer", "title": "Практика", "minimum": 0 },
              "lab_hours": { "type": "integer", "title": "Лабораторные", "minimum": 0 },
              "self_study": { "type": "integer", "title": "Самостоятельная работа", "minimum": 0 }
            }
          },
          "competence_indicators": {
            "type": "array",
            "title": "Индикаторы",
            "items": { "$ref": "#/$defs/indicator_code" },
            "description": "Какие индикаторы формируются в этом разделе"
          },
          "current_control_forms": {
            "type": "array",
            "title": "Формы текущего контроля",
            "items": { "type": "string" },
            "description": "Формы текущего контроля по разделу — мероприятия ФОС"
          }
        }
      }
    },

    "practical_classes": {
      "type": "array",
      "title": "Практические занятия (семинары)",
      "x-ui-widget": "class_table",
      "x-visible-if": { "source": "parser.discipline.details", "any": "practice" },
      "x-stub-text": "Практические занятия учебным планом не предусмотрены.",
      "items": { "$ref": "#/$defs/class_item" }
    },

    "lab_works": {
      "type": "array",
      "title": "Лабораторные работы",
      "x-ui-widget": "class_table",
      "x-visible-if": { "source": "parser.discipline.details", "any": "lab_hours" },
      "x-stub-text": "Лабораторные работы учебным планом не предусмотрены.",
      "items": { "$ref": "#/$defs/class_item" }
    },

    "course_work": {
      "type": "object",
      "title": "Курсовой проект (курсовая работа)",
      "x-visible-if": { "source": "parser.discipline.attestation", "includes": ["course_project", "course_work"] },
      "x-stub-text": "В учебном плане курсовое проектирование для данной дисциплины не предусмотрено.",
      "required": ["kind", "topics"],
      "properties": {
        "kind": {
          "type": "string",
          "title": "Вид",
          "readOnly": true,
          "x-source": "parser.discipline.course_work_kind",
          "enum": ["course_project", "course_work"],
          "x-enum-titles": { "course_project": "Курсовой проект", "course_work": "Курсовая работа" },
          "x-print-titles": { "course_project": "предусмотрен курсовой проект", "course_work": "предусмотрена курсовая работа" }
        },
        "topics": { "type": "array", "title": "Примерные темы", "minItems": 1, "items": { "type": "string" }, "description": "Примерные темы" },
        "requirements": { "type": "string", "title": "Требования", "x-ui-widget": "richtext", "description": "Требования к содержанию и оформлению" }
      }
    },

    "education_technologies": {
      "type": "array",
      "title": "Образовательные технологии",
      "items": { "type": "string" },
      "description": "Применяемые методы и технологии обучения"
    },

    "evaluation_means": {
      "type": "object",
      "title": "Оценочные средства (краткий перечень, подробно — в ФОС)",
      "properties": {
        "current_control": {
          "type": "array",
          "title": "Текущий контроль",
          "items": { "type": "string" },
          "description": "Средства текущего контроля"
        },
        "intermediate_attestation": {
          "type": "array",
          "title": "Промежуточная аттестация",
          "items": { "type": "string" },
          "description": "Средства промежуточной аттестации"
        }
      }
    },

    "literature": {
      "type": "object",
      "title": "Учебно-методическое обеспечение дисциплины",
      "required": ["main", "additional"],
      "properties": {
        "main": {
          "type": "array",
          "title": "Основная литература",
          "minItems": 1,
          "x-ui-widget": "literature_list",
          "x-validation-rule": ["literature_main_count", "literature_main_recent", "literature_year_not_future"],
          "items": { "$ref": "#/$defs/literature_item" },
          "description": "Основная литература"
        },
        "additional": {
          "type": "array",
          "title": "Дополнительная литература",
          "x-ui-widget": "literature_list",
          "x-validation-rule": "literature_year_not_future",
          "items": { "$ref": "#/$defs/literature_item" },
          "description": "Дополнительная литература"
        },
        "periodicals": {
          "type": "array",
          "title": "Периодические издания",
          "items": { "type": "string" },
          "description": "Периодические издания"
        },
        "internet_resources": {
          "type": "array",
          "title": "Интернет-ресурсы",
          "x-ui-widget": "literature_list",
          "x-template-default": true,
          "items": {
            "type": "object",
            "required": ["title", "url"],
            "properties": {
              "title": { "type": "string", "title": "Название", "x-ui-widget": "textarea" },
              "url": { "type": "string", "title": "Адрес", "format": "uri" },
              "accessed_on": { "type": "string", "title": "Дата обращения", "format": "date", "description": "Дата обращения" }
            }
          }
        },
        "guidelines": {
          "type": "object",
          "title": "Методические указания",
          "x-template-default": true,
          "description": "Ссылки на методические указания в электронной образовательной среде университета",
          "properties": {
            "lab_works": {
              "type": "string",
              "title": "Ссылка на указания к лабораторным занятиям",
              "format": "uri",
              "x-visible-if": { "source": "parser.discipline.details", "any": "lab_hours" },
              "x-stub-text": "Лабораторные работы учебным планом не предусмотрены."
            },
            "practical_classes": {
              "type": "string",
              "title": "Ссылка на указания к практическим занятиям",
              "format": "uri",
              "x-visible-if": { "source": "parser.discipline.details", "any": "practice" },
              "x-stub-text": "Практические занятия учебным планом не предусмотрены."
            },
            "independent_work": {
              "type": "string",
              "title": "Ссылка на указания к курсовому проектированию и самостоятельной работе",
              "format": "uri"
            }
          }
        },
        "software": {
          "type": "array",
          "title": "Программное обеспечение",
          "x-template-default": true,
          "items": { "type": "string" },
          "description": "Программное обеспечение, базы данных, информационно-справочные системы"
        }
      }
    },

    "material_support": {
      "type": "array",
      "title": "Материально-техническое обеспечение",
      "description": "Помещения и оборудование — пунктами списка",
      "x-ui-widget": "list",
      "x-template-default": true,
      "items": { "type": "string", "minLength": 3 }
    },

    "approval_sheet": {
      "type": "object",
      "title": "Лист согласования",
      "description": "Только то, что вводит автор. Подписантов определяют правила листа согласования шаблона (signatures_config), отметки согласования хранятся в document_signatures",
      "required": ["developers"],
      "properties": {
        "developers": {
          "type": "array",
          "title": "Составители",
          "description": "По порядку в документе; первый — автор документа",
          "x-source": "db.user.current",
          "x-ui-widget": "developer_picker",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["user_id", "name_for_document", "position"],
            "properties": {
              "user_id": { "type": "string", "title": "Запись справочника", "format": "uuid", "readOnly": true, "description": "Запись справочника сотрудников (users.id)" },
              "name_for_document": { "type": "string", "title": "И. О. Фамилия", "description": "«И. О. Фамилия» на момент ввода" },
              "position": { "type": "string", "title": "Должность", "minLength": 3, "description": "Из справочника сотрудников на момент ввода; нет в справочнике — вводит автор" }
            }
          }
        },
        "department_protocol": {
          "type": "object",
          "title": "Протокол заседания кафедры",
          "x-required-for-status": "approval",
          "required": ["number", "date"],
          "properties": {
            "number": { "type": "string", "title": "Номер протокола", "description": "Номер протокола" },
            "date": { "type": "string", "title": "Дата заседания", "format": "date", "description": "Дата заседания кафедры" }
          }
        }
      }
    }
  },

  "$defs": {
    "indicator_code": {
      "type": "string",
      "title": "Код индикатора",
      "pattern": "^(УК|ОПК|ПК)-\\d+(\\.\\d+){1,2}$",
      "description": "Код индикатора: УК-1.1, ОПК-2.3, ПК-1.1.1 (у ПК — до трёх уровней)"
    },
    "class_item": {
      "type": "object",
      "required": ["number", "title", "hours"],
      "properties": {
        "number": { "type": "integer", "title": "№", "minimum": 1 },
        "title": { "type": "string", "title": "Тема занятия", "x-ui-widget": "textarea" },
        "hours": { "type": "integer", "title": "Часов", "minimum": 0 },
        "section_number": { "type": "integer", "title": "Раздел", "minimum": 1, "description": "Раздел тематического плана" },
        "control_form": { "type": "string", "title": "Форма контроля", "description": "Отчёт, собеседование, опрос, тест и т. п." }
      }
    },
    "discipline_ref": {
      "type": "object",
      "description": "Ссылка на дисциплину или практику учебного плана; индекс и название — на момент выбора",
      "required": ["discipline_id", "code", "name"],
      "properties": {
        "discipline_id": { "type": "string", "format": "uuid", "title": "Дисциплина плана" },
        "code": { "type": "string", "title": "Индекс" },
        "name": { "type": "string", "title": "Название" }
      }
    },
    "self_study_kind": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "title": "Вид", "minLength": 3 },
        "form_code": {
          "type": "string",
          "title": "Обозначение",
          "maxLength": 10,
          "description": "Обозначение формы для графы «Формы текущего контроля» разделов, например «Р»"
