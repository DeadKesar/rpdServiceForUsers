<Project Sdk="Microsoft.NET.Sdk">
  <!-- Прикладное ядро: доменная модель, доступ к данным, сквозные механизмы.
       Общее для API и (с этапа 2) фонового обработчика.
       Версии пакетов ориентировочные: актуализировать по runbook, шаг 4. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.7.2" />
    <!-- Закладки DOCX-шаблонов оформления (DocumentTypes/DocxBookmarks), позже — генерация DOCX. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- Проверка содержимого документа по JSON Schema 2020-12 (Documents/DocumentValidator): Apache 2.0,
         сопровождается; выбор и сравнение — docs/journal.md, этап 4, B1.
         Версия закреплена точно ([5.7.9]): обновлять только осознанно — с прогоном тестов валидатора, потому что
         сообщения об ошибках строятся по местам в схеме, которые отдаёт библиотека. -->
    <PackageReference Include="Corvus.Text.Json.Validator" Version="[5.7.9]" />
    <!-- Санитайзер форматированного текста (Documents/RichTextSanitizer, NFR-SEC-10): MIT, AngleSharp — MIT. -->
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
  </ItemGroup>
  <ItemGroup>
    <!-- Структуры типов документов (схемы, сопоставление закладок, листы согласования) — файлами в ядре. -->
    <EmbeddedResource Include="DocumentTypes\*.json" LogicalName="DocumentTypes.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Разбор исходных файлов; результат разбора загружает в справочники конвейер импорта (Import/). -->
    <ProjectReference Include="..\DisciplineDataExtractor\DisciplineDataExtractor.csproj" />
  </ItemGroup>
</Project>
