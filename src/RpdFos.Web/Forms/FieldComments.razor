@using System.Text.Json.Nodes
@using RpdFos.Web.Models

@* Замечания у поля. Методист на проверке и согласующий до своей отметки добавляют замечание и снимают своё (этап 7, A2),
   методист на проверке снимает и замечания согласующих, автор на доработке отмечает разрешённым любое.
   У виджета замечание относится ко всему списку или к выбранной записи (этап 8, A15). *@
@foreach (var c in Context.CommentsAt(Path, Subtree))
{
    <div class="alert @(c.IsResolved ? "alert-light text-muted" : "alert-warning") py-1 px-2 small mb-1 d-flex justify-content-between align-items-start gap-2">
        <span>
            <span class="fw-semibold me-1">Замечание@(c.FromApproval ? " согласующего" : "")@(c.FieldPath != Path ? $" ({Context.FieldTitle(c.FieldPath)})" : ""):</span>
            @c.Text
            <span class="text-muted">— @c.AuthorName, @c.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
            @if (c.IsResolved)
            {
                <span class="badge text-bg-success ms-1">разрешено@(c.ResolvedByName is { } by ? $" — {by}" : "")</span>
            }
        </span>
        @if (Context.CanResolveComment(c) && Context.ResolveComment is { } resolve)
        {
            <button type="button" class="btn btn-sm btn-outline-success text-nowrap flex-shrink-0" @onclick="() => resolve(c)">Разрешено</button>
        }
    </div>
}
@if (Context.CanComment && Context.AddComment is not null)
{
    @if (open)
    {
        <div class="mb-2">
            @if (Targets is { Count: > 0 } targets)
            {
                <select class="form-select form-select-sm mb-1" aria-label="К чему замечание"
                        @onchange="e => target = int.TryParse(e.Value as string, out var i) ? Targets[i].Node : null">
                    <option value="" selected="@(Chosen is null)">к полю целиком</option>
                    @for (var i = 0; i < targets.Count; i++)
                    {
                        <option value="@i" selected="@(targets[i].Node == target)">@targets[i].Title</option>
                    }
                </select>
            }
            <textarea class="form-control form-control-sm" rows="2" placeholder="Что нужно исправить" @bind="text" @bind:event="oninput"></textarea>
            <div class="mt-1 d-flex gap-2">
                <button type="button" class="btn btn-sm btn-warning" disabled="@string.IsNullOrWhiteSpace(text)" @onclick="AddAsync">
                    Добавить замечание
                </button>
                <button type="button" class="btn btn-sm btn-link" @onclick="() => (open, target) = (false, null)">Отмена</button>
            </div>
        </div>
    }
    else
    {
        <button type="button" class="btn btn-sm btn-link p-0 mb-2" @onclick="() => open = true">+ замечание</button>
    }
}

@code {
    [Parameter, EditorRequired] public SchemaContext Context { get; set; } = default!;
    [Parameter, EditorRequired] public string Path { get; set; } = "";

    /// <summary>Виджет рисует вложенные поля сам — замечания к ним показываются у него.</summary>
    [Parameter] public bool Subtree { get; set; }

    private bool open;
    private string text = "";
    private JsonNode? target;

    private IReadOnlyList<CommentTargets.Target> Targets => Subtree ? CommentTargets.Records(Context.Payload, Path) : [];

    // Место берётся по самой записи в момент отправки: список могли переставить, пока форма открыта.
    private CommentTargets.Target? Chosen => target is null ? null : Targets.FirstOrDefault(t => t.Node == target);

    private async Task AddAsync()
    {
        if (await Context.AddComment!(Chosen?.Path ?? Path, text)) (open, text, target) = (false, "", null);
    }
}
