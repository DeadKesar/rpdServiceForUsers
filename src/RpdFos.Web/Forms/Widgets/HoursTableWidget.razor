@using System.Text.Json
@using System.Text.Json.Nodes
@inherits FieldBase

@* Трудоёмкость из учебного плана: часы по семестрам и видам занятий, виды аттестации — только для чтения.
   Методист и администратор исправляют часы (этап 5.1) и виды аттестации (этап 5.2): исправленная ячейка помечена
   значением по плану.
   Под ней — виды самостоятельной работы автора: своё поле схемы со своим виджетом из реестра. *@
<div class="mb-3">
    <p class="text-muted small mb-2">
        <span class="badge text-bg-light border">из учебного плана</span>
        Трудоёмкость: @Number(Value?["total_credits"]) з. е., @Number(Value?["total_hours"]) ч.
        @foreach (var key in new[] { "total_credits", "total_hours" })
        {
            if (Context.PlanMark($"{Path}/{key}", Value?[key]) is { } mark)
            {
                <span class="badge text-bg-warning ms-1" title="@Context.CorrectionInfo($"{Path}/{key}")">@Property(key).Title: @mark</span>
            }
        }
    </p>
    @if (Editable && Value is JsonObject totals)
    {
        <div class="row g-2 mb-2" style="max-width: 420px">
            @foreach (var key in new[] { "total_credits", "total_hours" })
            {
                <div class="col-6">
                    <label class="form-label small">@Property(key).Title</label>
                    <ScalarInput Context="Context" Schema="Property(key).Schema" Parent="totals" Key="@key" Path="@($"{Path}/{key}")" Compact="true" />
                </div>
            }
        </div>
    }
    <div class="table-responsive">
    <table class="table table-sm table-bordered text-center">
        <thead class="table-light">
            <tr>
                <th>Семестр</th><th>Контактная работа</th><th>Лекции</th><th>Практические</th><th>Лабораторные</th>
                <th>Самостоятельная работа</th><th>Контроль</th><th>З. е.</th><th>Аттестация</th>
            </tr>
        </thead>
        <tbody>
            @{ var index = 0; }
            @foreach (var s in Semesters)
            {
                var row = index++;
                <tr>
                    <td>@Number(s["semester"])</td>
                    @foreach (var key in HourKeys)
                    {
                        var path = $"{Path}/semesters/{row}/{key}";
                        var mark = Context.PlanMark(path, s[key]);
                        <td class="@(mark is null ? "" : "table-warning")" title="@(mark is null ? null : Context.CorrectionInfo(path) is { } who ? $"{mark} ({who})" : mark)">
                            @if (Editable)
                            {
                                <ScalarInput Context="Context" Schema="SemesterProperty(key)" Parent="s" Key="@key" Path="@path" Compact="true" />
                            }
                            else
                            {
                                @Number(s[key])
                            }
                        </td>
                    }
                    @{
                        var typesPath = $"{Path}/semesters/{row}/control_types";
                        var typesMark = Context.PlanMark(typesPath, s["control_types"], ControlTypes);
                    }
                    <td class="text-start @(typesMark is null ? "" : "table-warning")"
                        title="@(typesMark is null ? null : Context.CorrectionInfo(typesPath) is { } typesWho ? $"{typesMark} ({typesWho})" : typesMark)">
                        @if (Editable)
                        {
                            @* Виды аттестации исправляются как часы (этап 5.2): от них зависят курсовой проект и строки аттестации. *@
                            @foreach (var code in ControlTypeCodes)
                            {
                                var id = $"ct-{row}-{code}";
                                <div class="form-check form-check-inline me-2 text-nowrap">
                                    <input class="form-check-input" type="checkbox" id="@id" checked="@Has(s, code)"
                                           @onchange="e => Toggle(s, typesPath, code, e.Value is true)" />
                                    <label class="form-check-label small" for="@id">@SchemaContext.EnumTitle(ControlTypes, code)</label>
                                </div>
                            }
                            @if (typesMark is not null)
                            {
                                <div class="small text-muted">@typesMark</div>
                            }
                        }
                        else
                        {
                            @string.Join(", ", (s["control_types"] as JsonArray ?? []).Select(t => SchemaContext.EnumTitle(ControlTypes, Text(t) ?? "")))
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (Editable)
    {
        <div class="form-text">
            Часы и виды аттестации из учебного плана исправляются, когда дешевле поправить документ, чем план:
            исправленное помечается, в истории — кто, когда, было и стало.
        </div>
    }
    @if (Value is JsonObject hours && SelfStudyKinds.ValueKind == JsonValueKind.Object)
    {
        <SchemaField Context="Context" Schema="SelfStudyKinds" Parent="hours" Key="self_study_kinds"
                     Path="@($"{Path}/self_study_kinds")" Nested="true" />
    }
</div>

@code {
    private static readonly string[] HourKeys = ["contact_hours", "lectures", "practice", "lab_hours", "self_study", "control", "credits"];

    private IEnumerable<JsonObject> Semesters => (Value?["semesters"] as JsonArray ?? []).OfType<JsonObject>();

    // Часы правит только исправляющий — методист или администратор (поле из плана).
    private bool Editable => !Context.IsReadOnly($"{Path}/semesters", SemestersSchema);

    private JsonElement SemestersSchema =>
        Schema.TryGetProperty("properties", out var p) && p.TryGetProperty("semesters", out var s) ? s : default;

    private JsonElement SemesterProperty(string key) =>
        SemestersSchema.ValueKind == JsonValueKind.Object && SemestersSchema.TryGetProperty("items", out var i) &&
        i.TryGetProperty("properties", out var ip) && ip.TryGetProperty(key, out var k) ? k : default;

    private (string Title, JsonElement Schema) Property(string key) =>
        Schema.TryGetProperty("properties", out var p) && p.TryGetProperty(key, out var k)
            ? (SchemaContext.Text(k, "title") ?? key, k)
            : (key, default);

    // Шаблоны, опубликованные до этапа 5.1, видов самостоятельной работы в схеме не имеют.
    private JsonElement SelfStudyKinds =>
        Schema.TryGetProperty("properties", out var p) && p.TryGetProperty("self_study_kinds", out var k) ? Context.Resolve(k) : default;

    // Коды видов аттестации — в порядке перечисления схемы: в том же порядке их пишет предзаполнение из плана.
    private IEnumerable<string> ControlTypeCodes =>
        ControlTypes.ValueKind == JsonValueKind.Object && ControlTypes.TryGetProperty("enum", out var e)
            ? e.EnumerateArray().Select(v => v.GetString() ?? "").Where(v => v.Length > 0)
            : [];

    private bool Has(JsonObject semester, string code) =>
        (semester["control_types"] as JsonArray ?? []).Any(t => Text(t) == code);

    private void Toggle(JsonObject semester, string path, string code, bool on)
    {
        var current = (semester["control_types"] as JsonArray ?? []).Select(t => Text(t)).OfType<string>().ToHashSet();
        if (on) current.Add(code);
        else current.Remove(code);
        semester["control_types"] = new JsonArray(ControlTypeCodes.Where(current.Contains).Select(c => (JsonNode)JsonValue.Create(c)!).ToArray());
        Context.Changed(path);
    }

    // Схема видов аттестации — для русских названий кодов (x-enum-titles).
    private JsonElement ControlTypes =>
        SemesterProperty("control_types") is { ValueKind: JsonValueKind.Object } c && c.TryGetProperty("items", out var items)
            ? items
            : default;
}
