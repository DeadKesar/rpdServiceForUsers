@using System.Text.Json
@using System.Text.Json.Nodes
@inherits FieldBase

@* Трудоёмкость из учебного плана: часы по семестрам и видам занятий, виды аттестации — только для чтения. *@
<div class="mb-3">
    <p class="text-muted small mb-2">
        <span class="badge text-bg-light border">из учебного плана</span>
        Трудоёмкость: @Int(Value?["total_credits"]) з. е., @Int(Value?["total_hours"]) ч.
    </p>
    <table class="table table-sm table-bordered text-center">
        <thead class="table-light">
            <tr>
                <th>Семестр</th><th>Контактная работа</th><th>Лекции</th><th>Практические</th><th>Лабораторные</th>
                <th>Самостоятельная работа</th><th>Контроль</th><th>З. е.</th><th>Аттестация</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Semesters)
            {
                <tr>
                    <td>@Int(s["semester"])</td><td>@Int(s["contact_hours"])</td><td>@Int(s["lectures"])</td><td>@Int(s["practice"])</td>
                    <td>@Int(s["lab_hours"])</td><td>@Int(s["self_study"])</td><td>@Int(s["control"])</td><td>@Int(s["credits"])</td>
                    <td>@string.Join(", ", (s["control_types"] as JsonArray ?? []).Select(t => SchemaContext.EnumTitle(ControlTypes, Text(t) ?? "")))</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private IEnumerable<JsonObject> Semesters => (Value?["semesters"] as JsonArray ?? []).OfType<JsonObject>();

    private static int Int(JsonNode? node) => node is JsonValue v && v.TryGetValue(out int i) ? i : 0;

    // Схема видов аттестации — для русских названий кодов (x-enum-titles).
    private JsonElement ControlTypes =>
        Schema.TryGetProperty("properties", out var p) && p.TryGetProperty("semesters", out var s) &&
        s.TryGetProperty("items", out var i) && i.TryGetProperty("properties", out var ip) &&
        ip.TryGetProperty("control_types", out var c) && c.TryGetProperty("items", out var items)
            ? items
            : default;
}
