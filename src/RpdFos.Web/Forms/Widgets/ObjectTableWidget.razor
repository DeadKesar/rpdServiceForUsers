@using System.Text.Json
@using System.Text.Json.Nodes
@inherits FieldBase

@* Таблица записей по схеме элемента: занятия, литература, интернет-ресурсы, составители. Длинные поля записи
   (библиографическая запись, название) — отдельной строкой во всю ширину с высотой по содержимому, короткие — под
   ними столбцами. *@
<div class="mb-3">
    <label class="form-label">@Title</label>
    @{ var rows = Value as JsonArray; }
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                @foreach (var column in ShortColumns)
                {
                    <th>@(SchemaContext.Text(column.Schema, "title") ?? column.Name)</th>
                }
                <th></th>
            </tr>
        </thead>
        @for (var i = 0; i < (rows?.Count ?? 0); i++)
        {
            var index = i;
            var row = rows![index] as JsonObject;
            <tbody class="border-top">
                @if (row is not null && LongColumns.Count > 0)
                {
                    <tr>
                        <td colspan="@(ShortColumns.Count + 1)" class="border-bottom-0">
                            @foreach (var column in LongColumns)
                            {
                                <label class="form-label small text-muted mb-0">@(SchemaContext.Text(column.Schema, "title") ?? column.Name)</label>
                                <ScalarInput Context="Context" Schema="column.Schema" Parent="row" Key="@column.Name"
                                             Path="@($"{Path}/{index}/{column.Name}")" Compact="true" Multiline="true" />
                            }
                        </td>
                    </tr>
                }
                <tr>
                    @foreach (var column in ShortColumns)
                    {
                        <td>
                            @if (row is not null)
                            {
                                <ScalarInput Context="Context" Schema="column.Schema" Parent="row" Key="@column.Name"
                                             Path="@($"{Path}/{index}/{column.Name}")" Compact="true" />
                            }
                        </td>
                    }
                    <td class="text-end">
                        @if (!ReadOnly)
                        {
                            <button class="btn btn-sm btn-outline-secondary" type="button" title="Удалить строку" @onclick="() => Remove(index)">✕</button>
                        }
                    </td>
                </tr>
            </tbody>
        }
    </table>
    @if (!ReadOnly)
    {
        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="Add">Добавить строку</button>
    }
    @if (Hint is not null)
    {
        <div class="form-text">@Hint</div>
    }
</div>

@code {
    // Столбцы — простые свойства элемента; вложенные списки и объекты в таблице не редактируются.
    private IEnumerable<(string Name, JsonElement Schema)> Columns =>
        Items.ValueKind == JsonValueKind.Object && Items.TryGetProperty("properties", out var props)
            ? props.EnumerateObject().Select(p => (p.Name, Schema: Context.Resolve(p.Value)))
                .Where(c => SchemaContext.Type(c.Schema) is not ("array" or "object"))
            : [];

    private List<(string Name, JsonElement Schema)> LongColumns => Columns.Where(c => IsLong(c.Schema)).ToList();

    private List<(string Name, JsonElement Schema)> ShortColumns => Columns.Where(c => !IsLong(c.Schema)).ToList();

    // Длинная строка — с подсказкой x-ui-widget: textarea; в шаблонах до неё — библиографическая запись (minLength 20).
    private static bool IsLong(JsonElement schema) =>
        SchemaContext.Text(schema, "x-ui-widget") == "textarea" ||
        SchemaContext.Type(schema) == "string" && schema.TryGetProperty("minLength", out var m) && m.TryGetInt32(out var n) && n >= 20;

    private void Add()
    {
        var rows = EnsureArray();
        var row = new JsonObject();
        // Номер по порядку — следующий: так у занятий не нужно набирать его вручную.
        if (Columns.Any(c => c.Name == "number")) row["number"] = rows.Count + 1;
        rows.Add(row);
        Context.Changed();
    }

    private void Remove(int index)
    {
        EnsureArray().RemoveAt(index);
        Context.Changed();
    }
}
