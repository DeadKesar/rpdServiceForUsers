@using System.Text.Json
@using System.Text.Json.Nodes
@inherits FieldBase

@* Таблица записей по схеме элемента: занятия, литература, интернет-ресурсы, составители. Длинные поля записи
   (библиографическая запись, название) — отдельной строкой во всю ширину с высотой по содержимому, короткие — под
   ними столбцами. *@
<div class="mb-3">
    <label class="form-label">@Title</label>
    @{ var rows = Value as JsonArray; }
    @* Узкий экран: таблица прокручивается в обёртке, а не рвёт слова по буквам (общее правило — app.css). *@
    <div class="table-responsive">
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                @foreach (var column in ShortColumns)
                {
                    <th>@(SchemaContext.Text(column.Schema, "title") ?? column.Name)</th>
                }
                <th></th>
            </tr>
        </thead>
        @for (var i = 0; i < (rows?.Count ?? 0); i++)
        {
            var index = i;
            var row = rows![index] as JsonObject;
            @* Ключ с номером перестановки — как у списка строк (StringListWidget): после перестановки и удаления строки создаются
               заново из содержимого, иначе многострочное поле, в котором печатали, осталось бы с прежним текстом. *@
            <tbody class="border-top" @key="(_arrangement, index)">
                @if (row is not null && LongColumns.Count > 0)
                {
                    <tr>
                        <td colspan="@(ShortColumns.Count + 1)" class="border-bottom-0">
                            @foreach (var column in LongColumns)
                            {
                                <label class="form-label small text-muted mb-0">@(SchemaContext.Text(column.Schema, "title") ?? column.Name)</label>
                                <ScalarInput Context="Context" Schema="column.Schema" Parent="row" Key="@column.Name"
                                             Path="@($"{Path}/{index}/{column.Name}")" Compact="true" Multiline="true" />
                            }
                        </td>
                    </tr>
                }
                <tr>
                    @foreach (var column in ShortColumns)
                    {
                        <td>
                            @if (row is not null)
                            {
                                <ScalarInput Context="Context" Schema="column.Schema" Parent="row" Key="@column.Name"
                                             Path="@($"{Path}/{index}/{column.Name}")" Compact="true" />
                            }
                        </td>
                    }
                    <td class="text-end text-nowrap">
                        @if (!ReadOnly)
                        {
                            <div class="btn-group btn-group-sm">
                                @if (Reorderable)
                                {
                                    <MoveButtons Index="index" Count="rows!.Count" Moved="delta => Move(index, delta)" />
                                }
                                <button class="btn btn-sm btn-outline-secondary" type="button" title="Удалить строку" @onclick="() => Remove(index)">✕</button>
                            </div>
                        }
                    </td>
                </tr>
            </tbody>
        }
        @if (ClassHoursKey is { } planKey)
        {
            @* Таблица занятий (3.3, 3.4): итог часов против часов документа этого вида (правило class_hours_match_total). *@
            <tfoot class="border-top">
                <tr>
                    @foreach (var column in ShortColumns)
                    {
                        <td class="fw-semibold">
                            @if (column.Name == "hours")
                            {
                                <HoursSum Actual="@((rows ?? []).OfType<JsonObject>().Sum(r => Number(r["hours"])))" Planned="@PlannedHours(planKey)" />
                            }
                            else if (column.Name == ShortColumns[0].Name)
                            {
                                <text>Итого</text>
                            }
                        </td>
                    }
                    <td></td>
                </tr>
            </tfoot>
        }
    </table>
    </div>
    @if (!ReadOnly)
    {
        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="Add">Добавить строку</button>
    }
    @if (Hint is not null)
    {
        <div class="form-text">@Hint</div>
    }
</div>

@code {
    // Столбцы — простые свойства элемента; вложенные списки и объекты в таблице не редактируются.
    private IEnumerable<(string Name, JsonElement Schema)> Columns =>
        Items.ValueKind == JsonValueKind.Object && Items.TryGetProperty("properties", out var props)
            ? props.EnumerateObject().Select(p => (p.Name, Schema: Context.Resolve(p.Value)))
                .Where(c => SchemaContext.Type(c.Schema) is not ("array" or "object"))
            : [];

    private List<(string Name, JsonElement Schema)> LongColumns => Columns.Where(c => IsLong(c.Schema)).ToList();

    private List<(string Name, JsonElement Schema)> ShortColumns => Columns.Where(c => !IsLong(c.Schema)).ToList();

    // Длинная строка — с подсказкой x-ui-widget: textarea; в шаблонах до неё — библиографическая запись (minLength 20).
    private static bool IsLong(JsonElement schema) =>
        SchemaContext.Text(schema, "x-ui-widget") == "textarea" ||
        SchemaContext.Type(schema) == "string" && schema.TryGetProperty("minLength", out var m) && m.TryGetInt32(out var n) && n >= 20;

    // Вид часов трудоёмкости для таблицы занятий: лабораторные или практические; у остальных таблиц итога нет.
    private string? ClassHoursKey => SchemaContext.Text(Schema, "x-ui-widget") != "class_table" ? null : Path switch
    {
        "/lab_works" => "lab_hours",
        "/practical_classes" => "practice",
        _ => null
    };

    private int PlannedHours(string key) =>
        (Context.Payload["hours_distribution"]?["semesters"] as JsonArray ?? []).OfType<JsonObject>().Sum(s => Number(s[key]));

    private void Add()
    {
        var rows = EnsureArray();
        var row = new JsonObject();
        // Номер занятия — следующий за последним номером предыдущей строки («1–2» → «3»): так его не нужно набирать вручную.
        // У нового шаблона номер — текст, у прежних — целое число.
        if (Columns.FirstOrDefault(c => c.Name == "number") is { Schema.ValueKind: JsonValueKind.Object } number)
            row["number"] = SchemaContext.Type(number.Schema) == "string"
                ? JsonValue.Create(ClassNumbers.Next(rows).ToString())
                : JsonValue.Create(ClassNumbers.Next(rows));
        rows.Add(row);
        Context.Changed();
    }

    private void Remove(int index)
    {
        EnsureArray().RemoveAt(index);
        _arrangement++;
        Context.Changed();
    }

    // Порядок записей меняется только в списках, которые схема нового шаблона отметила x-reorderable (этап 7.1): литература
    // и интернет-ресурсы. Таблицы занятий нумеруются автором, их порядок остаётся порядком добавления.
    private bool Reorderable => ListOrder.IsReorderable(Schema);

    // Номер расстановки строк: растёт при удалении и перестановке (см. ключ строки).
    private int _arrangement;

    private void Move(int index, int delta)
    {
        if (!ListOrder.Move(EnsureArray(), index, delta)) return;
        _arrangement++;
        Context.Changed();
    }
}
