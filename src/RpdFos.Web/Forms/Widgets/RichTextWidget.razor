@using System.Text.Json.Nodes
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@inherits FieldBase
@implements IDisposable
@inject DialogService DialogService
@inject NotificationService Notifications
@inject IAccessTokenProvider TokenProvider

@* Форматированный текст: полужирный, курсив, списки и таблицы (решение этапа 4 и B4 этапа 7); разметку на сервере
   чистит санитайзер. Таблица: своя кнопка со вставкой (диалог «строк, столбцов, заголовок») и команды Radzen над
   строками, столбцами и ячейками. Строки и столбцы по сетке при объединённых ячейках ведут свои функции
   (wwwroot/js/rpdfos-tables.js), диалога правки таблицы нет. *@
<div class="mb-3">
    <label class="form-label">@Title</label>
    @if (ReadOnly)
    {
        <div class="border rounded p-2 bg-light rich-text">@((MarkupString)(Text(Value) ?? ""))</div>
    }
    else
    {
        <RadzenHtmlEditor @ref="editor" Value="@(Text(Value) ?? "")" Input="@((string html) => OnInput(html))"
                          ValueChanged="@((string html) => OnChanged(html))" TableStrings="@TableTexts"
                          UploadUrl="@UploadUrl" UploadHeaders="@uploadHeaders" UploadError="@OnUploadError"
                          Execute="@OnExecute" Style="height: 220px;">
            <RadzenHtmlEditorBold Title="Полужирный" />
            <RadzenHtmlEditorItalic Title="Курсив" />
            <RadzenHtmlEditorUnorderedList Title="Маркированный список" />
            <RadzenHtmlEditorOrderedList Title="Нумерованный список" />
            <RadzenHtmlEditorSeparator />
            @* Рисунок — только из файла: адреса не принимаются. У значений по умолчанию шаблона документа нет, рисунки не вставляются. *@
            @if (Context.DocumentId is not null)
            {
                <RadzenHtmlEditorImage Title="Рисунок" SelectText="Файл рисунка (PNG или JPEG, до 2 МБ)" UploadChooseText="Выбрать файл"
                                       ShowSrc="false" AltText="Описание рисунка (необязательно)" OkText="Вставить" CancelText="Отмена"
                                       WidthText="Ширина, точек" HeightText="Высота, точек" />
            }
            @* Таблицы в ячейке таблицы не бывает: в ячейке кнопка недоступна. *@
            <RadzenHtmlEditorCustomTool CommandName="@InsertTable" Icon="table_chart" Title="Таблица"
                                        Disabled="@(editor?.TableSelection?.InTable == true)" />
            <RadzenHtmlEditorTableCommandButton TableCommand="addRowBefore" Icon="north" Title="@TableTexts.InsertRowAbove" />
            <RadzenHtmlEditorTableCommandButton TableCommand="addRowAfter" Icon="south" Title="@TableTexts.InsertRowBelow" />
            <RadzenHtmlEditorTableCommandButton TableCommand="addColumnBefore" Icon="west" Title="@TableTexts.InsertColumnLeft" />
            <RadzenHtmlEditorTableCommandButton TableCommand="addColumnAfter" Icon="east" Title="@TableTexts.InsertColumnRight" />
            <RadzenHtmlEditorTableCommandButton TableCommand="deleteRow" Icon="horizontal_rule" Title="@TableTexts.DeleteRow" />
            <RadzenHtmlEditorTableCommandButton TableCommand="deleteColumn" Icon="vertical_align_center" Title="@TableTexts.DeleteColumn" />
            <RadzenHtmlEditorTableCommandButton TableCommand="mergeCellRight" Icon="merge_type" Title="@TableTexts.MergeRight" />
            <RadzenHtmlEditorTableCommandButton TableCommand="mergeCellDown" Icon="merge" Title="@TableTexts.MergeDown" />
            <RadzenHtmlEditorTableCommandButton TableCommand="splitCell" Icon="call_split" Title="@TableTexts.SplitCell" />
        </RadzenHtmlEditor>
    }
    @if (Hint is not null)
    {
        <div class="form-text">@Hint</div>
    }
    @if (!ReadOnly)
    {
        <div class="form-text">
            Формулы — линейной записью, символами Unicode: x² + y₁ ≤ √z. В таблице сохраняются строки, столбцы и
            объединение ячеек; цвет, ширина и выравнивание не сохраняются — печатается таблица с рамками на всю ширину.
            Таблицы внутри ячейки нет: вставленная туда таблица становится текстом.
        </div>
        @if (Context.DocumentId is not null)
        {
            <div class="form-text">
                Рисунки — PNG и JPEG, до 2 МБ, не больше 100 на документ; вставляются из файла, из буфера и перетаскиванием,
                размер меняется ручками на рисунке. Подпись «Рисунок N» пишется текстом. Формулу можно вставить рисунком.
                Рисунок из Word вместе с текстом не переносится — вставьте его отдельно.
            </div>
        }
    }
</div>

@code {
    private const string InsertTable = "InsertTable";

    private RadzenHtmlEditor? editor;

    private void OnChanged(string? html) => SetValue(Html(html));

    // Input — каждая правка в редакторе: признак несохранённых правок не ждёт ухода из него.
    private void OnInput(string? html) => InputValue(Html(html));

    // Пустой редактор отдаёт «<br>» или пустой абзац — это не текст: поле удаляется из содержимого.
    // Таблица без текста и рисунок без слов — не пустое поле: слов пока нет, но содержимое уже есть.
    private static JsonValue? Html(string? html) =>
        string.IsNullOrWhiteSpace(Regex.Replace(html ?? "", "<[^>]*>|&nbsp;", "")) && !Regex.IsMatch(html ?? "", "<(table|img)", RegexOptions.IgnoreCase)
            ? null : JsonValue.Create(html);

    // ---- Рисунки (этап 7, B4а) ----
    // Редактор Radzen сам загружает файл на этот адрес (из диалога, из буфера, перетаскиванием) и вставляет <img> с адресом из
    // ответа. Загрузка идёт с токеном: заголовки берутся при каждой загрузке, поэтому токен обновляется по таймеру.
    private string? UploadUrl => Context.DocumentId is { } id ? $"/api/documents/{id}/images" : null;

    private Dictionary<string, string> uploadHeaders = [];
    private System.Threading.Timer? tokenTimer;

    protected override async Task OnInitializedAsync()
    {
        if (Context.DocumentId is null || ReadOnly) return;
        await RefreshTokenAsync();
        tokenTimer = new System.Threading.Timer(_ => _ = InvokeAsync(RefreshTokenAsync), null, TimeSpan.FromMinutes(4), TimeSpan.FromMinutes(4));
    }

    private async Task RefreshTokenAsync()
    {
        var result = await TokenProvider.RequestAccessToken();
        if (result.TryGetToken(out var token))
            uploadHeaders = new Dictionary<string, string> { ["Authorization"] = $"Bearer {token.Value}" };
    }

    // Ответ сервера — ProblemDetails с причиной на русском («Рисунок больше 2 МБ»); иное показывается как есть.
    private void OnUploadError(UploadErrorEventArgs args)
    {
        var message = args.Message ?? "";
        try
        {
            if (System.Text.Json.JsonDocument.Parse(message).RootElement is { ValueKind: System.Text.Json.JsonValueKind.Object } root &&
                root.TryGetProperty("detail", out var detail) && detail.GetString() is { Length: > 0 } text)
                message = text;
        }
        catch (System.Text.Json.JsonException)
        {
            message = "Не удалось загрузить рисунок. Проверьте связь и повторите.";
        }
        Notifications.Notify(NotificationSeverity.Warning, "Рисунок не вставлен", message);
    }

    public void Dispose() => tokenTimer?.Dispose();

    private async Task OnExecute(HtmlEditorExecuteEventArgs args)
    {
        if (args.CommandName != InsertTable) return;
        var target = args.Editor;
        if ((await target.GetTableSelectionAsync()).InTable)
        {
            Notifications.Notify(NotificationSeverity.Warning, "Таблица", "Таблицу нельзя вставить в ячейку другой таблицы.");
            return;
        }

        // Диалог забирает фокус у редактора: место вставки запоминается и возвращается.
        await target.SaveSelectionAsync();
        var answer = await DialogService.OpenAsync<TableInsertDialog>("Таблица", options: new DialogOptions { Width = "24rem" });
        await target.RestoreSelectionAsync();
        if (answer is not TableSize size) return;

        // Строк в диалоге — всего; Radzen считает строки тела отдельно от строки заголовка.
        await target.ExecuteTableCommandAsync("insertTable", new HtmlEditorTableCommandArgs
        {
            Rows = size.HeaderRow ? size.Rows - 1 : size.Rows,
            Columns = size.Columns,
            HeaderRow = size.HeaderRow,
            Width = "100%",
            Border = 1
        });
    }

    // Подписи инструментов таблицы по-русски: их показывают кнопки панели и меню по правой кнопке мыши.
    // Редактор предлагает и цвет, ширину, рамки и выравнивание ячеек: санитайзер их снимает (см. подсказку под полем),
    // печать рисует таблицу сама. Заголовок «Столбец N» не нужен: ячейки заголовка у новой таблицы пустые.
    private static readonly HtmlEditorTableStrings TableTexts = new()
    {
        DialogTitle = "Таблица",
        Rows = "Строк",
        Columns = "Столбцов",
        Width = "Ширина",
        Border = "Рамка",
        HeaderRow = "Строка заголовка",
        Edit = "Правка таблицы",
        OK = "Вставить",
        Update = "Применить",
        Cancel = "Отмена",
        CopyCells = "Копировать ячейки",
        PasteCells = "Вставить ячейки",
        InsertRowAbove = "Вставить строку выше",
        InsertRowBelow = "Вставить строку ниже",
        InsertColumnLeft = "Вставить столбец слева",
        InsertColumnRight = "Вставить столбец справа",
        DeleteRow = "Удалить строку",
        DeleteColumn = "Удалить столбец",
        MergeRight = "Объединить с ячейкой справа",
        MergeDown = "Объединить с ячейкой снизу",
        SplitCell = "Разделить ячейку",
        DeleteTable = "Удалить таблицу",
        ColumnWidth = "Ширина столбца",
        CellBackground = "Цвет ячейки",
        CellPadding = "Отступ в ячейке",
        CellTextAlign = "Выравнивание по горизонтали",
        CellVerticalAlign = "Выравнивание по вертикали",
        CellBorder = "Рамка ячейки",
        ColumnWidthPx = "Ширина столбца, px",
        CellPaddingPx = "Отступ в ячейке, px",
        BorderStyle = "Вид рамки",
        BorderWidthPx = "Толщина рамки, px",
        BorderColor = "Цвет рамки",
        BorderTop = "Сверху",
        BorderRight = "Справа",
        BorderBottom = "Снизу",
        BorderLeft = "Слева",
        ActionBlocked = "Действие недоступно",
        ActionRequiresTable = "Поставьте курсор в ячейку таблицы",
        CopyInvalidSelection = "Выделите ячейки одной таблицы",
        PasteBlocked = "Вставка ячеек сейчас недоступна",
        MergeInvalidSelection = "Эти ячейки нельзя объединить"
    };
}
