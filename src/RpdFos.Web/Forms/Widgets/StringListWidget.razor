@using System.Text.RegularExpressions
@using System.Text.Json.Nodes
@inherits FieldBase

@* Список строк: задачи, формы контроля, программное обеспечение, материально-техническое обеспечение. Пункты бывают
   длинными — многострочное поле во всю ширину с высотой по содержимому. *@
<div class="mb-3">
    <label class="form-label">@Title</label>
    @{ var items = Value as JsonArray; }
    @for (var i = 0; i < (items?.Count ?? 0); i++)
    {
        var index = i;
        <div class="input-group input-group-sm mb-1">
            <span class="input-group-text align-items-start">@(index + 1)</span>
            <textarea class="form-control auto-grow" rows="1" readonly="@ReadOnly"
                      @oninput="e => Input(index, e.Value as string)" @onchange="e => Change(index, e.Value as string)">@Text(items![index])</textarea>
            @if (!ReadOnly)
            {
                <button class="btn btn-outline-secondary" type="button" title="Удалить" @onclick="() => Remove(index)">✕</button>
            }
        </div>
    }
    @if (!ReadOnly)
    {
        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="Add">Добавить</button>
    }
    @if (Hint is not null)
    {
        <div class="form-text">@Hint</div>
    }
</div>

@code {
    private void Add()
    {
        EnsureArray().Add(JsonValue.Create(""));
        Context.Changed();
    }

    // По мере ввода — как есть (см. ScalarInput); пробелы по краям снимает уход из поля.
    private void Input(int index, string? text)
    {
        EnsureArray()[index] = JsonValue.Create(text ?? "");
        Context.Edited();
    }

    // Пункт списка — один абзац: перевод строки из поля становится пробелом, в печати он разорвал бы пункт.
    private void Change(int index, string? text)
    {
        EnsureArray()[index] = JsonValue.Create(LineBreaks.Replace(text ?? "", " ").Trim());
        Context.Changed();
    }

    private void Remove(int index)
    {
        EnsureArray().RemoveAt(index);
        Context.Changed();
    }

    private static readonly Regex LineBreaks = new(@"\s*[\r\n]+\s*");
}
