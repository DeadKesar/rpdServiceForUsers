@using System.Text.Json
@using System.Text.Json.Nodes
@inherits FieldBase

@* Тематический план: темы по разделам, часы по видам занятий против плана, индикаторы из выбранных в «Компетенциях».
   У тем новых шаблонов есть семестр (этап 5.2): выбирается из семестров трудоёмкости документа, у дисциплины одного
   семестра ставится сам; сводка и сверка часов — по семестрам. *@
<div class="mb-3">
    @if (BySemester)
    {
        <table class="table table-sm table-bordered mb-2">
            <thead class="table-light">
                <tr><th>Семестр</th><th>Вид занятий</th><th>По темам / по распределению часов</th></tr>
            </thead>
            <tbody>
                @foreach (var semester in DocumentSemesters)
                {
                    var number = Number(semester["semester"]);
                    var kinds = HourKinds.Where(k => Number(semester[k.Key]) > 0 || TopicHours(k.Key, number) > 0).ToList();
                    @for (var k = 0; k < kinds.Count; k++)
                    {
                        var (key, title) = kinds[k];
                        var planned = Number(semester[key]);
                        var topics = TopicHours(key, number);
                        <tr class="@(topics != planned ? "table-warning" : "")">
                            @if (k == 0)
                            {
                                <td rowspan="@kinds.Count">@number</td>
                            }
                            <td>@title</td><td>@topics / @planned</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
    else
    {
        <table class="table table-sm table-bordered mb-2">
            <thead class="table-light">
                <tr><th>Вид занятий</th><th>В плане тем</th><th>По распределению часов</th></tr>
            </thead>
            <tbody>
                @foreach (var (key, title) in HourKinds)
                {
                    var planned = PlanHours(key);
                    var topics = TopicHours(key);
                    <tr class="@(topics != planned ? "table-warning" : "")">
                        <td>@title</td><td>@topics</td><td>@planned</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @{ var rows = Value as JsonArray; }
    @for (var i = 0; i < (rows?.Count ?? 0); i++)
    {
        var index = i;
        if (rows![index] is not JsonObject topic) continue;
        var hours = Hours(topic);
        <div class="border rounded p-2 mb-2">
            <div class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label small">Раздел</label>
                    <ScalarInput Context="Context" Schema="SectionNumber" Parent="topic" Key="section_number"
                                 Path="@($"{Path}/{index}/section_number")" Compact="true" />
                </div>
                @if (BySemester && DocumentSemesters.Count > 1)
                {
                    var current = Number(topic["semester"]);
                    <div class="col-md-2">
                        <label class="form-label small">Семестр</label>
                        <select class="form-select form-select-sm" disabled="@ReadOnly" value="@(current > 0 ? current.ToString() : "")"
                                @onchange="e => SetSemester(topic, index, e.Value as string)">
                            <option value="">—</option>
                            @foreach (var semester in DocumentSemesters)
                            {
                                var n = Number(semester["semester"]);
                                <option value="@n">@n</option>
                            }
                        </select>
                    </div>
                }
                <div class="@(BySemester && DocumentSemesters.Count > 1 ? "col-md-7" : "col-md-9")">
                    <label class="form-label small">Тема</label>
                    <ScalarInput Context="Context" Schema="TopicTitle" Parent="topic" Key="topic_title"
                                 Path="@($"{Path}/{index}/topic_title")" Compact="true" />
                </div>
                <div class="col-md-1 text-end">
                    @if (!ReadOnly)
                    {
                        <button class="btn btn-sm btn-outline-secondary" type="button" title="Удалить тему" @onclick="() => Remove(index)">✕</button>
                    }
                </div>
            </div>
            <div class="mt-2">
                <label class="form-label small">Содержание</label>
                <textarea class="form-control form-control-sm" rows="2" readonly="@ReadOnly"
                          @oninput='e => InputText(topic, "topic_description", e.Value as string)'
                          @onchange='e => SetText(topic, "topic_description", e.Value as string)'>@Text(topic["topic_description"])</textarea>
            </div>
            <div class="row g-2 mt-1">
                @foreach (var (key, title) in HourKinds)
                {
                    <div class="col-6 col-md-3">
                        <label class="form-label small">@title</label>
                        @if (Absent(topic, key))
                        {
                            @* Вида занятий в семестре темы по распределению часов нет. *@
                            <input class="form-control form-control-sm" value="–" disabled title="В этом семестре по распределению часов таких занятий нет" />
                        }
                        else
                        {
                            <ScalarInput Context="Context" Schema="HoursProperty(key)" Parent="hours" Key="@key"
                                         Path="@($"{Path}/{index}/hours/{key}")" Compact="true" />
                        }
                    </div>
                }
            </div>
            @if (ChosenIndicators.Count > 0)
            {
                <div class="mt-2 small">
                    <span class="text-muted me-1">Индикаторы:</span>
                    @foreach (var indicatorCode in ChosenIndicators)
                    {
                        <label class="form-check form-check-inline mb-0">
                            <input type="checkbox" class="form-check-input" disabled="@ReadOnly"
                                   checked="@HasIndicator(topic, indicatorCode)" @onchange="e => ToggleIndicator(topic, indicatorCode, e.Value is true)" />
                            <span class="form-check-label">@indicatorCode</span>
                        </label>
                    }
                </div>
            }
            <div class="mt-2">
                <SchemaField Context="Context" Schema="ControlForms" Parent="topic" Key="current_control_forms"
                             Path="@($"{Path}/{index}/current_control_forms")" Nested="true" />
                @if (SelfStudyForms.Count > 0)
                {
                    <div class="small">
                        <span class="text-muted me-1">Из видов самостоятельной работы:</span>
                        @foreach (var (form, kind) in SelfStudyForms)
                        {
                            <label class="form-check form-check-inline mb-0" title="@kind">
                                <input type="checkbox" class="form-check-input" disabled="@ReadOnly"
                                       checked="@HasForm(topic, form)" @onchange="e => ToggleForm(topic, form, e.Value is true)" />
                                <span class="form-check-label">@form</span>
                            </label>
                        }
                    </div>
                }
            </div>
        </div>
    }
    @if (!ReadOnly)
    {
        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="Add">Добавить тему</button>
    }
    @if (ChosenIndicators.Count == 0)
    {
        <div class="form-text">Индикаторы для тем появятся после выбора в разделе «Компетенции и индикаторы».</div>
    }
</div>

@code {
    private static readonly (string Key, string Title)[] HourKinds =
        [("lectures", "Лекции"), ("practice", "Практика"), ("lab_hours", "Лабораторные"), ("self_study", "Самостоятельная работа")];

    private JsonElement Property(string name) =>
        Items.ValueKind == JsonValueKind.Object && Items.GetProperty("properties").TryGetProperty(name, out var p) ? Context.Resolve(p) : default;

    private JsonElement SectionNumber => Property("section_number");
    private JsonElement TopicTitle => Property("topic_title");
    private JsonElement ControlForms => Property("current_control_forms");

    private JsonElement HoursProperty(string name) =>
        Property("hours") is { ValueKind: JsonValueKind.Object } h && h.GetProperty("properties").TryGetProperty(name, out var p) ? p : default;

    // У темы всегда есть объект часов: поле обязательно, и в него пишут поля часов.
    private static JsonObject Hours(JsonObject topic)
    {
        if (topic["hours"] is JsonObject hours) return hours;
        var created = new JsonObject();
        topic["hours"] = created;
        return created;
    }

    private int TopicHours(string key) => (Value as JsonArray ?? []).OfType<JsonObject>().Sum(t => Number(t["hours"]?[key]));

    private int TopicHours(string key, int semester) =>
        (Value as JsonArray ?? []).OfType<JsonObject>().Where(t => Number(t["semester"]) == semester).Sum(t => Number(t["hours"]?[key]));

    // Семестр темы есть в схеме шаблона (этап 5.2) — у прежних шаблонов сверка общей суммой.
    private bool BySemester => Property("semester").ValueKind == JsonValueKind.Object;

    // Семестры трудоёмкости документа — исправленные методистом, если исправлял.
    private List<JsonObject> DocumentSemesters =>
        (Context.Payload["hours_distribution"]?["semesters"] as JsonArray ?? []).OfType<JsonObject>()
            .Where(s => Number(s["semester"]) > 0).OrderBy(s => Number(s["semester"])).ToList();

    // Вида занятий нет в семестре темы по распределению часов — поле недоступно.
    private bool Absent(JsonObject topic, string key) =>
        BySemester && DocumentSemesters.FirstOrDefault(s => Number(s["semester"]) == Number(topic["semester"])) is { } semester &&
        Number(semester[key]) == 0;

    // У дисциплины одного семестра он ставится сам и не показывается: так и у тем, добавленных до исправления часов.
    protected override void OnParametersSet()
    {
        if (!BySemester || ReadOnly || DocumentSemesters is not [var only]) return;
        var number = Number(only["semester"]);
        var changed = false;
        foreach (var topic in (Value as JsonArray ?? []).OfType<JsonObject>().Where(t => Number(t["semester"]) != number))
        {
            topic["semester"] = number;
            changed = true;
        }
        if (changed) Context.Edited();
    }

    // Другой семестр — часы видов, которых в нём нет, снимаются: ввести их там нельзя.
    private void SetSemester(JsonObject topic, int index, string? value)
    {
        if (int.TryParse(value, out var number)) topic["semester"] = number;
        else topic.Remove("semester");
        if (topic["hours"] is JsonObject hours)
            foreach (var (key, _) in HourKinds.Where(k => Absent(topic, k.Key)))
                hours.Remove(key);
        Context.Changed($"{Path}/{index}/semester");
    }

    private int PlanHours(string key) =>
        (Context.Payload["hours_distribution"]?["semesters"] as JsonArray ?? []).OfType<JsonObject>().Sum(s => Number(s[key]));

    // Индикаторы, выбранные в разделе «Компетенции и индикаторы».
    private List<string> ChosenIndicators =>
        (Context.Payload["competences"] as JsonArray ?? []).OfType<JsonObject>()
            .SelectMany(c => (c["indicators"] as JsonArray ?? []).OfType<JsonObject>())
            .Select(i => Text(i["code"]) ?? "").Where(c => c.Length > 0).Distinct().ToList();

    // Виды самостоятельной работы с обозначением формы (реферат — «Р»): обозначение выбирается в формы контроля темы.
    private List<(string Code, string Kind)> SelfStudyForms =>
        (Context.Payload["hours_distribution"]?["self_study_kinds"] as JsonArray ?? []).OfType<JsonObject>()
            .Select(k => (Code: Text(k["form_code"])?.Trim() ?? "", Kind: Text(k["kind"]) ?? ""))
            .Where(f => f.Code.Length > 0).DistinctBy(f => f.Code).ToList();

    private bool HasForm(JsonObject topic, string code) =>
        (topic["current_control_forms"] as JsonArray ?? []).Any(n => Text(n) == code);

    private void ToggleForm(JsonObject topic, string code, bool on)
    {
        if (topic["current_control_forms"] is not JsonArray list) topic["current_control_forms"] = list = new JsonArray();
        var existing = list.FirstOrDefault(n => Text(n) == code);
        if (on && existing is null) list.Add(JsonValue.Create(code));
        if (!on && existing is not null) list.Remove(existing);
        if (list.Count == 0) topic.Remove("current_control_forms");
        Context.Changed();
    }

    private bool HasIndicator(JsonObject topic, string code) =>
        (topic["competence_indicators"] as JsonArray ?? []).Any(n => Text(n) == code);

    private void ToggleIndicator(JsonObject topic, string code, bool on)
    {
        if (topic["competence_indicators"] is not JsonArray list) topic["competence_indicators"] = list = new JsonArray();
        var existing = list.FirstOrDefault(n => Text(n) == code);
        if (on && existing is null) list.Add(JsonValue.Create(code));
        if (!on && existing is not null) list.Remove(existing);
        Context.Changed();
    }

    private void SetText(JsonObject topic, string key, string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) topic.Remove(key);
        else topic[key] = text.Trim();
        Context.Changed();
    }

    // По мере ввода — как есть (см. ScalarInput); пробелы по краям снимает уход из поля.
    private void InputText(JsonObject topic, string key, string? text)
    {
        if (string.IsNullOrEmpty(text)) topic.Remove(key);
        else topic[key] = text;
        Context.Edited();
    }

    private void Add()
    {
        var rows = EnsureArray();
        var topic = new JsonObject { ["section_number"] = rows.Count + 1, ["hours"] = new JsonObject() };
        // Семестр новой темы — как у предыдущей, первой — первый семестр дисциплины.
        if (BySemester && (rows.OfType<JsonObject>().LastOrDefault()?["semester"] is JsonValue last ? Number(last) :
                DocumentSemesters.Select(s => Number(s["semester"])).FirstOrDefault()) is var semester and > 0)
            topic["semester"] = semester;
        rows.Add(topic);
        Context.Changed();
    }

    private void Remove(int index)
    {
        EnsureArray().RemoveAt(index);
        Context.Changed();
    }
}
