@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NotificationService Notifications
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 auth">
            <LoginDisplay />
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@* Окна Radzen: диалог «Таблица» редактора текста, предупреждения его таблиц и меню правой кнопки по ячейке.
   Без RadzenNotification и RadzenContextMenu сообщения редактора не видны, а щелчок по ячейке ничего не открывает. *@
<RadzenDialog />
<RadzenNotification />
<RadzenContextMenu />

@code {
    private DotNetObjectReference<MainLayout>? self;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // Предупреждения скриптов таблиц (wwwroot/js/rpdfos-tables.js) показываются здесь же, окном Radzen.
        self = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("rpdfosTables.register", self);
    }

    [JSInvokable]
    public void Warn(string message) => Notifications.Notify(new NotificationMessage
    {
        Severity = NotificationSeverity.Warning,
        Summary = "Таблица",
        Detail = message,
        Duration = 7000
    });

    public async ValueTask DisposeAsync()
    {
        if (self is null) return;
        try { await JS.InvokeVoidAsync("rpdfosTables.unregister", self); }
        catch (JSDisconnectedException) { }
        self.Dispose();
    }
}
