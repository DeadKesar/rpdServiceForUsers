@page "/documents/{Id:guid}"
@attribute [Authorize]
@implements IDisposable
@using System.Net
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Nodes
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using RpdFos.Web.Models
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(details?.Document.DisciplineName ?? "Документ")</PageTitle>

<NavigationLock ConfirmExternalNavigation="@dirty" OnBeforeInternalNavigation="OnBeforeNavigationAsync" />
<ConfirmDialog @ref="confirm" />

@* Согласующий приходит из своей очереди; «Мои документы» есть у тех, кто документы пишет или видит все. *@
<p>
    <AuthorizeView Roles="teacher,methodist,admin" Context="auth">
        <a href="documents" class="me-3">← Мои документы</a>
    </AuthorizeView>
    <AuthorizeView Roles="approver" Context="auth">
        <a href="approvals">← Согласование</a>
    </AuthorizeView>
</p>

@if (details is null || context is null)
{
    @if (message is not null)
    {
        <div class="alert alert-danger">@message</div>
    }
    else
    {
        <p>Загрузка…</p>
    }
}
else
{
    var d = details.Document;
    <h1 class="h3">@d.DisciplineCode @d.DisciplineName</h1>
    <p class="text-muted">
        @(d.Type == "fos" ? "ФОС" : "РПД") · <strong>@statusTitle</strong> · редакция шаблона @d.TemplateRevision
        @if (d.IsOutdated)
        {
            <span class="badge text-bg-warning ms-1" title="@DocumentTitles.OutdatedHint">устарел</span>
        }
    </p>

    @* «Создан на основе» (этап 7, A11): основа и то, что из неё не перенесено, — по этому списку автор доводит документ. *@
    @if (details.BasedOn is { } basis)
    {
        <div class="alert alert-secondary py-2" role="status">
            Создан на основе документа
            @if (basis.CanOpen)
            {
                <a href="@($"documents/{basis.Id}")">«@basis.Title»</a>
            }
            else
            {
                <span>«@basis.Title»</span>
            }
            <span class="text-muted">(@(basis.StatusTitle?.ToLowerInvariant() ?? "удалён"))</span>.
            @if (basis.NotTransferred.Count == 0)
            {
                <div class="small">Всё, что вводил автор основы, перенесено.</div>
            }
            else
            {
                <details open="@(d.Status is "draft" or "saved_draft" or "returned")" class="mt-1">
                    <summary>Не перенесено: @basis.NotTransferred.Count</summary>
                    <ul class="small mb-0">
                        @foreach (var line in basis.NotTransferred)
                        {
                            <li>@line</li>
                        }
                    </ul>
                </details>
            }
        </div>
    }

    @* ФОС и РПД (этап 7, B3; FR-DOC-19). У ФОС — связанная РПД (автор ФОС читает её, не правя) и пометка «РПД изменилась» с
       кнопкой «Обновить из РПД»: наследуемое от РПД — снимок. *@
    @if (details.LinkedRpd is { } rpd)
    {
        <div class="alert @(rpd.Changed ? "alert-warning" : "alert-secondary") py-2" role="status">
            Создан по РПД
            @if (rpd.CanOpen)
            {
                <a href="@($"documents/{rpd.Id}")">«@(rpd.Title ?? "РПД")»</a>
            }
            else
            {
                <span>«@(rpd.Title ?? "РПД")»</span>
            }
            <span class="text-muted">(@rpd.StatusTitle.ToLowerInvariant())</span>.
            @if (rpd.Deleted)
            {
                <div class="small">РПД удалена: в ФОС остались данные последнего снимка, обновлять их не из чего.</div>
            }
            else
            {
                <div class="small text-muted">
                    Данные РПД в ФОС — снимок@(rpd.SnapshotAt is { } snapshotAt ? $" от {snapshotAt.ToLocalTime():dd.MM.yyyy HH:mm}" : "")
                    (версия РПД @rpd.SnapshotVersion@(rpd.CurrentVersion is { } current ? $", сейчас {current}" : "")).
                </div>
            }
            @if (rpd.Changed)
            {
                <div class="mt-1">
                    <span class="badge text-bg-warning" title="Индикаторы, разделы, формы текущего контроля или виды аттестации РПД отличаются от снимка в этом ФОС">РПД изменилась</span>
                    @if (details.Actions.RefreshFromRpd)
                    {
                        <button class="btn btn-sm btn-warning ms-2" disabled="@(busy || conflict)" @onclick="RefreshFromRpdAsync">Обновить из РПД</button>
                    }
                    else
                    {
                        <span class="small ms-1">Обновляет данные автор ФОС, пока документ в работе, или методист на проверке.</span>
                    }
                </div>
            }
        </div>
    }
    @* Сквозная проверка РПД ↔ ФОС (этап 7, B8; FR-VAL-04, FR-VAL-07, FR-VAL-09, FR-VAL-10): замечания правил ФОС к РПД как она
       есть сейчас. Предупреждения отправку и приём не блокируют — решает методист; ошибка — РПД ещё не на проверке. *@
    @if (details.LinkedRpd is { CrossCheck: true })
    {
        var crossIssues = CrossCheckIssues();
        var crossWarnings = crossIssues.Count(i => i.IsWarning);
        var crossErrors = crossIssues.Count - crossWarnings;
        @if (crossIssues.Count == 0)
        {
            <div class="alert alert-success py-2 small" role="status">Сквозная проверка РПД ↔ ФОС: расхождений нет.</div>
        }
        else
        {
            <details class="alert @(crossErrors > 0 ? "alert-danger" : "alert-warning") py-2" open>
                <summary class="fw-semibold">
                    Сквозная проверка РПД ↔ ФОС: расхождений @crossWarnings@(crossErrors > 0 ? ", блокирует отправку: 1" : "")
                </summary>
                <div class="small text-muted mb-1">Предупреждения не блокируют отправку и приём: решает методист. РПД от ФОС не зависит.</div>
                @foreach (var group in crossIssues.GroupBy(i => i.Rule).OrderBy(g => g.Any(i => !i.IsWarning) ? 0 : 1))
                {
                    <div class="fw-semibold small mt-2">@CrossRuleTitle(group.Key)</div>
                    <ul class="mb-0 small">
                        @foreach (var issue in group)
                        {
                            <li>
                                @if (!issue.IsWarning)
                                {
                                    <span class="badge text-bg-danger me-1">ошибка</span>
                                }
                                @issue.Message
                                <a href="" class="ms-1" @onclick="() => GoToAsync(issue.Path)" @onclick:preventDefault>→ @SectionTitleOf(issue.Path)</a>
                            </li>
                        }
                    </ul>
                }
            </details>
        }
    }
    @if (details.LinkedFos is { Count: > 0 } fosList)
    {
        <div class="alert alert-secondary py-2" role="status">
            ФОС по этой РПД:
            @foreach (var fos in fosList)
            {
                <div>
                    @if (fos.CanOpen)
                    {
                        <a href="@($"documents/{fos.Id}")">«@fos.Title»</a>
                    }
                    else
                    {
                        <span>«@fos.Title»</span>
                    }
                    <span class="text-muted">· @fos.StatusTitle.ToLowerInvariant() · @fos.AuthorName</span>
                    @if (fos.Discrepancies is { } discrepancies)
                    {
                        <span class="badge @(discrepancies > 0 ? "text-bg-warning" : "text-bg-light border") ms-1"
                              title="Предупреждения сквозной проверки РПД ↔ ФОС; подробности — в самом ФОС">расхождений: @discrepancies</span>
                    }
                </div>
            }
        </div>
    }

    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        @if (details.Editable)
        {
            <button class="btn btn-primary" disabled="@(busy || conflict)" @onclick="() => SaveDocumentAsync(false)">Сохранить</button>
            <button class="btn btn-outline-primary" disabled="@(busy || conflict)" @onclick="() => SaveDocumentAsync(true)">Сохранить и выйти</button>
        }
        @if (details.Actions.Submit)
        {
            <button class="btn btn-success" disabled="@(busy || conflict)" @onclick="SubmitAsync">
                @(d.Status == "returned" ? "Отправить на проверку повторно" : "Отправить на проверку")
            </button>
        }
        @if (details.Actions.Review)
        {
            <button class="btn btn-success" disabled="@(busy || conflict)" @onclick="AcceptAsync">Принять</button>
            <button class="btn btn-warning" disabled="@(busy || conflict)" @onclick="() => returning = !returning">Вернуть на доработку</button>
        }
        @if (details.Actions.Delete)
        {
            <button class="btn btn-outline-danger" disabled="@busy" @onclick="DeleteAsync">Удалить</button>
        }
        @if (details.Actions.TakeForReview)
        {
            <button class="btn btn-outline-success" disabled="@busy" @onclick="() => taking = !taking">Взять на проверку</button>
        }
        @if (details.Actions.ReturnForCorrection)
        {
            <button class="btn btn-outline-warning" disabled="@busy" @onclick="() => correcting = !correcting">Вернуть на исправление</button>
        }
        @if (details.Actions.ForceTargets is { Count: > 0 })
        {
            <button class="btn btn-outline-danger" disabled="@busy" @onclick="() => forcing = !forcing">Сменить статус</button>
        }
        @if (details.Actions.Archive)
        {
            <button class="btn btn-outline-secondary" disabled="@busy" @onclick="ArchiveAsync">В архив</button>
        }
        @if (details.Actions.Transfer)
        {
            <button class="btn btn-outline-primary" disabled="@busy" @onclick="() => transferring = !transferring">Передать документ</button>
        }
        @* «Создать на основе» (этап 7, A11; S-13): выбор шаблона и дисциплины — на экране создания документа, основа уже названа. *@
        @if (details.Actions.CreateBasedOn)
        {
            <a class="btn btn-outline-primary @(busy ? "disabled" : "")" href="@($"documents/new?basedOn={Id}")">Создать на основе</a>
        }
        @* «Создать ФОС» (этап 7, B3; S-11): тип и РПД названы, остаётся выбрать шаблон ФОС плана, если их несколько. *@
        @if (details.Actions.CreateFos)
        {
            <a class="btn btn-outline-primary @(busy ? "disabled" : "")" href="@($"documents/new?type=fos&rpd={Id}")">Создать ФОС</a>
        }
        @if (details.Actions.Approve)
        {
            <button class="btn btn-success" disabled="@busy" @onclick="ApproveAsync">Согласовать</button>
            <button class="btn btn-warning" disabled="@busy" @onclick="() => rejecting = !rejecting">Вернуть на проверку</button>
        }
        @if (details.Editable || details.Actions.CorrectPlan)
        {
            <span class="small @(dirty ? "text-warning" : "text-muted")">
                @if (busy)
                {
                    <span>Сохранение…</span>
                }
                else if (dirty)
                {
                    <span>Есть несохранённые изменения</span>
                }
                else if (savedAt is { } at)
                {
                    <span>Сохранено в @at.ToLocalTime().ToString("HH:mm")</span>
                }
            </span>
        }
    </div>

    @if (details.Actions.Print)
    {
        <PrintPanel DocumentId="Id" BeforePrint="SaveSectionAsync" />
    }

    @* Согласованный документ без электронных мест, вернувшийся на исправление, мест не имеет: панель говорила бы о
       согласовании, которого не было, — остаётся одна плашка ниже. *@
    @if (details.Approval is { } approval && (approval.Seats.Count > 0 || approval.Corrected is null))
    {
        <ApprovalPanel DocumentId="Id" State="approval" Status="@d.Status" Busy="@(busy || conflict)" BeforeAction="SaveSectionAsync"
                       OnStart="StartApprovalAsync" OnChanged="OnApprovalChangedAsync" />
    }

    @if (returning && details.Actions.Review)
    {
        <div class="card mb-3">
            <div class="card-body py-2">
                <div class="small mb-1">
                    Неразрешённых замечаний к полям: <strong>@OpenComments</strong>.
                    @if (OpenComments == 0)
                    {
                        <span class="text-danger">Чтобы вернуть документ, оставьте замечание у поля, которое нужно исправить.</span>
                    }
                </div>
                <textarea class="form-control form-control-sm" rows="2" placeholder="Общий комментарий (необязательно)" @bind="returnComment"></textarea>
                <div class="mt-2 d-flex gap-2">
                    <button class="btn btn-sm btn-warning" disabled="@(busy || OpenComments == 0)" @onclick="ReturnAsync">Вернуть автору</button>
                    <button class="btn btn-sm btn-link" @onclick="() => returning = false">Отмена</button>
                </div>
            </div>
        </div>
    }

    @if (taking && details.Actions.TakeForReview)
    {
        <div class="card mb-3">
            <div class="card-body py-2">
                <div class="small mb-1">
                    Документ перейдёт в «На проверке» без отправки автором. Автор больше не сможет его изменять, пока вы не вернёте документ на доработку.
                </div>
                <textarea class="form-control form-control-sm" rows="2" placeholder="Причина (обязательно): попадёт в историю статусов" @bind="takeReason" @bind:event="oninput"></textarea>
                <div class="mt-2 d-flex gap-2">
                    <button class="btn btn-sm btn-success" disabled="@(busy || string.IsNullOrWhiteSpace(takeReason))" @onclick="TakeAsync">Взять</button>
                    <button class="btn btn-sm btn-link" @onclick="() => taking = false">Отмена</button>
                </div>
            </div>
        </div>
    }

    @* «Вернуть на исправление» (этап 7, A8, решение 2): отмены у возврата нет — согласование придётся пройти заново. *@
    @if (correcting && details.Actions.ReturnForCorrection)
    {
        <div class="card mb-3">
            <div class="card-body py-2">
                <div class="small mb-1">
                    Документ вернётся в «На проверке», время согласования сбросится. Отметки согласующих останутся в журнале аудита;
                    после нового приёма согласование начнётся заново — для всех согласующих. Автор, согласующие и остальные методисты
                    получат уведомление.
                </div>
                <textarea class="form-control form-control-sm" rows="2" placeholder="Причина (обязательно): попадёт в историю статусов и в уведомление"
                          @bind="correctionReason" @bind:event="oninput"></textarea>
                <div class="mt-2 d-flex gap-2">
                    <button class="btn btn-sm btn-warning" disabled="@(busy || string.IsNullOrWhiteSpace(correctionReason))" @onclick="ReturnForCorrectionAsync">Вернуть</button>
                    <button class="btn btn-sm btn-link" @onclick="() => correcting = false">Отмена</button>
                </div>
            </div>
        </div>
    }

    @* «Сменить статус» (этап 7, A8; FR-ADM-04): только назад, для нештатных ситуаций. *@
    @if (forcing && details.Actions.ForceTargets is { Count: > 0 } forceTargets)
    {
        <div class="card mb-3">
            <div class="card-body py-2">
                <div class="small mb-1">
                    Принудительная смена статуса — для нештатных ситуаций, только назад. Переход запишется в историю статусов и журнал
                    аудита, автор и методисты получат уведомление. С согласования круг прерывается — как при возврате.
                </div>
                <select class="form-select form-select-sm mb-2" style="max-width: 320px" aria-label="Новый статус" @bind="forceStatus">
                    <option value="">Новый статус…</option>
                    @foreach (var target in forceTargets)
                    {
                        <option value="@target.Status">@target.Title</option>
                    }
                </select>
                <textarea class="form-control form-control-sm" rows="2" placeholder="Комментарий (обязательно): что произошло"
                          @bind="forceComment" @bind:event="oninput"></textarea>
                <div class="mt-2 d-flex gap-2">
                    <button class="btn btn-sm btn-danger" disabled="@(busy || string.IsNullOrEmpty(forceStatus) || string.IsNullOrWhiteSpace(forceComment))" @onclick="ForceStatusAsync">Сменить статус</button>
                    <button class="btn btn-sm btn-link" @onclick="() => forcing = false">Отмена</button>
                </div>
            </div>
        </div>
    }

    @* «Передать документ» (этап 7, A9; FR-DOC-15): новый автор — преподаватель с действующей учётной записью, причина обязательна. *@
    @if (transferring && details.Actions.Transfer)
    {
        <div class="card mb-3">
            <div class="card-body py-2">
                <div class="small mb-2">
                    Документ перейдёт к другому автору: править его сможет только он, составители в документе не изменятся.
                    Передача запишется в журнал аудита, прежний и новый автор получат уведомление.
                </div>
                <div class="input-group input-group-sm mb-2" style="max-width: 420px">
                    <input class="form-control" placeholder="Фамилия нового автора" aria-label="Фамилия нового автора"
                           @bind="transferSurname" @bind:event="oninput" @onkeydown="OnTransferSearchKeyAsync" />
                    <button class="btn btn-outline-secondary" type="button" disabled="@busy" @onclick="SearchTeachersAsync">Найти</button>
                </div>
                @if (transferCandidates is { Count: 0 })
                {
                    <div class="small text-muted mb-2">Преподавателей с действующей учётной записью и такой фамилией нет.</div>
                }
                else if (transferCandidates is not null)
                {
                    <ul class="list-group mb-2" style="max-width: 720px">
                        @foreach (var candidate in transferCandidates)
                        {
                            <li class="list-group-item py-1 d-flex justify-content-between align-items-center @(candidate.Id == transferTo?.Id ? "list-group-item-primary" : "")">
                                <span>@DescribePerson(candidate)</span>
                                @if (candidate.Id == d.AuthorId)
                                {
                                    <span class="small text-muted">уже автор</span>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => transferTo = candidate">Выбрать</button>
                                }
                            </li>
                        }
                    </ul>
                }
                @if (transferTo is not null)
                {
                    <div class="small mb-2">Новый автор: <strong>@transferTo.ShortName</strong></div>
                }
                <textarea class="form-control form-control-sm" rows="2" placeholder="Причина (обязательно): попадёт в журнал аудита и в уведомления"
                          @bind="transferReason" @bind:event="oninput"></textarea>
                <div class="mt-2 d-flex gap-2">
                    <button class="btn btn-sm btn-primary" disabled="@(busy || transferTo is null || string.IsNullOrWhiteSpace(transferReason))" @onclick="TransferAsync">Передать</button>
                    <button class="btn btn-sm btn-link" @onclick="() => transferring = false">Отмена</button>
                </div>
            </div>
        </div>
    }

    @if (rejecting && details.Actions.Approve)
    {
        <div class="card mb-3">
            <div class="card-body py-2">
                <div class="small mb-1">
                    Документ вернётся методисту в «На проверке». После нового приёма согласование начнётся заново — для всех согласующих.
                    @if (MyOpenComments > 0)
                    {
                        <span>Ваши замечания к полям (@MyOpenComments) методист увидит у полей.</span>
                    }
                    else
                    {
                        <span>Чтобы указать место, оставьте замечание у поля.</span>
                    }
                </div>
                <textarea class="form-control form-control-sm" rows="2" placeholder="Комментарий (обязательно): его увидит методист"
                          @bind="rejectComment" @bind:event="oninput"></textarea>
                <div class="mt-2 d-flex gap-2">
                    <button class="btn btn-sm btn-warning" disabled="@(busy || string.IsNullOrWhiteSpace(rejectComment))" @onclick="RejectAsync">Вернуть</button>
                    <button class="btn btn-sm btn-link" @onclick="() => rejecting = false">Отмена</button>
                </div>
            </div>
        </div>
    }

    @* Возврат с согласования (UC-09) — не замечание к полю: методист решает сам, исправить или вернуть автору. *@
    @if (details.Approval?.Returned is { } back)
    {
        <div class="alert alert-warning py-2">
            <div class="fw-semibold">Возвращён с согласования</div>
            <div>@back.By, @back.At.ToLocalTime().ToString("dd.MM.yyyy HH:mm"): @back.Comment</div>
            @* Подсказка — пока документ у методиста: на доработке решение уже принято. *@
            @if (details.Actions.Review)
            {
                <div class="small mt-1">
                    @if (OpenApprovalComments > 0)
                    {
                        <span>Замечаний согласующих у полей: @OpenApprovalComments. Исправьте документ и снимите их сами или верните документ автору — тогда их снимет он.</span>
                    }
                    else
                    {
                        <span>Исправьте документ сами или оставьте замечание к полю и верните его автору.</span>
                    }
                    Новый приём начнёт согласование заново.
                </div>
            }
        </div>
    }

    @* Возврат согласованного документа на исправление (этап 7, A8) — методисту и администратору: кто, когда, причина. *@
    @if (details.Approval?.Corrected is { } corrected)
    {
        <div class="alert alert-warning py-2">
            <div class="fw-semibold">Возвращён на исправление</div>
            <div>@corrected.By, @corrected.At.ToLocalTime().ToString("dd.MM.yyyy HH:mm"): @corrected.Comment</div>
            @if (details.Actions.Review)
            {
                <div class="small mt-1">Исправьте документ сами или оставьте замечание к полю и верните его автору. Новый приём начнёт согласование заново.</div>
            }
        </div>
    }

    @if (!details.Editable)
    {
        <div class="alert alert-secondary py-2">
            @ReadOnlyReason(d.Status)
            @if (details.Actions.ReturnForCorrection)
            {
                <span>Чтобы исправить документ, верните его на исправление — согласование придётся пройти заново.</span>
            }
            @if (details.Actions.CorrectPlan)
            {
                <span>Исправить можно поля из учебного плана — изменения сохраняются автоматически и записываются в историю.</span>
            }
        </div>
    }

    @if (details.PlanCorrections is { Count: > 0 } corrections)
    {
        <details class="card mb-3">
            <summary class="card-body py-2 small fw-semibold">Исправления полей из учебного плана: @corrections.Count</summary>
            <ul class="small mb-2">
                @foreach (var c in corrections.AsEnumerable().Reverse())
                {
                    <li>
                        @c.ChangedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm"), @(c.ChangedBy ?? "—"):
                        <a href="" @onclick="() => GoToAsync(c.Path)" @onclick:preventDefault>@PlaceTitle(c.Path)</a> —
                        было @SchemaContext.PlanText(Node(c.Before)), стало @SchemaContext.PlanText(Node(c.After))
                    </li>
                }
            </ul>
        </details>
    }

    @if (comments.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-body py-2 small">
                <div class="fw-semibold mb-1">Замечания к полям: неразрешённых @OpenComments из @comments.Count</div>
                <ul class="mb-0">
                    @foreach (var c in comments)
                    {
                        <li class="@(c.IsResolved ? "text-muted" : "")">
                            <a href="" @onclick="() => GoToAsync(c.FieldPath)" @onclick:preventDefault>@PlaceTitle(c.FieldPath)</a>:
                            @c.Text
                            <span class="text-muted">— @c.AuthorName@(c.FromApproval ? ", согласующий" : "")</span>
                            @if (c.IsResolved)
                            {
                                <span class="badge text-bg-success ms-1">разрешено@(c.ResolvedByName is { } by ? $" — {by}" : "")</span>
                            }
                        </li>
                    }
                </ul>
            </div>
        </div>
    }

    @if (conflict)
    {
        <div class="alert alert-warning">
            <div class="fw-semibold">@(conflictTitle ?? "Документ изменён в другой сессии.")</div>
            <div>Введённое осталось на экране, автосохранение остановлено. Перезагрузите документ или скопируйте свой текст,
                чтобы вставить его после перезагрузки.</div>
            <div class="mt-2 d-flex gap-2">
                <button class="btn btn-sm btn-warning" @onclick="ReloadAsync">Перезагрузить документ</button>
                <button class="btn btn-sm btn-outline-dark" @onclick="CopyMineAsync">Скопировать мой текст</button>
            </div>
            @if (copied is not null)
            {
                <textarea class="form-control form-control-sm mt-2" rows="6" readonly>@copied</textarea>
            }
        </div>
    }

    @if (message is not null)
    {
        <div class="alert @(messageIsError ? "alert-danger" : "alert-info") py-2">
            @message
            @if (fieldErrors.Count > 0)
            {
                <ul class="mb-0 mt-1">
                    @foreach (var e in fieldErrors)
                    {
                        <li>
                            @if (e.IsWarning)
                            {
                                <span class="badge text-bg-warning me-1">предупреждение</span>
                            }
                            <a href="" class="alert-link fw-normal" @onclick="() => GoToAsync(e.Path)" @onclick:preventDefault>@PlaceTitle(e.Path)</a>:
                            @e.Message
                        </li>
                    }
                </ul>
            }
        </div>
    }

    <div class="row">
        <nav class="col-md-3 mb-3">
            <div class="list-group small">
                @foreach (var s in sections)
                {
                    <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-start @(s.Key == current ? "active" : "")"
                            @onclick="() => SelectSectionAsync(s.Key)">
                        <span class="@(s.Visible ? "" : "text-muted")">@s.Title</span>
                        <span class="ms-2 text-nowrap">
                            @if (OpenCommentsIn(s.Key) is > 0 and var open)
                            {
                                <span class="badge text-bg-warning me-1" title="Неразрешённые замечания">💬 @open</span>
                            }
                            @* Круг по палитре и число недостающего рядом: цвет — не единственный признак. *@
                            <span title="@FillTitle(s)" class="d-inline-flex align-items-center gap-1">
                                @if (s.Fill is SectionFills.Incomplete or SectionFills.Empty)
                                {
                                    <span>@s.Missing.Count</span>
                                }
                                <span class="fill-dot fill-@s.Fill" role="img" aria-label="@FillTitle(s)"></span>
                            </span>
                        </span>
                    </button>
                }
            </div>
            <ul class="list-unstyled small text-muted mt-2 mb-0">
                <li><span class="fill-dot fill-complete me-1"></span>выполнено всё обязательное</li>
                <li><span class="fill-dot fill-incomplete me-1"></span>выполнено частично (число — сколько не хватает)</li>
                <li><span class="fill-dot fill-empty me-1"></span>не выполнено ни одного</li>
                <li><span class="fill-dot fill-not_applicable me-1"></span>обязательного нет или раздел не предусмотрен</li>
            </ul>
        </nav>

        <section class="col-md-9">
            @if (Current is { } section)
            {
                <h2 class="h4">@section.Title</h2>
                @if (!section.Visible)
                {
                    <div class="alert alert-secondary">
                        Раздел не предусмотрен учебным планом дисциплины. В документе будет стандартная формулировка:
                        <em>@section.StubText</em>
                    </div>
                }
                else
                {
                    @if (section.Missing.Count > 0)
                    {
                        <div class="alert alert-light border small py-2">
                            Для отправки на проверку не хватает:
                            <ul class="mb-0">
                                @foreach (var m in section.Missing)
                                {
                                    <li>@context.FieldTitle(m.Path): @m.Message</li>
                                }
                            </ul>
                        </div>
                    }
                    @if (section.Warnings.Count > 0)
                    {
                        <div class="alert alert-warning small py-2">
                            Предупреждения (отправку не блокируют):
                            <ul class="mb-0">
                                @foreach (var w in section.Warnings)
                                {
                                    <li>@context.FieldTitle(w.Path): @w.Message</li>
                                }
                            </ul>
                        </div>
                    }
                    <SchemaField @key="section.Key" Context="context" Schema="SectionSchema(section.Key)" Parent="payload!" Key="@section.Key"
                                 Path="@($"/{section.Key}")" Label="" />
                }
            }
        </section>
    </div>
}

@code {
    private ConfirmDialog confirm = default!;
    // Автосохранение — раз в 4 минуты (задание: 3–5) и при уходе из раздела.
    private static readonly TimeSpan AutoSaveInterval = TimeSpan.FromMinutes(4);

    [Parameter] public Guid Id { get; set; }

    private DocumentDetails? details;
    private JsonObject? payload;
    private SchemaContext? context;
    private List<SectionState> sections = [];
    private string? current;
    private int version;
    private string statusTitle = "";
    private bool dirty;
    // Счётчик правок: сохранение снимает признак, только если за время запроса не было новых.
    private int edits;
    private bool busy;
    private bool conflict;
    private DateTimeOffset? savedAt;
    private string? message;
    private bool messageIsError;
    private List<FieldError> fieldErrors = [];
    private string? copied;
    private Timer? timer;
    private List<CommentItem> comments = [];
    private bool returning;
    private string? returnComment;
    private bool taking;
    private string? takeReason;
    private bool rejecting;
    private string? rejectComment;
    // Возврат согласованного документа на исправление и принудительная смена статуса (этап 7, A8).
    private bool correcting;
    private string? correctionReason;
    private bool forcing;
    private string? forceStatus;
    private string? forceComment;
    // Передача документа другому автору (этап 7, A9): поиск по фамилии среди преподавателей, выбранный и причина.
    private bool transferring;
    private string transferSurname = "";
    private List<DirectoryPerson>? transferCandidates;
    private DirectoryPerson? transferTo;
    private string? transferReason;
    // Заголовок плашки конфликта: документ взял на проверку методист (этап 6, A1) — иначе «изменён в другой сессии».
    private string? conflictTitle;
    private const string TakenByReviewer = "Документ взят на проверку методистом";
    private string? scrollTo;

    private int OpenComments => comments.Count(c => !c.IsResolved);

    // Свои неснятые замечания согласующего: с ними «Согласовать» недоступно (этап 7, A2).
    private int MyOpenComments => comments.Count(c => !c.IsResolved && c.AuthorId == details?.ViewerId);

    // Неснятые замечания согласующих — у методиста после возврата с согласования.
    private int OpenApprovalComments => comments.Count(c => !c.IsResolved && c.FromApproval);

    private int OpenCommentsIn(string section) =>
        comments.Count(c => !c.IsResolved && c.FieldPath.TrimStart('/').Split('/')[0] == section);

    private SectionState? Current => sections.FirstOrDefault(s => s.Key == current);

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    protected override void OnInitialized() =>
        timer = new Timer(_ => InvokeAsync(AutoSaveAsync), null, AutoSaveInterval, AutoSaveInterval);

    private async Task LoadAsync()
    {
        try
        {
            var response = await Http.GetAsync($"api/documents/{Id}");
            if (!response.IsSuccessStatusCode)
            {
                details = null;
                message = await ProblemTextAsync(response, "Документ не открылся");
                return;
            }
            details = (await response.Content.ReadFromJsonAsync<DocumentDetails>())!;
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
            return;
        }

        payload = JsonNode.Parse(details.Payload.GetRawText())!.AsObject();
        comments = await Http.GetFromJsonAsync<List<CommentItem>>($"api/documents/{Id}/comments") ?? [];
        context = new SchemaContext(details.Schema, payload, details.Metadata, OnChanged, OnEdited)
        {
            DocumentId = Id, Locked = !details.Editable, Comments = comments, CanComment = details.Actions.Comment,
            CanResolve = details.Actions.ResolveComments, CanResolveOwn = details.Actions.ResolveOwnComments,
            CanResolveApproval = details.Actions.ResolveApprovalComments,
            ViewerId = details.ViewerId, AddComment = AddCommentAsync, ResolveComment = ResolveCommentAsync,
            RenumberBank = details.Editable ? RenumberBankAsync : null,
            SuggestMeans = details.Editable ? SuggestMeansAsync : null,
            Defaults = details.TemplateDefaults is { } defaults ? JsonNode.Parse(defaults.GetRawText()) as JsonObject : null,
            CorrectPlan = details.Actions.CorrectPlan, Corrections = details.PlanCorrections ?? [],
            PlanFieldChanged = () => _ = InvokeAsync(SavePlanCorrectionAsync),
            SectionCheckRequested = () => _ = InvokeAsync(CheckSectionAsync)
        };
        sections = details.Metadata.Sections.ToList();
        version = details.Document.Version;
        statusTitle = details.Document.StatusTitle;
        current = sections.Any(s => s.Key == current) ? current : sections.FirstOrDefault(s => s.Visible)?.Key;
        (dirty, conflict, copied, fieldErrors, returning, returnComment) = (false, false, null, [], false, null);
        (taking, takeReason, conflictTitle) = (false, null, null);
        (rejecting, rejectComment) = (false, null);
        (correcting, correctionReason, forcing, forceStatus, forceComment) = (false, null, false, null, null);
        (transferring, transferSurname, transferCandidates, transferTo, transferReason) = (false, "", null, null, null);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (scrollTo is not { } path) return;
        scrollTo = null;
        // Само поле или ближайший нарисованный предок: поля внутри виджета своего id не имеют.
        var segments = path.TrimStart('/').Split('/');
        var ids = Enumerable.Range(1, segments.Length).Reverse()
            .Select(n => SchemaContext.Anchor("/" + string.Join('/', segments.Take(n)))).ToArray();
        await JS.InvokeVoidAsync("rpdfosScrollToField", (object)ids);
    }

    // Переход к полю из списка замечаний или ошибок: открыть его раздел (с сохранением текущего) и прокрутить к полю.
    private async Task GoToAsync(string path)
    {
        var section = path.TrimStart('/').Split('/')[0];
        if (section != current) await SelectSectionAsync(section);
        if (section == current) scrollTo = path;
    }

    // Замечания правил ФОС по всем видимым разделам: ошибка отправки («РПД ещё не на проверке») и предупреждения. В ФОС правила
    // с именем — только сквозные, поэтому «есть имя правила» и значит «сквозная проверка».
    private List<FieldError> CrossCheckIssues() =>
        sections.Where(s => s.Visible).SelectMany(s => s.Missing.Concat(s.Warnings)).Where(i => i.Rule is not null).ToList();

    private static string CrossRuleTitle(string? rule) => rule switch
    {
        "linked_rpd_must_be_approved_or_under_review" => "Статус связанной РПД",
        "all_indicators_have_means" => "У каждого индикатора РПД есть оценочное средство",
        "fos_passport_consistent" => "Паспорт ФОС согласован с банком заданий и РПД",
        "scale_matches_control_type" => "Аттестация и шкала соответствуют виду аттестации РПД",
        "control_forms_match" => "Формы текущего контроля РПД есть в ФОС",
        "fos_regulation_thresholds" => "Пороги Положения о ФОС",
        _ => rule ?? ""
    };

    private string SectionTitleOf(string path)
    {
        var section = path.TrimStart('/').Split('/')[0];
        return sections.FirstOrDefault(s => s.Key == section)?.Title ?? section;
    }

    private string PlaceTitle(string path)
    {
        var section = path.TrimStart('/').Split('/')[0];
        var title = sections.FirstOrDefault(s => s.Key == section)?.Title ?? section;
        return path.Trim('/').Contains('/') ? $"{title} → {context!.FieldTitle(path)}" : title;
    }

    private static JsonNode? Node(JsonElement? value) => value is { } v ? JsonNode.Parse(v.GetRawText()) : null;

    private static string ReadOnlyReason(string status) => status switch
    {
        "under_review" => "Документ на проверке у методиста — изменить его можно после возврата на доработку.",
        "accepted" => "Документ принят методистом: правки закрыты.",
        "approval" => "Документ на согласовании: изменить его нельзя. Согласующий может вернуть документ методисту.",
        "approved" => "Документ согласован: правки закрыты.",
        "archived" => "Документ в архиве: он открыт только для чтения.",
        "returned" => "Документ на доработке у автора.",
        _ => "Документ открыт только для просмотра: изменяет его автор, пока документ в работе."
    };

    /// <summary>Отправка: сначала сохраняется открытый раздел; ошибки полной проверки — списком со ссылками на поля.</summary>
    private async Task SubmitAsync()
    {
        if (!await SaveSectionAsync()) return;
        var done = await ChangeStatusAsync("submit", new { version }, "Документ отправлен на проверку.");
        if (done is { Warnings.Count: > 0 })
            (message, fieldErrors) = ("Документ отправлен на проверку. Предупреждения — отправку не блокируют:", done.Warnings);
    }

    private async Task AcceptAsync()
    {
        // Приём запускает согласование (UC-07): отзыва нет, поэтому — подтверждение (этап 6, A3).
        // У ФОС в окне — число предупреждений сквозной проверки (этап 7, B8): приём они не блокируют.
        var cross = details!.LinkedRpd is null ? 0 : CrossCheckIssues().Count(i => i.IsWarning);
        // Текст — по тому, найдены ли подписанты всех мест (этап 8, A1).
        var question = AcceptConfirmation.Question(details.AcceptUnassigned, cross);
        if (!await confirm.AskAsync(question, "Принять документ")) return;
        if (!await SaveSectionAsync()) return;
        await ChangeStatusAsync("accept", new { version }, "Документ принят.", r => ApprovalStartText(r, "Документ принят. "));
    }

    // «Запустить согласование» принятого документа после ручного назначения подписантов (этап 6, B2). Отзыва нет —
    // то же подтверждение, что перед приёмом.
    private async Task StartApprovalAsync()
    {
        if (!await confirm.AskAsync("Вы отправляете документ на согласование. Уверены?", "Запуск согласования")) return;
        if (!await SaveSectionAsync()) return;
        await ChangeStatusAsync("approval/start", new { version }, "Документ отправлен на согласование.", r => ApprovalStartText(r, ""));
    }

    // Приём сам запускает согласование (UC-07); не нашлись подписанты — документ остаётся «Принят». Тогда сообщения нет:
    // об этом, с названными местами, говорит панель «Согласование», а плашка статуса — только о закрытых правках (этап 8, A1).
    private static string ApprovalStartText(DocumentReviewed r, string prefix) => r.Status switch
    {
        "approval" => $"{prefix}Документ отправлен на согласование.",
        "approved" => $"{prefix}Документ согласован: электронных согласующих в шаблоне нет.",
        _ => ""
    };

    // «Согласовать» (UC-08): отметку не отозвать — с подтверждением. Отметили все — документ «Согласован». Свои
    // неснятые замечания — несогласие: сервер откажет, спрашивать не о чем (этап 7, A2).
    private async Task ApproveAsync()
    {
        if (MyOpenComments > 0)
        {
            (messageIsError, message, fieldErrors) = (true, $"Есть ваши замечания: {MyOpenComments}. Снимите свои замечания или верните документ.", []);
            return;
        }
        if (!await confirm.AskAsync($"Согласовать документ «{details!.Document.DisciplineName}»?", "Согласование")) return;
        await ChangeStatusAsync("approval/approve", new { }, "Согласие отмечено.", r => r.Status == "approved"
            ? "Согласие отмечено. Документ согласован всеми согласующими."
            : "Согласие отмечено. Документ ждёт остальных согласующих.");
    }

    // «Вернуть на проверку» (UC-09): комментарий обязателен, документ уходит методисту.
    private async Task RejectAsync() =>
        await ChangeStatusAsync("approval/reject", new { comment = rejectComment }, "Документ возвращён методисту на проверку.");

    // Подписант назначен в панели «Согласование»: версия и доступные действия изменились — документ перечитывается.
    private async Task OnApprovalChangedAsync(string text)
    {
        await LoadAsync();
        (messageIsError, message) = (false, text);
    }

    // Удаление своего черновика (этап 6, A5): несохранённое не сохраняем — документ удаляется целиком.
    private async Task DeleteAsync()
    {
        if (!await confirm.AskAsync($"Удалить черновик «{details!.Document.DisciplineName}»?", "Удаление черновика", danger: true)) return;
        busy = true;
        try
        {
            var response = await Http.DeleteAsync($"api/documents/{Id}?version={version}");
            if (response.IsSuccessStatusCode)
            {
                // Документа больше нет: до перехода страница перерисуется ещё раз, и панель печати не должна
                // запрашивать задачи удалённого документа (404).
                (dirty, details, context) = (false, null, null);
                Navigation.NavigateTo("documents");
                return;
            }
            var problem = await ReadProblemAsync(response);
            if (IsConflict(response, problem))
            {
                conflict = true;
                return;
            }
            (messageIsError, message, fieldErrors) = (true,
                problem?.Detail is { } detail ? $"{problem.Title}. {detail}" : problem?.Title ?? $"Черновик не удалён (код ответа {(int)response.StatusCode}).", []);
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
        }
        finally
        {
            busy = false;
        }
    }

    private async Task TakeAsync() =>
        await ChangeStatusAsync("take", new { version, reason = takeReason }, "Документ взят на проверку.");

    // «Вернуть на исправление» (этап 7, A8): согласованный документ уходит методисту на проверку, отметки согласующих
    // сбрасываются. Отзыва нет — с подтверждением.
    private async Task ReturnForCorrectionAsync()
    {
        if (!await confirm.AskAsync("Согласование документа будет отменено, его придётся пройти заново. Вернуть документ на исправление?",
                "Возврат на исправление")) return;
        await ChangeStatusAsync("return-for-correction", new { version, reason = correctionReason },
            "Документ возвращён на исправление: он снова на проверке.");
    }

    // «Сменить статус» администратором (этап 7, A8; FR-ADM-04): только назад, комментарий обязателен.
    private async Task ForceStatusAsync()
    {
        var title = details!.Actions.ForceTargets?.FirstOrDefault(t => t.Status == forceStatus)?.Title;
        if (title is null) return;
        if (!await confirm.AskAsync($"Перевести документ в статус «{title}»? Переход запишется в историю статусов и журнал аудита.",
                "Принудительная смена статуса", danger: true)) return;
        await ChangeStatusAsync("force-status", new { version, status = forceStatus, comment = forceComment },
            $"Статус изменён принудительно: «{title}».");
    }

    // «В архив» (этап 7, A9, решение 3): только явно и только согласованный документ. Из архива его вернёт лишь администратор
    // принудительной сменой статуса (A8), поэтому — с подтверждением.
    private async Task ArchiveAsync()
    {
        if (!await confirm.AskAsync($"Отправить документ «{details!.Document.DisciplineName}» в архив? Он станет доступен только для чтения, " +
                "а по дисциплине можно будет создать новый документ. " +
                (details.Document.Type == "rpd" ? "Согласованные ФОС этой РПД уйдут в архив вместе с ней. " : "") +
                "Из архива документ вернёт только администратор.",
                "Отправка в архив")) return;
        await ChangeStatusAsync("archive", new { version }, "Документ отправлен в архив.");
    }

    // «Обновить из РПД» (этап 7, B3, решение 8): сначала сохраняется открытый раздел, затем снимок заменяется нынешними данными
    // РПД. Паспорт и оценочные средства не меняются — ответ называет, что исчезло из РПД и что проверить.
    private async Task RefreshFromRpdAsync()
    {
        if (!await confirm.AskAsync("Данные РПД в ФОС будут заменены нынешними: индикаторы, разделы, формы текущего контроля и виды " +
                "аттестации. Строки паспорта и оценочных средств останутся как есть. Обновить?", "Обновление из РПД")) return;
        if (!await SaveSectionAsync()) return;
        await ChangeStatusAsync("refresh-from-rpd", new { version }, "Данные РПД обновлены.", r => r.Notice ?? "Данные РПД обновлены.");
    }

    // «Перенумеровать» группу банка заданий ФОС (этап 7, B5): сначала сохраняется открытый раздел, затем сервер делает номера
    // сплошными и переписывает ссылки паспорта; документ перечитывается — виджеты видят новые номера.
    private async Task RenumberBankAsync(string group)
    {
        if (!await confirm.AskAsync($"Задания группы «{group}» получат номера подряд с 1, пропуски исчезнут. Ссылки паспорта на эти " +
                "задания будут переписаны. Перенумеровать?", "Перенумерация группы")) return;
        try
        {
            if (!await SaveSectionAsync()) return;
            await ChangeStatusAsync("renumber-bank", new { version, group }, "Задания перенумерованы.", r => r.Notice ?? "Задания перенумерованы.");
        }
        finally
        {
            // Вызов пришёл из виджета банка, а не из обработчика самой страницы: сама она после него не перерисовывается. Без этого
            // экран оставался со старыми номерами и пометкой «несохранённые изменения», а правки в нём терялись (точка проверки B7).
            StateHasChanged();
        }
    }

    // «Предложить» оценочные средства ФОС (этап 7, B6): сервер подбирает типовые средства индикаторам без средств, ничего не
    // сохраняя; виджет добавляет строки в форму, и они уйдут на сервер обычным автосохранением.
    private async Task<MeansSuggestionResult?> SuggestMeansAsync(string[] covered)
    {
        try
        {
            var response = await Http.PostAsJsonAsync($"api/documents/{Id}/means-suggestions", new { covered });
            if (response.IsSuccessStatusCode) return await response.Content.ReadFromJsonAsync<MeansSuggestionResult>();
            (messageIsError, message, fieldErrors) = (true, await ProblemTextAsync(response, "Подбор не выполнен"), []);
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
        }
        StateHasChanged();
        return null;
    }

    private Task OnTransferSearchKeyAsync(KeyboardEventArgs e) => e.Key == "Enter" ? SearchTeachersAsync() : Task.CompletedTask;

    // Кандидаты в новые авторы — преподаватели с действующей учётной записью; запись справочника без неё автором не станет.
    private async Task SearchTeachersAsync()
    {
        try
        {
            var response = await Http.GetAsync($"api/directory/teachers?surname={Uri.EscapeDataString(transferSurname.Trim())}");
            if (response.IsSuccessStatusCode)
                transferCandidates = await response.Content.ReadFromJsonAsync<List<DirectoryPerson>>() ?? [];
            else
                (messageIsError, message, fieldErrors) = (true, await ProblemTextAsync(response, "Поиск не выполнен"), []);
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
        }
    }

    // «Передать документ» (этап 7, A9; FR-DOC-15): после передачи править документ будет только новый автор.
    private async Task TransferAsync()
    {
        if (transferTo is not { } next) return;
        if (!await confirm.AskAsync($"Передать документ «{details!.Document.DisciplineName}» автору {next.ShortName}? " +
                "Править его сможет только новый автор; прежний автор документ больше не увидит.", "Передача документа")) return;
        await ChangeStatusAsync("transfer", new { version, employeeId = next.Id, reason = transferReason },
            $"Документ передан: новый автор — {next.ShortName.TrimEnd('.')}.");
    }

    private static string DescribePerson(DirectoryPerson p) =>
        string.Join(", ", new[] { p.ShortName, p.Position, p.Department }.Where(s => !string.IsNullOrEmpty(s)));

    private async Task ReturnAsync()
    {
        if (!await SaveSectionAsync()) return;
        await ChangeStatusAsync("return", new { version, comment = returnComment }, "Документ возвращён автору на доработку.");
    }

    // Смена статуса: при успехе документ перечитывается — права и доступные действия зависят от нового статуса.
    // doneBy — сообщение по итоговому статусу: приём может запустить согласование, а может и не запустить.
    private async Task<DocumentReviewed?> ChangeStatusAsync(string action, object body, string done,
        Func<DocumentReviewed, string>? doneBy = null)
    {
        busy = true;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/documents/{Id}/{action}", body);
            if (response.IsSuccessStatusCode && await response.Content.ReadFromJsonAsync<DocumentReviewed>() is { } reviewed)
            {
                await LoadAsync();
                var text = doneBy?.Invoke(reviewed) ?? done;
                (messageIsError, message) = (false, text.Length > 0 ? text : null);
                return reviewed;
            }

            var problem = await ReadProblemAsync(response);
            if (IsConflict(response, problem))
            {
                conflict = true;
                return null;
            }
            messageIsError = true;
            message = problem?.Detail is { } detail ? $"{problem.Title}. {detail}" : problem?.Title ?? $"Не выполнено (код ответа {(int)response.StatusCode}).";
            fieldErrors = problem?.Errors ?? [];
            return null;
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
            return null;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task<bool> AddCommentAsync(string path, string text)
    {
        try
        {
            var response = await Http.PostAsJsonAsync($"api/documents/{Id}/comments", new { fieldPath = path, text });
            if (response.IsSuccessStatusCode && await response.Content.ReadFromJsonAsync<CommentItem>() is { } comment)
            {
                comments.Add(comment);
                StateHasChanged();
                return true;
            }
            (messageIsError, message, fieldErrors) = (true, await ProblemTextAsync(response, "Замечание не добавлено"), []);
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
        }
        StateHasChanged();
        return false;
    }

    private async Task ResolveCommentAsync(CommentItem comment)
    {
        try
        {
            var response = await Http.PostAsync($"api/documents/{Id}/comments/{comment.Id}/resolve", null);
            if (response.IsSuccessStatusCode && await response.Content.ReadFromJsonAsync<CommentItem>() is { } resolved)
                comments[comments.FindIndex(c => c.Id == comment.Id)] = resolved;
            else
                (messageIsError, message, fieldErrors) = (true, await ProblemTextAsync(response, "Замечание не отмечено"), []);
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
        }
        StateHasChanged();
    }

    private void OnChanged()
    {
        edits++;
        dirty = true;
        StateHasChanged();
    }

    // Ввод без ухода из поля: признак — сразу, по нему NavigationLock спрашивает подтверждение при закрытии вкладки
    // и переходе на другой сайт. Страница перерисовывается только при первой правке, а не на каждую клавишу.
    private void OnEdited()
    {
        edits++;
        if (dirty) return;
        dirty = true;
        StateHasChanged();
    }

    private JsonElement SectionSchema(string key) =>
        context!.Resolve(details!.Schema.GetProperty("properties").GetProperty(key));

    private async Task AutoSaveAsync()
    {
        if (dirty && !conflict && !busy) await SaveSectionAsync();
        StateHasChanged();
    }

    /// <summary>Сохраняет текущий раздел; false — не сохранён (ошибки, конфликт): из раздела не уходим.</summary>
    private async Task<bool> SaveSectionAsync()
    {
        if (!dirty) return true;
        if (conflict || busy || current is null) return false;
        busy = true;
        try
        {
            var at = edits;
            var value = JsonDocument.Parse(payload![current]?.ToJsonString() ?? "null").RootElement;
            var response = await Http.PatchAsJsonAsync($"api/documents/{Id}/sections/{current}", new { version, value });
            var problem = response.IsSuccessStatusCode ? null : await ReadProblemAsync(response);
            // Исправление принятого документа его ломает (этап 5.2): причины — исправляющему, возврат автору — по согласию.
            if (problem is { ConfirmReturn: true })
            {
                var reasons = string.Join("\n", (problem.Errors ?? []).Select(e => $"• {PlaceTitle(e.Path)}: {e.Message}"));
                if (!await confirm.AskAsync(
                        $"После исправления документ не проходит проверку:\n{reasons}\n\nВернуть документ автору на доработку?", "Возврат автору"))
                {
                    // Отказ — значение поля возвращается к прежнему: на сервере исправление не сохранено.
                    await LoadAsync();
                    (messageIsError, message) = (false, "Исправление отменено, значение возвращено к прежнему.");
                    return true;
                }
                response = await Http.PatchAsJsonAsync($"api/documents/{Id}/sections/{current}", new { version, value, confirmReturn = true });
                problem = response.IsSuccessStatusCode ? null : await ReadProblemAsync(response);
            }
            if (response.IsSuccessStatusCode && await response.Content.ReadFromJsonAsync<SectionSaved>() is { } saved)
            {
                // Документ ушёл автору — права и действия по новому статусу: документ перечитывается.
                if (saved.Status != details!.Document.Status)
                {
                    await LoadAsync();
                    (messageIsError, message) = (false, $"Документ возвращён автору на доработку, статус — «{saved.StatusTitle}».");
                    return true;
                }
                version = saved.Version;
                statusTitle = saved.StatusTitle;
                savedAt = saved.SavedAt;
                // Правка одного раздела меняет заполненность и предупреждения других (тематический план сверяется
                // с трудоёмкостью) — сервер присылает все разделы и историю исправлений полей из плана.
                sections = saved.Sections ?? sections.Select(s => s.Key == saved.Section.Key ? saved.Section : s).ToList();
                // Исправление трудоёмкости меняет состав разделов (этап 5.2): появившийся раздел должен получить поля.
                // Поля узнают свои ошибки из Missing раздела — разделы в контексте обновляются при каждом сохранении.
                context!.Metadata = context.Metadata with { Sections = sections, HiddenPaths = saved.HiddenPaths ?? context.Metadata.HiddenPaths };
                // Сервер довёл производное (контактная работа, вид курсового проектирования) — содержимое с его
                // значениями, иначе следующее сохранение вернуло бы прежние. Введённое во время запроса не трогаем.
                if (saved.Payload is { ValueKind: JsonValueKind.Object } server && edits == at)
                    foreach (var p in server.EnumerateObject())
                        payload![p.Name] = JsonNode.Parse(p.Value.GetRawText());
                if (saved.PlanCorrections is { } corrections)
                {
                    details = details! with { PlanCorrections = corrections };
                    context!.Corrections = corrections;
                }
                // Введённое во время запроса в сохранённое значение не попало — признак остаётся.
                (dirty, message, fieldErrors) = (edits != at, null, []);
                return true;
            }

            if (IsConflict(response, problem))
            {
                conflict = true;
                message = null;
                return false;
            }
            messageIsError = true;
            message = problem?.Title ?? $"Раздел не сохранён (код ответа {(int)response.StatusCode}).";
            fieldErrors = problem?.Errors ?? [];
            if (fieldErrors.Count == 0 && problem?.Detail is { } detail) message += ". " + detail;
            return false;
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
            return false;
        }
        finally
        {
            busy = false;
            // Исправление поля из плана пришло во время сохранения — сохраняем его следом.
            if (planSaveQueued)
            {
                planSaveQueued = false;
                _ = InvokeAsync(SavePlanCorrectionAsync);
            }
        }
    }

    private bool planSaveQueued;
    private int checks;

    /// <summary>
    /// Проверка раздела без сохранения при уходе из поля (этап 5.2, B4.1): рамки и индикаторы — по ответу, без новой
    /// версии. Ввод не блокируется; ответ применяется, только если с запроса не было новых правок и новых проверок —
    /// иначе он об устаревшем содержимом.
    /// </summary>
    private async Task CheckSectionAsync()
    {
        if (conflict || current is null || payload is null || details is null || !details.Editable && !details.Actions.CorrectPlan) return;
        var (section, at, seq) = (current, edits, ++checks);
        try
        {
            var value = JsonDocument.Parse(payload[section]?.ToJsonString() ?? "null").RootElement;
            var response = await Http.PostAsJsonAsync($"api/documents/{Id}/sections/{section}/check", new { version, value });
            if (!response.IsSuccessStatusCode || await response.Content.ReadFromJsonAsync<SectionChecked>() is not { } result) return;
            if (seq != checks || at != edits || section != current) return;
            sections = result.Sections;
            context!.Metadata = context.Metadata with { Sections = sections, HiddenPaths = result.HiddenPaths };
            StateHasChanged();
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
        }
    }

    /// <summary>
    /// Исправление поля из плана (методист, администратор) — сразу на сервер: пометка, предупреждение «отличается от
    /// учебного плана», ошибки зависимых разделов и история обновляются без перезагрузки.
    /// </summary>
    private async Task SavePlanCorrectionAsync()
    {
        if (busy)
        {
            planSaveQueued = true;
            return;
        }
        await SaveSectionAsync();
        StateHasChanged();
    }

    private async Task SelectSectionAsync(string key)
    {
        if (key == current) return;
        if (!await SaveSectionAsync()) return;
        current = key;
        (message, fieldErrors) = (null, []);
    }

    private async Task SaveDocumentAsync(bool exit)
    {
        if (!await SaveSectionAsync()) return;
        busy = true;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/documents/{Id}/save", new { version });
            if (response.IsSuccessStatusCode && await response.Content.ReadFromJsonAsync<DocumentSaved>() is { } saved)
            {
                version = saved.Version;
                statusTitle = saved.StatusTitle;
                savedAt = saved.SavedAt;
                (messageIsError, message) = (false, "Документ сохранён.");
                if (exit) Navigation.NavigateTo("documents");
                return;
            }
            var problem = await ReadProblemAsync(response);
            if (IsConflict(response, problem))
            {
                conflict = true;
                return;
            }
            (messageIsError, message) = (true, problem?.Detail ?? problem?.Title ?? $"Документ не сохранён (код ответа {(int)response.StatusCode}).");
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
        }
        finally
        {
            busy = false;
        }
    }

    // Уход со страницы: сначала сохранить раздел; не сохранился — остаёмся, чтобы не потерять введённое.
    private async Task OnBeforeNavigationAsync(LocationChangingContext navigation)
    {
        if (!dirty || conflict) return;
        if (!await SaveSectionAsync()) navigation.PreventNavigation();
    }

    private async Task ReloadAsync()
    {
        dirty = false;
        await LoadAsync();
    }

    // Введённое в разделе — тексты без разметки и числа, каждое с местом в разделе («№ 1 → Лекции: 4»): после
    // перезагрузки по этому списку всё вводится заново. Поля только для чтения (из плана, запись справочника) пропускаются.
    private async Task CopyMineAsync()
    {
        var texts = new List<string>();
        if (current is not null) Collect(payload?[current], SectionSchema(current), $"/{current}");
        copied = string.Join(Environment.NewLine + Environment.NewLine, texts);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", copied);
        }
        catch (JSException)
        {
            // Буфер обмена недоступен — текст остаётся в поле под кнопкой.
        }

        void Collect(JsonNode? node, JsonElement schema, string path)
        {
            if (schema.ValueKind == JsonValueKind.Object && context!.IsReadOnly(path, schema)) return;
            switch (node)
            {
                case JsonValue v when v.TryGetValue(out string? s):
                    if (!string.IsNullOrWhiteSpace(s))
                        Add(path, Regex.Replace(Regex.Replace(s, "</p>|<br ?/?>|</li>", "\n"), "<[^>]*>", "").Trim());
                    break;
                case JsonValue v when v.GetValueKind() == JsonValueKind.Number:
                    Add(path, v.ToString());
                    break;
                case JsonObject o:
                    // Порядок — как в форме (по схеме), а не порядок ввода.
                    var order = schema.ValueKind == JsonValueKind.Object && schema.TryGetProperty("properties", out var props)
                        ? props.EnumerateObject().Select(p => p.Name).ToList() : [];
                    foreach (var (key, value) in o.OrderBy(p => order.IndexOf(p.Key) is var n and >= 0 ? n : int.MaxValue))
                        Collect(value, Property(schema, key), $"{path}/{key}");
                    break;
                case JsonArray a:
                    var items = schema.ValueKind == JsonValueKind.Object && schema.TryGetProperty("items", out var i)
                        ? context!.Resolve(i) : default;
                    for (var k = 0; k < a.Count; k++) Collect(a[k], items, $"{path}/{k}");
                    break;
            }
        }

        JsonElement Property(JsonElement schema, string key) =>
            schema.ValueKind == JsonValueKind.Object && schema.TryGetProperty("properties", out var p) && p.TryGetProperty(key, out var s)
                ? context!.Resolve(s) : default;

        void Add(string path, string text) => texts.Add($"{context!.FieldTitle(path)}: {text}");
    }

    // Подсказка индикатора — то же словами, с числом недостающего.
    private static string FillTitle(SectionState s) => s.Fill switch
    {
        SectionFills.Complete => "Выполнены все обязательные элементы",
        SectionFills.Incomplete => $"Выполнена часть обязательного, не хватает: {s.Missing.Count}",
        SectionFills.Empty => $"Не выполнено ни одного обязательного элемента, не хватает: {s.Missing.Count}",
        _ => s.Visible ? "Обязательных элементов нет" : "Раздел не предусмотрен учебным планом"
    };

    private static async Task<DocumentProblem?> ReadProblemAsync(HttpResponseMessage response)
    {
        try
        {
            return await response.Content.ReadFromJsonAsync<DocumentProblem>();
        }
        catch (JsonException)
        {
            return null;
        }
    }

    private static async Task<string> ProblemTextAsync(HttpResponseMessage response, string fallback) =>
        await ReadProblemAsync(response) is { } p ? p.Detail is null ? p.Title ?? fallback : $"{p.Title}. {p.Detail}"
            : $"{fallback} (код ответа {(int)response.StatusCode}).";

    // Сохранять дальше нельзя: документ изменили в другой сессии или его взял на проверку методист (этап 6, A1).
    // Введённое остаётся на экране, автосохранение останавливается.
    private bool IsConflict(HttpResponseMessage response, DocumentProblem? problem)
    {
        if (response.StatusCode != HttpStatusCode.Conflict || problem?.Title is not ("Конфликт версий" or TakenByReviewer)) return false;
        conflictTitle = problem.Title == TakenByReviewer ? $"{TakenByReviewer}." : null;
        return true;
    }

    public void Dispose() => timer?.Dispose();
}
