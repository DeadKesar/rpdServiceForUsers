@page "/documents/{Id:guid}"
@attribute [Authorize]
@implements IDisposable
@using System.Net
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Nodes
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using RpdFos.Web.Models
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(details?.Document.DisciplineName ?? "Документ")</PageTitle>

<NavigationLock ConfirmExternalNavigation="@dirty" OnBeforeInternalNavigation="OnBeforeNavigationAsync" />

<p><a href="documents">← Мои документы</a></p>

@if (details is null || context is null)
{
    @if (message is not null)
    {
        <div class="alert alert-danger">@message</div>
    }
    else
    {
        <p>Загрузка…</p>
    }
}
else
{
    var d = details.Document;
    <h1 class="h3">@d.DisciplineCode @d.DisciplineName</h1>
    <p class="text-muted">
        @(d.Type == "fos" ? "ФОС" : "РПД") · <strong>@statusTitle</strong> · редакция шаблона @d.TemplateRevision
        @if (d.IsOutdated)
        {
            <span class="badge text-bg-warning ms-1" title="Вышла новая редакция шаблона">устарел</span>
        }
    </p>

    @if (details.Editable)
    {
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <button class="btn btn-primary" disabled="@(busy || conflict)" @onclick="() => SaveDocumentAsync(false)">Сохранить</button>
            <button class="btn btn-outline-primary" disabled="@(busy || conflict)" @onclick="() => SaveDocumentAsync(true)">Сохранить и выйти</button>
            <span class="small @(dirty ? "text-warning" : "text-muted")">
                @if (busy)
                {
                    <span>Сохранение…</span>
                }
                else if (dirty)
                {
                    <span>Есть несохранённые изменения</span>
                }
                else if (savedAt is { } at)
                {
                    <span>Сохранено в @at.ToLocalTime().ToString("HH:mm")</span>
                }
            </span>
        </div>
    }
    else
    {
        <div class="alert alert-secondary py-2">Документ открыт только для просмотра: изменяет его автор, пока документ в работе.</div>
    }

    @if (conflict)
    {
        <div class="alert alert-warning">
            <div class="fw-semibold">Документ изменён в другой сессии.</div>
            <div>Введённое осталось на экране, автосохранение остановлено. Перезагрузите документ или скопируйте свой текст,
                чтобы вставить его после перезагрузки.</div>
            <div class="mt-2 d-flex gap-2">
                <button class="btn btn-sm btn-warning" @onclick="ReloadAsync">Перезагрузить документ</button>
                <button class="btn btn-sm btn-outline-dark" @onclick="CopyMineAsync">Скопировать мой текст</button>
            </div>
            @if (copied is not null)
            {
                <textarea class="form-control form-control-sm mt-2" rows="6" readonly>@copied</textarea>
            }
        </div>
    }

    @if (message is not null)
    {
        <div class="alert @(messageIsError ? "alert-danger" : "alert-info") py-2">
            @message
            @if (fieldErrors.Count > 0)
            {
                <ul class="mb-0 mt-1">
                    @foreach (var e in fieldErrors)
                    {
                        <li>@context.FieldTitle(e.Path): @e.Message</li>
                    }
                </ul>
            }
        </div>
    }

    <div class="row">
        <nav class="col-md-3 mb-3">
            <div class="list-group small">
                @foreach (var s in sections)
                {
                    <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-start @(s.Key == current ? "active" : "")"
                            @onclick="() => SelectSectionAsync(s.Key)">
                        <span class="@(s.Visible ? "" : "text-muted")">@s.Title</span>
                        <span title="@FillTitle(s)" class="ms-2 text-nowrap">@FillMark(s)</span>
                    </button>
                }
            </div>
            <div class="small text-muted mt-2">✓ заполнен · ● не хватает обязательного · — не предусмотрен учебным планом</div>
        </nav>

        <section class="col-md-9">
            @if (Current is { } section)
            {
                <h2 class="h4">@section.Title</h2>
                @if (!section.Visible)
                {
                    <div class="alert alert-secondary">
                        Раздел не предусмотрен учебным планом дисциплины. В документе будет стандартная формулировка:
                        <em>@section.StubText</em>
                    </div>
                }
                else
                {
                    @if (section.Missing.Count > 0)
                    {
                        <div class="alert alert-light border small py-2">
                            Для отправки на проверку не хватает:
                            <ul class="mb-0">
                                @foreach (var m in section.Missing)
                                {
                                    <li>@context.FieldTitle(m.Path): @m.Message</li>
                                }
                            </ul>
                        </div>
                    }
                    <SchemaField @key="section.Key" Context="context" Schema="SectionSchema(section.Key)" Parent="payload!" Key="@section.Key"
                                 Path="@($"/{section.Key}")" Label="" />
                }
            }
        </section>
    </div>
}

@code {
    // Автосохранение — раз в 4 минуты (задание: 3–5) и при уходе из раздела.
    private static readonly TimeSpan AutoSaveInterval = TimeSpan.FromMinutes(4);

    [Parameter] public Guid Id { get; set; }

    private DocumentDetails? details;
    private JsonObject? payload;
    private SchemaContext? context;
    private List<SectionState> sections = [];
    private string? current;
    private int version;
    private string statusTitle = "";
    private bool dirty;
    // Счётчик правок: сохранение снимает признак, только если за время запроса не было новых.
    private int edits;
    private bool busy;
    private bool conflict;
    private DateTimeOffset? savedAt;
    private string? message;
    private bool messageIsError;
    private List<FieldError> fieldErrors = [];
    private string? copied;
    private Timer? timer;

    private SectionState? Current => sections.FirstOrDefault(s => s.Key == current);

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    protected override void OnInitialized() =>
        timer = new Timer(_ => InvokeAsync(AutoSaveAsync), null, AutoSaveInterval, AutoSaveInterval);

    private async Task LoadAsync()
    {
        try
        {
            var response = await Http.GetAsync($"api/documents/{Id}");
            if (!response.IsSuccessStatusCode)
            {
                details = null;
                message = await ProblemTextAsync(response, "Документ не открылся");
                return;
            }
            details = (await response.Content.ReadFromJsonAsync<DocumentDetails>())!;
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
            return;
        }

        payload = JsonNode.Parse(details.Payload.GetRawText())!.AsObject();
        context = new SchemaContext(details.Schema, payload, details.Metadata, OnChanged, OnEdited) { Locked = !details.Editable };
        sections = details.Metadata.Sections.ToList();
        version = details.Document.Version;
        statusTitle = details.Document.StatusTitle;
        current = sections.Any(s => s.Key == current) ? current : sections.FirstOrDefault(s => s.Visible)?.Key;
        (dirty, conflict, copied, fieldErrors) = (false, false, null, []);
    }

    private void OnChanged()
    {
        edits++;
        dirty = true;
        StateHasChanged();
    }

    // Ввод без ухода из поля: признак — сразу, по нему NavigationLock спрашивает подтверждение при закрытии вкладки
    // и переходе на другой сайт. Страница перерисовывается только при первой правке, а не на каждую клавишу.
    private void OnEdited()
    {
        edits++;
        if (dirty) return;
        dirty = true;
        StateHasChanged();
    }

    private JsonElement SectionSchema(string key) =>
        context!.Resolve(details!.Schema.GetProperty("properties").GetProperty(key));

    private async Task AutoSaveAsync()
    {
        if (dirty && !conflict && !busy) await SaveSectionAsync();
        StateHasChanged();
    }

    /// <summary>Сохраняет текущий раздел; false — не сохранён (ошибки, конфликт): из раздела не уходим.</summary>
    private async Task<bool> SaveSectionAsync()
    {
        if (!dirty) return true;
        if (conflict || busy || current is null) return false;
        busy = true;
        try
        {
            var at = edits;
            var value = JsonDocument.Parse(payload![current]?.ToJsonString() ?? "null").RootElement;
            var response = await Http.PatchAsJsonAsync($"api/documents/{Id}/sections/{current}", new { version, value });
            if (response.IsSuccessStatusCode && await response.Content.ReadFromJsonAsync<SectionSaved>() is { } saved)
            {
                version = saved.Version;
                statusTitle = saved.StatusTitle;
                savedAt = saved.SavedAt;
                sections = sections.Select(s => s.Key == saved.Section.Key ? saved.Section : s).ToList();
                // Введённое во время запроса в сохранённое значение не попало — признак остаётся.
                (dirty, message, fieldErrors) = (edits != at, null, []);
                return true;
            }

            var problem = await ReadProblemAsync(response);
            if (response.StatusCode == HttpStatusCode.Conflict && problem?.Title == "Конфликт версий")
            {
                conflict = true;
                message = null;
                return false;
            }
            messageIsError = true;
            message = problem?.Title ?? $"Раздел не сохранён (код ответа {(int)response.StatusCode}).";
            fieldErrors = problem?.Errors ?? [];
            if (fieldErrors.Count == 0 && problem?.Detail is { } detail) message += ". " + detail;
            return false;
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
            return false;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SelectSectionAsync(string key)
    {
        if (key == current) return;
        if (!await SaveSectionAsync()) return;
        current = key;
        (message, fieldErrors) = (null, []);
    }

    private async Task SaveDocumentAsync(bool exit)
    {
        if (!await SaveSectionAsync()) return;
        busy = true;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/documents/{Id}/save", new { version });
            if (response.IsSuccessStatusCode && await response.Content.ReadFromJsonAsync<DocumentSaved>() is { } saved)
            {
                version = saved.Version;
                statusTitle = saved.StatusTitle;
                savedAt = saved.SavedAt;
                (messageIsError, message) = (false, "Документ сохранён.");
                if (exit) Navigation.NavigateTo("documents");
                return;
            }
            var problem = await ReadProblemAsync(response);
            if (response.StatusCode == HttpStatusCode.Conflict && problem?.Title == "Конфликт версий")
            {
                conflict = true;
                return;
            }
            (messageIsError, message) = (true, problem?.Detail ?? problem?.Title ?? $"Документ не сохранён (код ответа {(int)response.StatusCode}).");
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
        }
        finally
        {
            busy = false;
        }
    }

    // Уход со страницы: сначала сохранить раздел; не сохранился — остаёмся, чтобы не потерять введённое.
    private async Task OnBeforeNavigationAsync(LocationChangingContext navigation)
    {
        if (!dirty || conflict) return;
        if (!await SaveSectionAsync()) navigation.PreventNavigation();
    }

    private async Task ReloadAsync()
    {
        dirty = false;
        await LoadAsync();
    }

    // Текст раздела без разметки — чтобы вставить его после перезагрузки.
    private async Task CopyMineAsync()
    {
        var texts = new List<string>();
        Collect(current is null ? null : payload?[current]);
        copied = string.Join(Environment.NewLine + Environment.NewLine, texts);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", copied);
        }
        catch (JSException)
        {
            // Буфер обмена недоступен — текст остаётся в поле под кнопкой.
        }

        void Collect(JsonNode? node)
        {
            switch (node)
            {
                case JsonValue v when v.TryGetValue(out string? s) && !string.IsNullOrWhiteSpace(s):
                    texts.Add(Regex.Replace(Regex.Replace(s, "</p>|<br ?/?>|</li>", "\n"), "<[^>]*>", "").Trim());
                    break;
                case JsonObject o:
                    foreach (var p in o) Collect(p.Value);
                    break;
                case JsonArray a:
                    foreach (var item in a) Collect(item);
                    break;
            }
        }
    }

    private static string FillMark(SectionState s) => s.Fill switch
    {
        SectionFills.Complete => "✓",
        SectionFills.Incomplete => $"● {s.Missing.Count}",
        _ => "—"
    };

    private static string FillTitle(SectionState s) => s.Fill switch
    {
        SectionFills.Complete => "Заполнен",
        SectionFills.Incomplete => "Не хватает обязательного для отправки",
        _ => "Не предусмотрен учебным планом"
    };

    private static async Task<DocumentProblem?> ReadProblemAsync(HttpResponseMessage response)
    {
        try
        {
            return await response.Content.ReadFromJsonAsync<DocumentProblem>();
        }
        catch (JsonException)
        {
            return null;
        }
    }

    private static async Task<string> ProblemTextAsync(HttpResponseMessage response, string fallback) =>
        await ReadProblemAsync(response) is { } p ? p.Detail is null ? p.Title ?? fallback : $"{p.Title}. {p.Detail}"
            : $"{fallback} (код ответа {(int)response.StatusCode}).";

    public void Dispose() => timer?.Dispose();
}
