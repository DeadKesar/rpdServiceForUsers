@page "/documents/new"
@attribute [Authorize(Roles = "teacher,methodist,admin")]
@using System.Net
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using RpdFos.Web.Models
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Создание документа</PageTitle>

<p><a href="documents">← Мои документы</a></p>
<h1>Создание документа</h1>

@if (message is not null)
{
    <div class="alert @(messageIsError ? "alert-danger" : "alert-info")" role="status">
        @message
        @if (existingId is Guid id)
        {
            <a class="ms-1" href="@($"documents/{id}")">Открыть документ</a>
        }
    </div>
}

@* Тип документа (этап 7, B3; S-11): РПД создаётся для дисциплины плана, ФОС — по РПД дисциплины. *@
<div class="mb-3" style="max-width: 960px">
    <label class="form-label d-block">Тип документа</label>
    <div class="btn-group" role="group" aria-label="Тип документа">
        <button type="button" class="btn @(docType == RpdType ? "btn-primary" : "btn-outline-primary")" disabled="@busy"
                aria-pressed="@(docType == RpdType ? "true" : "false")" @onclick="() => SelectTypeAsync(RpdType)">РПД</button>
        <button type="button" class="btn @(docType == FosType ? "btn-primary" : "btn-outline-primary")" disabled="@busy"
                aria-pressed="@(docType == FosType ? "true" : "false")" @onclick="() => SelectTypeAsync(FosType)">ФОС</button>
    </div>
    @if (docType == FosType)
    {
        <div class="form-text">
            ФОС создаётся по РПД дисциплины — не удалённой и не архивной. Создаёт автор РПД или сотрудник, закреплённый за
            дисциплиной. Наследуемое от РПД (индикаторы, разделы, формы текущего контроля, виды аттестации) — снимок: он обновляется
            кнопкой в самом ФОС.
        </div>
    }
</div>

@if (fosRpd is { } source)
{
    <div class="alert alert-secondary py-2" style="max-width: 960px" role="status">
        ФОС создаётся по РПД
        <a href="@($"documents/{source.Id}")"><strong>«@source.Title»</strong></a>
        · @StatusTitle(source.Status) · @source.AuthorName
    </div>
}

@* Основа (этап 7, A11; S-11): ввод автора переносится из неё в новый документ — для той же дисциплины или для дисциплины
   другого плана; поля из учебного плана берутся заново. Основа названа ссылкой «Создать на основе» из согласованного или
   архивного документа либо выбрана здесь. У ФОС основа — прежний ФОС (B10): банк, билеты, средства и шкала переносятся,
   наследуемое берётся из РПД цели. *@
<div class="mb-3" style="max-width: 960px">
    <label class="form-label">Основа</label>
    @if (basis is { } chosen)
    {
        <div class="d-flex flex-wrap align-items-center gap-2">
            <span>
                <a href="@($"documents/{chosen.Id}")"><strong>«@chosen.Title»</strong></a>
                · @chosen.StatusTitle · @chosen.AuthorName
            </span>
            <button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="() => basis = null">Без основы</button>
        </div>
        <div class="form-text">
            Из основы перенесётся то, что вводил автор; поля из учебного плана и справочников возьмутся заново. Не
            перенесённое будет перечислено в новом документе.
        </div>
    }
    else
    {
        <div>
            <button class="btn btn-sm btn-outline-primary" disabled="@busy" @onclick="ToggleChoosingAsync">
                @(choosing ? "Не выбирать основу" : "Создать на основе документа…")
            </button>
        </div>
        @if (choosing)
        {
            <input class="form-control form-control-sm mt-2" placeholder="Поиск по названию, дисциплине или автору"
                   @bind="baseFilter" @bind:event="oninput" />
            <select class="form-select form-select-sm mt-1" size="8" @onchange="PickBase">
                @foreach (var b in FilteredBases)
                {
                    <option value="@b.Id">@b.Title — @b.StatusTitle, @b.AuthorName</option>
                }
            </select>
            @if (!Bases.Any())
            {
                <div class="form-text">Документов, которые можно взять основой, нет: нужны свои @TypeTitle или @TypeTitle закреплённых за вами дисциплин.</div>
            }
        }
    }
</div>

<div class="mb-3" style="max-width: 960px">
    <label class="form-label">Опубликованный шаблон @TypeTitle</label>
    <select class="form-select" @bind="templateId" @bind:after="LoadDisciplinesAsync">
        <option value="">— выберите шаблон —</option>
        @foreach (var t in templates)
        {
            <option value="@t.Id">@t.Name — @(t.Plan?.Title ?? "план не привязан"), редакция @t.Revision</option>
        }
    </select>
    @if (templates.Count == 0)
    {
        <div class="form-text">Опубликованных шаблонов @TypeTitle нет — их публикует методист на странице «Шаблоны».</div>
    }
</div>

@if (disciplines is not null)
{
    <p class="text-muted">
        @if (docType == FosType)
        {
            <span>
                Дисциплины учебного плана, для которых создаётся ФОС. ФОС создаётся по РПД дисциплины: у дисциплины без РПД
                сначала создают РПД.
            </span>
        }
        else
        {
            <span>
                Дисциплины учебного плана, для которых создаётся РПД: модули, группы дисциплин по выбору, практики и ГИА
                в списке не показываются.
            </span>
        }
    </p>
    @* Узкий экран: таблица прокручивается в обёртке, а не рвёт слова по буквам (общее правило — app.css). *@
    <div class="table-responsive">
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>Индекс</th><th>Дисциплина</th>
                @if (docType == FosType)
                {
                    <th>РПД</th>
                }
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Rows)
            {
                <tr>
                    <td>@d.Code</td>
                    <td>
                        @d.Name
                        @* Закрепление дисциплин (этап 7, A10): у дисциплины с закреплениями документы создают закреплённые. *@
                        @if (d.AssignedTo is { } holders)
                        {
                            <div class="small text-muted">Закреплена за: @holders</div>
                        }
                    </td>
                    @* ФОС (этап 7, B3): РПД, по которой он создаётся, — незавершённая дисциплины, иначе новейшая согласованная. *@
                    @if (docType == FosType)
                    {
                        <td class="small">
                            @if (d.RpdId is Guid rpdId)
                            {
                                <a href="@($"documents/{rpdId}")">РПД</a>
                                <span>· @StatusTitle(d.RpdStatus) · @d.RpdAuthor</span>
                            }
                            else
                            {
                                <span class="text-muted">нет</span>
                            }
                        </td>
                    }
                    <td class="text-end">
                        @if (docType == FosType)
                        {
                            @if (d.DocumentId is Guid fosId)
                            {
                                @if (d.CanOpen)
                                {
                                    <a class="btn btn-sm btn-outline-secondary" href="@($"documents/{fosId}")">Открыть ФОС</a>
                                }
                                else
                                {
                                    <span class="small text-muted">ФОС уже есть (автор — @d.DocumentAuthor)</span>
                                }
                                @* Согласованный ФОС занимает дисциплину: новый создаётся только на его основе (этап 7, B10). *@
                                @if (d.DocumentStatus == "approved" && d.CanCreate && d.RpdId is not null)
                                {
                                    @if (basis is null)
                                    {
                                        <div class="small text-muted">Новый ФОС — на основе согласованного</div>
                                    }
                                    else if (BasisRefusal(d) is { } whyNot)
                                    {
                                        <div class="small text-muted">@whyNot</div>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-primary ms-1" disabled="@busy" @onclick="() => CreateAsync(d)">Создать на основе</button>
                                    }
                                }
                            }
                            else if (d.RpdId is null)
                            {
                                <span class="small text-muted">Сначала создайте РПД</span>
                            }
                            else if (d.CanCreate)
                            {
                                @if (BasisRefusal(d) is { } refusalFos)
                                {
                                    <span class="small text-muted">@refusalFos</span>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-primary" disabled="@busy" @onclick="() => CreateAsync(d)">
                                        @(basis is null ? "Создать ФОС" : "Создать на основе")
                                    </button>
                                }
                            }
                            else
                            {
                                <span class="small text-muted">Создают автор РПД и закреплённые преподаватели</span>
                            }
                        }
                        else if (d.DocumentId is Guid documentId)
                        {
                            @if (d.CanOpen)
                            {
                                <a class="btn btn-sm btn-outline-secondary" href="@($"documents/{documentId}")">Открыть документ</a>
                            }
                            else
                            {
                                <span class="small text-muted">РПД уже есть (автор — @d.DocumentAuthor)</span>
                            }
                            @* Согласованный документ занимает дисциплину: новый создаётся только на его основе (этап 7, A11). *@
                            @if (d.DocumentStatus == "approved" && d.CanCreate)
                            {
                                @if (basis is null)
                                {
                                    <div class="small text-muted">Новый РПД — на основе согласованного</div>
                                }
                                else if (BasisRefusal(d) is { } why)
                                {
                                    <div class="small text-muted">@why</div>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-primary ms-1" disabled="@busy" @onclick="() => CreateAsync(d)">Создать на основе</button>
                                }
                            }
                        }
                        else if (d.CanCreate)
                        {
                            @if (BasisRefusal(d) is { } refusal)
                            {
                                <span class="small text-muted">@refusal</span>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-primary" disabled="@busy" @onclick="() => CreateAsync(d)">
                                    @(basis is null ? "Создать РПД" : "Создать на основе")
                                </button>
                            }
                        }
                        else
                        {
                            <span class="small text-muted">Создают закреплённые преподаватели</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    /// <summary>Основа из ссылки «Создать на основе» в согласованном или архивном документе (этап 7, A11).</summary>
    [SupplyParameterFromQuery(Name = "basedOn")]
    public Guid? BasedOnId { get; set; }

    /// <summary>Тип документа из ссылки: <c>fos</c> открывает создание ФОС (этап 7, B3).</summary>
    [SupplyParameterFromQuery(Name = "type")]
    public string? TypeParam { get; set; }

    /// <summary>РПД из ссылки «Создать ФОС» в самой РПД (этап 7, B3): ФОС создаётся по ней, список дисциплин сужается до её дисциплины.</summary>
    [SupplyParameterFromQuery(Name = "rpd")]
    public Guid? RpdId { get; set; }

    private const string RpdType = "rpd", FosType = "fos";

    private string docType = RpdType;
    private DocumentListItem? fosRpd;
    private string TypeTitle => docType == FosType ? "ФОС" : "РПД";

    // С выбранной РПД — только её дисциплина: остальные ФОС создают по другим РПД.
    private IEnumerable<DisciplineOption> Rows => fosRpd is { } source
        ? disciplines!.Where(d => d.Code == source.DisciplineCode)
        : disciplines!;

    private static string StatusTitle(string? status) =>
        DocumentTitles.Statuses.Where(s => s.Code == status).Select(s => s.Title).FirstOrDefault() ?? status ?? "";

    private List<TemplateItem> templates = [];
    private List<DisciplineOption>? disciplines;
    private List<DocumentListItem> allBases = [];

    // Основа — документ того же типа, что создаётся: РПД на основе РПД, ФОС на основе ФОС (этап 7, B10).
    private IEnumerable<DocumentListItem> Bases => allBases.Where(b => b.Type == docType);
    private DocumentListItem? basis;
    private bool basesLoaded, choosing;
    private string baseFilter = "";
    private string templateId = "";
    private string? message;
    private bool messageIsError;
    private Guid? existingId;
    private bool busy;

    private TemplateItem? SelectedTemplate => templates.FirstOrDefault(t => t.Id.ToString() == templateId);

    // Основой служат свои РПД и РПД закреплённых дисциплин (методисту и администратору — все): тот же отбор, что на сервере.
    private IEnumerable<DocumentListItem> FilteredBases => Bases.Where(b => baseFilter.Length == 0 ||
        $"{b.Title} {b.DisciplineName} {b.AuthorName}".Contains(baseFilter.Trim(), StringComparison.CurrentCultureIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (RpdId is not null || TypeParam == FosType) docType = FosType;
            templates = await LoadTemplatesAsync();
            if (RpdId is Guid sourceId)
            {
                // «Создать ФОС» из РПД: у плана РПД один опубликованный шаблон ФОС — он уже выбран.
                await LoadBasesAsync();
                fosRpd = allBases.FirstOrDefault(b => b.Id == sourceId && b.Type == RpdType);
                if (fosRpd is null)
                    (messageIsError, message) = (true, "РПД недоступна: она удалена или не открыта вам. Выберите дисциплину из списка.");
                else if (fosRpd.Plan is { } rpdPlan && templates.Where(t => t.Plan?.Id == rpdPlan.Id).ToList() is [var onlyOne])
                {
                    templateId = onlyOne.Id.ToString();
                    await LoadDisciplinesAsync();
                }
            }
            else if (BasedOnId is Guid basedOn)
            {
                await LoadBasesAsync();
                basis = allBases.FirstOrDefault(b => b.Id == basedOn);
                // Основа — ФОС: открывается создание ФОС со своими шаблонами (этап 7, B10).
                if (basis is { Type: FosType } && docType != FosType)
                {
                    docType = FosType;
                    templates = await LoadTemplatesAsync();
                }
                if (basis is null)
                    (messageIsError, message) = (true, "Основа недоступна: документ удалён или не открыт вам. Выберите другую основу или создайте документ без неё.");
                // Следующая редакция той же дисциплины: если у плана основы один опубликованный шаблон, он уже выбран.
                else if (basis.Plan is { } plan && templates.Where(t => t.Plan?.Id == plan.Id).ToList() is [var same])
                {
                    templateId = same.Id.ToString();
                    await LoadDisciplinesAsync();
                }
            }
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
        }
    }

    private async Task<List<TemplateItem>> LoadTemplatesAsync() =>
        await Http.GetFromJsonAsync<List<TemplateItem>>($"api/templates?type={docType}&status=published") ?? [];

    // Смена типа начинает выбор заново: у РПД и ФОС свои шаблоны (этап 7, B3).
    private async Task SelectTypeAsync(string type)
    {
        if (type == docType) return;
        (docType, templateId, disciplines, basis, fosRpd, choosing, message, existingId) = (type, "", null, null, null, false, null, null);
        try
        {
            templates = await LoadTemplatesAsync();
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
        }
    }

    private async Task LoadBasesAsync()
    {
        if (basesLoaded) return;
        var own = await Http.GetFromJsonAsync<List<DocumentListItem>>("api/documents") ?? [];
        var assigned = await Http.GetFromJsonAsync<List<DocumentListItem>>("api/documents/assigned") ?? [];
        allBases = own.Concat(assigned).Where(d => d.Type is "rpd" or "fos").DistinctBy(d => d.Id).OrderBy(d => d.Title).ToList();
        basesLoaded = true;
    }

    private async Task ToggleChoosingAsync()
    {
        choosing = !choosing;
        if (!choosing) return;
        try
        {
            await LoadBasesAsync();
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
        }
    }

    private void PickBase(ChangeEventArgs e)
    {
        basis = Guid.TryParse(e.Value?.ToString(), out var id) ? Bases.FirstOrDefault(b => b.Id == id) : null;
        choosing = basis is null;
        message = null;
    }

    // Подсказка, почему на этой основе нельзя создать документ для дисциплины (решает сервер; здесь — чтобы не звать зря).
    // На основе создают для той же дисциплины или для дисциплины другого плана; у дисциплины с согласованным документом новый
    // создаётся только на основе согласованного.
    private string? BasisRefusal(DisciplineOption d)
    {
        if (basis is null) return null;
        if (basis.Plan?.Id is Guid basisPlan && basisPlan == SelectedTemplate?.Plan?.Id)
            return basis.DisciplineCode == d.Code ? null : "Основа из этого же плана: на ней создают документ только той же дисциплины";
        return d.DocumentStatus == "approved" ? "У дисциплины есть согласованный документ: новый создаётся только на его основе" : null;
    }

    private async Task LoadDisciplinesAsync()
    {
        disciplines = null;
        message = null;
        if (templateId.Length == 0) return;
        try
        {
            disciplines = await Http.GetFromJsonAsync<List<DisciplineOption>>($"api/documents/disciplines?templateId={templateId}");
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
        }
    }

    private async Task CreateAsync(DisciplineOption discipline)
    {
        busy = true;
        message = null;
        existingId = null;
        try
        {
            // ФОС создаётся по РПД — названной в ссылке «Создать ФОС» или РПД дисциплины, которую показал список; основа (B10) — прежний ФОС.
            var response = await Http.PostAsJsonAsync("api/documents", new
            {
                templateId = Guid.Parse(templateId), disciplineId = discipline.Id,
                basedOnDocumentId = basis?.Id,
                rpdDocumentId = docType == FosType ? fosRpd?.Id ?? discipline.RpdId : null
            });
            if (response.StatusCode == HttpStatusCode.Created && await response.Content.ReadFromJsonAsync<DocumentDetails>() is { } created)
            {
                // Редактор покажет, на чём основан документ и что из основы не перенесено.
                Navigation.NavigateTo($"documents/{created.Document.Id}");
                return;
            }
            var problem = await ReadProblemAsync(response);
            messageIsError = true;
            message = problem is null ? $"Документ не создан (код ответа {(int)response.StatusCode})."
                : problem.Detail is null ? problem.Title : $"{problem.Title}. {problem.Detail}";
            existingId = problem?.DocumentId;
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
        }
        finally
        {
            busy = false;
        }
    }

    private static async Task<DocumentProblem?> ReadProblemAsync(HttpResponseMessage response)
    {
        try
        {
            return await response.Content.ReadFromJsonAsync<DocumentProblem>();
        }
        catch (System.Text.Json.JsonException)
        {
            return null;
        }
    }
}
