@page "/documents"
@attribute [Authorize]
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using RpdFos.Web.Models
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Мои документы</PageTitle>

<ConfirmDialog @ref="confirm" />

<h1>Мои документы</h1>

@if (message is not null)
{
    <div class="alert @(messageIsError ? "alert-danger" : "alert-info") py-2" role="status">@message</div>
}

<AuthorizeView Roles="teacher,methodist,admin">
    <a class="btn btn-primary mb-3" href="documents/new">Создать документ</a>
</AuthorizeView>

<div class="row g-2 mb-3" style="max-width: 960px">
    <div class="col-md-4">
        <label class="form-label">Статус</label>
        <select class="form-select" @bind="status" @bind:after="LoadAsync">
            <option value="">Все</option>
            @foreach (var (statusCode, statusTitle) in DocumentTitles.Statuses)
            {
                <option value="@statusCode">@statusTitle</option>
            }
        </select>
    </div>
    <div class="col-md-8">
        <label class="form-label">Учебный план</label>
        <select class="form-select" @bind="planId" @bind:after="LoadAsync">
            <option value="">Все</option>
            @foreach (var p in plans)
            {
                <option value="@p.Id">@p.Title</option>
            }
        </select>
    </div>
</div>

@if (items is null)
{
    <p>Загрузка…</p>
}
else if (items.Count == 0)
{
    <p>Документов нет.</p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr><th>Дисциплина</th><th>Тип</th><th>Статус</th><th>Изменён</th><th>Автор</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var d in items)
            {
                <tr role="button" @onclick="@(() => Navigation.NavigateTo($"documents/{d.Id}"))">
                    <td>
                        <span class="text-muted">@d.DisciplineCode</span> @d.DisciplineName
                        @if (d.Plan is { } plan)
                        {
                            <div class="small text-muted">@plan.DirectionCode, набор @plan.Year, версия плана @plan.Version</div>
                        }
                    </td>
                    <td>@(d.Type == "fos" ? "ФОС" : "РПД")</td>
                    <td>
                        @d.StatusTitle
                        @if (d.IsOutdated)
                        {
                            <span class="badge text-bg-warning ms-1" title="Вышла новая редакция шаблона">устарел</span>
                        }
                    </td>
                    <td>@d.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@d.AuthorName</td>
                    <td class="text-end">
                        @if (d.CanDelete)
                        {
                            <button class="btn btn-sm btn-outline-danger" disabled="@deleting" @onclick="() => DeleteAsync(d)"
                                    @onclick:stopPropagation>Удалить</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private ConfirmDialog confirm = default!;
    private bool deleting;
    private string? message;
    private bool messageIsError;
    private List<DocumentListItem>? items;

    // Удаление своего черновика (этап 6, A5): мягкое, по дисциплине затем можно создать новый документ.
    private async Task DeleteAsync(DocumentListItem d)
    {
        if (!await confirm.AskAsync($"Удалить черновик «{d.DisciplineName}»?", "Удаление черновика", danger: true)) return;
        deleting = true;
        try
        {
            var response = await Http.DeleteAsync($"api/documents/{d.Id}?version={d.Version}");
            if (response.IsSuccessStatusCode)
                (messageIsError, message) = (false, $"Черновик «{d.DisciplineName}» удалён.");
            else
            {
                var problem = await response.Content.ReadFromJsonAsync<DocumentProblem>();
                (messageIsError, message) = (true, problem?.Title == "Конфликт версий"
                    ? "Документ изменён в другой сессии — список обновлён, удалите его снова."
                    : $"Черновик не удалён: {problem?.Detail ?? problem?.Title ?? ((int)response.StatusCode).ToString()}");
            }
            await LoadAsync();
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
        }
        finally
        {
            deleting = false;
        }
    }
    private List<PlanItem> plans = [];
    private string status = "";
    private string planId = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            plans = await Http.GetFromJsonAsync<List<PlanItem>>("api/curriculum-plans") ?? [];
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
            return;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var query = new List<string>();
        if (status.Length > 0) query.Add($"status={status}");
        if (planId.Length > 0) query.Add($"planId={planId}");
        try
        {
            items = await Http.GetFromJsonAsync<List<DocumentListItem>>("api/documents" + (query.Count > 0 ? "?" + string.Join("&", query) : ""));
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
        }
    }
}
