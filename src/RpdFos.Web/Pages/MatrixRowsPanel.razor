@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using RpdFos.Web.Models
@inject HttpClient Http

@* Строки матрицы без дисциплины плана (этап 5.2, ЛР Т1): у запуска, создавшего план, методист привязывает строку
   к дисциплине этой версии плана или отмечает «Не учитывать»; привязку можно отменить. Одинаковые строки матрицы
   (то же название и семестры, например таблицы 1 и 3 одного файла) — одна строка блока: привязка и отмена действуют
   на все её места (этап 7.1). *@
@if (rows is { Count: > 0 })
{
    <h3 class="h5 mt-4">Строки матрицы без дисциплины плана</h3>
    <p class="small text-muted">
        Строка не найдена в плане по названию или неоднозначна — её связи с компетенциями не загружены. Привязка добавляет
        дисциплине связи строки на уровне компетенций; документы, уже созданные по дисциплине, не меняются. Одинаковые строки
        из разных таблиц матрицы показаны одной и привязываются вместе.
    </p>
    @if (message is not null)
    {
        <div class="alert @(messageIsError ? "alert-danger" : "alert-info") py-2 small" role="status">@message</div>
    }
    @* Узкий экран: таблица прокручивается в обёртке, а не рвёт слова по буквам (общее правило — app.css). *@
    <div class="table-responsive">
    <table class="table table-sm align-middle">
        <thead>
            <tr><th>Строка матрицы</th><th>Семестры</th><th>Коды</th><th>Дисциплина плана</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var row in rows)
            {
                <tr @key="row.Id">
                    <td>@row.Name <div class="small text-muted">@string.Join("; ", row.Places)</div></td>
                    <td>@row.Semesters</td>
                    <td>@string.Join(", ", row.Codes)</td>
                    @if (row.Status == "pending")
                    {
                        <td>
                            @* В прокручиваемой таблице колонка сжимается до самого узкого содержимого — список держит ширину.
                               Список создаётся заново при каждом перечитывании (@key с номером загрузки): когда другие
                               строки привязаны, порядок вариантов меняется, а браузер держит выбор по положению в списке —
                               без этого показано одно название, а привязывается другая дисциплина. *@
                            <select class="form-select form-select-sm" style="min-width: 16rem" @key="@((row.Id, loadVersion))"
                                    value="@choices.Get(row.Id)" @onchange="e => choices.Set(row.Id, e.Value?.ToString())">
                                <option value="">— выберите</option>
                                <option value="@MatrixRowChoices.Ignore">Не учитывать</option>
                                @foreach (var o in row.Options)
                                {
                                    <option value="@o.Id">@o.Code @o.Name@(o.Candidate ? " — кандидат" : o.LinkedHere ? " — уже привязана в этом блоке" : o.WithoutMatrix ? " — без связей с матрицей" : "")</option>
                                }
                            </select>
                        </td>
                        <td>
                            <button class="btn btn-sm btn-primary" disabled="@(busy || !choices.TryGetTarget(row.Id, out _))"
                                    @onclick="() => ApplyAsync(row)">Применить</button>
                        </td>
                    }
                    else
                    {
                        <td>
                            @(row.Status == "ignored" ? "Не учитывать" : row.Discipline)
                            <div class="small text-muted">@row.ResolvedBy, @row.ResolvedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                        </td>
                        <td><button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="() => UndoAsync(row)">Отменить</button></td>
                    }
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid RunId { get; set; }

    private List<MatrixRowItem>? rows;
    private readonly MatrixRowChoices choices = new();
    private string? message;
    private bool messageIsError, busy;
    private Guid loaded;
    private int loadVersion;

    protected override async Task OnParametersSetAsync()
    {
        if (loaded == RunId) return;
        loaded = RunId;
        message = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            rows = await Http.GetFromJsonAsync<List<MatrixRowItem>>($"api/imports/{RunId}/matrix-rows");
            choices.Reconcile(rows ?? []);
            loadVersion++;
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
        }
    }

    private async Task ApplyAsync(MatrixRowItem row)
    {
        if (!choices.TryGetTarget(row.Id, out var target)) return;
        var body = new { DisciplineId = target, Ignore = target is null };
        await RunAsync(() => Http.PostAsJsonAsync($"api/imports/matrix-rows/{row.Id}/apply", body), async response =>
        {
            var applied = await response.Content.ReadFromJsonAsync<Applied>();
            var what = row.Places.Count > 1 ? $"Строки «{row.Name}» привязаны ({row.Places.Count})." : $"Строка «{row.Name}» привязана.";
            message = applied?.Warnings is { Count: > 0 } w ? $"{what} {string.Join(" ", w)}" : what;
        });
    }

    private Task UndoAsync(MatrixRowItem row) =>
        RunAsync(() => Http.PostAsync($"api/imports/matrix-rows/{row.Id}/undo", null), _ =>
        {
            message = row.Places.Count > 1
                ? $"Привязка строк «{row.Name}» отменена ({row.Places.Count})."
                : $"Привязка строки «{row.Name}» отменена.";
            choices.Set(row.Id, "");
            return Task.CompletedTask;
        });

    private async Task RunAsync(Func<Task<HttpResponseMessage>> send, Func<HttpResponseMessage, Task> done)
    {
        busy = true;
        try
        {
            var response = await send();
            if (response.IsSuccessStatusCode)
            {
                messageIsError = false;
                await done(response);
                await LoadAsync();
                return;
            }
            var problem = await response.Content.ReadFromJsonAsync<Problem>();
            (messageIsError, message) = (true, problem?.Detail is { } d ? $"{problem.Title}. {d}" : problem?.Title ?? $"Ответ сервера: {(int)response.StatusCode}");
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
        }
        finally
        {
            busy = false;
        }
    }

    private sealed record Applied(List<string> Warnings);
    private sealed record Problem(string? Title, string? Detail);
}
