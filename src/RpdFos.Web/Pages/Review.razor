@page "/review"
@attribute [Authorize(Roles = "methodist")]
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using RpdFos.Web.Models
@inject HttpClient Http

<PageTitle>Проверка</PageTitle>

@* Очередь проверки (S-30): документы на проверке — от отправленных раньше к отправленным позже. Документ, который вернул
   согласующий, помечен «с согласования» (этап 6.1, C4); дата отправки у него прежняя — автором, а кто и когда вернул,
   написано в пометке. *@
<h1 class="h3">Документы на проверке</h1>

@if (documents is null)
{
    <p>Загрузка…</p>
}
else if (documents.Count == 0)
{
    <p class="text-muted">Документов на проверке нет.</p>
}
else
{
    @* Узкий экран: таблица прокручивается в обёртке, а не рвёт слова по буквам (общее правило — app.css). *@
    <div class="table-responsive">
    <table class="table table-sm align-middle">
        <thead>
            <tr><th>Отправлен</th><th>Дисциплина</th><th>Тип</th><th>Автор</th><th>План</th></tr>
        </thead>
        <tbody>
            @foreach (var d in documents)
            {
                <tr>
                    <td class="text-nowrap">@(d.SubmittedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                    <td>
                        <a href="documents/@d.Id">@d.DisciplineCode @d.DisciplineName</a>
                        @if (d.FromApproval is { } back)
                        {
                            @* Без родовых форм («возврат», не «вернул»): пол согласующего системе неизвестен. *@
                            <div class="small">
                                <span class="badge text-bg-warning">с согласования</span>
                                <span class="text-muted">возврат: @back.By, @back.At.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                            </div>
                        }
                    </td>
                    <td>@(d.Type == "fos" ? "ФОС" : "РПД")</td>
                    <td>@d.AuthorName</td>
                    <td class="small text-muted">@d.Plan?.Title</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    private List<DocumentListItem>? documents;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var list = await Http.GetFromJsonAsync<List<DocumentListItem>>("api/documents?status=under_review") ?? [];
            documents = list.OrderBy(d => d.SubmittedAt).ToList();
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
        }
    }
}
