@page "/templates/new"
@page "/templates/{Id:guid}"
@attribute [Authorize]
@using System.Net
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Nodes
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using RpdFos.Web.Forms
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using RpdFos.Web.Models
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(Id is null ? "Новый шаблон" : details?.Template.Name ?? "Шаблон")</PageTitle>

<p><a href="templates">← Шаблоны</a></p>

@if (message is not null)
{
    <div class="alert @(messageIsError ? "alert-danger" : "alert-info")" role="status">
        @message
        @if (problems.Count > 0)
        {
            <ul class="mb-0 mt-2">
                @foreach (var p in problems)
                {
                    <li>@p</li>
                }
            </ul>
        }
    </div>
}

@if (Id is null)
{
    <h1>Новый шаблон</h1>
    <AuthorizeView Roles="methodist,admin">
        <Authorized>
            <div class="row g-3 mb-3" style="max-width: 720px">
                <div class="col-md-4">
                    <label class="form-label">Тип документа</label>
                    <select class="form-select" @bind="newType">
                        @foreach (var (typeCode, typeTitle) in TemplateTitles.Types)
                        {
                            <option value="@typeCode">@typeTitle</option>
                        }
                    </select>
                </div>
                <div class="col-md-8">
                    <label class="form-label">Название</label>
                    <input class="form-control" @bind="newName" @bind:event="oninput" maxlength="255" />
                </div>
                <div class="col-12">
                    <label class="form-label">Учебный план</label>
                    <select class="form-select" @bind="newPlanId">
                        <option value="">— выберите импортированный план —</option>
                        @foreach (var p in plans)
                        {
                            <option value="@p.Id">@p.Title</option>
                        }
                    </select>
                    @if (plans.Count == 0)
                    {
                        <div class="form-text">Планов нет — сначала загрузите учебный план на странице «Импорт данных».</div>
                    }
                </div>
            </div>
            <button class="btn btn-primary" @onclick="CreateAsync"
                    disabled="@(busy || string.IsNullOrWhiteSpace(newName) || newPlanId.Length == 0)">Создать</button>
        </Authorized>
        <NotAuthorized>
            <p>Создавать шаблоны могут методист и администратор.</p>
        </NotAuthorized>
    </AuthorizeView>
}
else if (details is null)
{
    @if (!loadFailed)
    {
        <p>Загрузка…</p>
    }
}
else
{
    var t = details.Template;
    <h1>@t.Name</h1>
    <p class="text-muted">@t.TypeTitle · редакция @t.Revision · <strong>@t.StatusTitle</strong></p>

    <dl class="row" style="max-width: 960px">
        <dt class="col-sm-3">Учебный план</dt>
        <dd class="col-sm-9">@(t.Plan?.Title ?? "не привязан")</dd>
        <dt class="col-sm-3">Шаблон оформления</dt>
        <dd class="col-sm-9">
            @(details.PrintTemplateName ?? "не загружен")
            @if (canManage && details.PrintTemplateName is not null)
            {
                <button class="btn btn-link btn-sm p-0 ms-2 align-baseline" @onclick="DownloadPrintTemplateAsync" disabled="@busy">Скачать</button>
            }
        </dd>
        @if (t.PublishedAt is { } published)
        {
            <dt class="col-sm-3">Опубликован</dt>
            <dd class="col-sm-9">@published.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
        }
    </dl>

    <AuthorizeView Roles="methodist,admin">
        @if (t.Status is "empty" or "draft" or "saved_draft")
        {
            <div class="mb-3" style="max-width: 720px">
                <label class="form-label">DOCX-шаблон оформления с закладками Autofill</label>
                <div class="input-group">
                    <InputFile class="form-control" accept=".docx" OnChange="e => printTemplate = e.File" disabled="@busy" />
                    <button class="btn btn-outline-primary" @onclick="UploadAsync" disabled="@(busy || printTemplate is null)">Загрузить</button>
                </div>
            </div>
        }
        <div class="d-flex flex-wrap gap-2 mb-3">
            @if (t.Status == "draft")
            {
                <button class="btn btn-secondary" @onclick="@(() => ChangeAsync("save", "Шаблон сохранён."))" disabled="@busy">Сохранить</button>
            }
            @if (t.Status is "draft" or "saved_draft")
            {
                <button class="btn btn-success" @onclick="@(() => ChangeAsync("publish", "Шаблон опубликован."))" disabled="@busy">Опубликовать</button>
            }
            @if (t.Status == "published")
            {
                <button class="btn btn-outline-primary" @onclick="CreateRevisionAsync" disabled="@busy">Новая редакция</button>
                <button class="btn btn-outline-secondary" @onclick="@(() => ChangeAsync("archive", "Шаблон перенесён в архив."))" disabled="@busy">Архивировать</button>
            }
            @if (t.Status is "empty" or "draft" or "saved_draft")
            {
                <button class="btn btn-outline-danger" @onclick="DeleteAsync" disabled="@busy">Удалить</button>
            }
            @if (defaultsDirty)
            {
                <span class="small text-warning-emphasis">
                    Есть несохранённые значения по умолчанию — «Сохранить» и «Опубликовать» сохранят их вместе с шаблоном.
                </span>
            }
        </div>
    </AuthorizeView>

    <h2 class="h4 mt-4">Проверка перед публикацией</h2>
    @if (details.CanPublish)
    {
        <p class="text-success">Проверка пройдена: учебный план привязан, шаблон оформления загружен, все закладки сопоставлены.</p>
    }
    else
    {
        <ul class="text-danger">
            @foreach (var e in details.Errors)
            {
                <li>@e</li>
            }
        </ul>
    }

    <h2 class="h4 mt-4">Закладки шаблона оформления</h2>
    @if (details.Bookmarks.Count == 0)
    {
        <p>Шаблон оформления не загружен.</p>
    }
    else
    {
        <p>
            Закладок: @details.Bookmarks.Count, вхождений: @details.Bookmarks.Sum(b => b.Count),
            не сопоставлено: @details.Bookmarks.Count(b => b.Target is null),
            с особыми вхождениями: @details.Bookmarks.Count(b => b.Target?.Occurrences is { Count: > 0 }).
            Вхождение без особых указаний получает цель закладки в именительном падеже.
        </p>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Закладка</th><th>Вхождений</th><th>Сопоставлена</th><th>Вид цели</th><th>Цель</th>
                    <th>Особые вхождения</th><th>Пояснение</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in details.Bookmarks)
                {
                    <tr class="@(b.Target is null ? "table-danger" : "")">
                        <td><code>@b.BaseName</code></td>
                        <td>@b.Count</td>
                        <td>@(b.Target is null ? "нет" : "да")</td>
                        <td>@(b.Target is null ? "" : TemplateTitles.Kind(b.Target.Kind))</td>
                        <td>
                            @if (b.Target is { } target)
                            {
                                <code>@TargetText(target.Kind, target.Target, target.Part)</code>
                            }
                        </td>
                        <td>
                            @foreach (var (name, o) in b.Target?.Occurrences ?? [])
                            {
                                <div>@OccurrenceText(b.BaseName, name, b.Target!, o)</div>
                                @if (o.Note is not null)
                                {
                                    <div class="small text-muted">@o.Note</div>
                                }
                            }
                        </td>
                        <td class="small">@b.Target?.Note</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (defaultsContext is not null && details.DefaultFields.Count > 0)
    {
        <h2 class="h4 mt-4">Значения по умолчанию</h2>
        <p class="text-muted" style="max-width: 960px">
            Постоянные пункты вуза: новый документ получает их предзаполненными, автор дополняет и удаляет пункты.
            В печати пункты по умолчанию и пункты автора — один список с единой нумерацией.
            @if (!CanEditDefaults)
            {
                <span>Опубликованный шаблон меняется новой редакцией.</span>
            }
        </p>
        <NavigationLock ConfirmExternalNavigation="@defaultsDirty" OnBeforeInternalNavigation="ConfirmLeaveAsync" />
        <div style="max-width: 960px">
            @foreach (var field in details.DefaultFields)
            {
                <SchemaField Context="defaultsContext" Schema="FieldSchema(field.Pointer)" Parent="Container(field.Pointer)"
                             Key="@field.Pointer.Split('/')[^1]" Path="@field.Pointer" Label="@field.Title" Nested="true" />
            }
        </div>
        @if (CanEditDefaults)
        {
            <button class="btn btn-primary mb-3" @onclick="SaveDefaultsAsync" disabled="@(busy || !defaultsDirty)">Сохранить значения по умолчанию</button>
        }
    }

    <h2 class="h4 mt-4">Лист согласования</h2>
    <table class="table table-sm">
        <thead>
            <tr><th>Место</th><th>Категория</th><th>Правило определения</th><th>Согласование</th><th>Размещение</th></tr>
        </thead>
        <tbody>
            @foreach (var s in details.Signatures)
            {
                <tr>
                    <td>@s.Title</td>
                    @* Коды категории и правила — во всплывающей подсказке. *@
                    <td title="@s.Role">@s.RoleTitle</td>
                    <td title="@s.Resolver">@(s.ResolverTitle ?? s.Resolver)</td>
                    <td>@(s.Electronic ? "электронно" : "на бумаге")</td>
                    <td>@TemplateTitles.Placement(s.Placement)</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private const long MaxFileBytes = 10 * 1024 * 1024;

    [Parameter] public Guid? Id { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private TemplateDetails? details;
    private SchemaContext? defaultsContext;
    private JsonObject defaults = [];
    private bool defaultsDirty;
    private bool canManage;

    // Умолчания меняет методист или администратор, пока шаблон не опубликован; остальным — только просмотр.
    private bool CanEditDefaults => canManage && details?.Template.Status is "empty" or "draft" or "saved_draft";
    private List<PlanItem> plans = [];
    private IBrowserFile? printTemplate;
    private string newType = "rpd";
    private string newName = "";
    private string newPlanId = "";
    private string? message;
    private bool messageIsError;
    private List<string> problems = [];
    private bool busy;
    private bool loadFailed;

    protected override async Task OnParametersSetAsync()
    {
        // Одна страница — и создание, и шаблон: после «Новой редакции» меняется только Id.
        details = null;
        printTemplate = null;
        defaultsContext = null;
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            canManage = user.IsInRole("methodist") || user.IsInRole("admin");
        }
        try
        {
            loadFailed = false;
            if (Id is null)
                plans = await Http.GetFromJsonAsync<List<PlanItem>>("api/curriculum-plans") ?? [];
            else
            {
                var response = await Http.GetAsync($"api/templates/{Id}");
                if (response.IsSuccessStatusCode)
                {
                    details = await response.Content.ReadFromJsonAsync<TemplateDetails>();
                    BuildDefaults();
                }
                else
                {
                    loadFailed = true;
                    await ShowProblemAsync(response);
                }
            }
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
        }
    }

    private async Task CreateAsync()
    {
        await RunAsync(async () =>
        {
            var response = await Http.PostAsJsonAsync("api/templates",
                new { type = newType, name = newName.Trim(), curriculumPlanId = Guid.Parse(newPlanId) });
            if (response.StatusCode == HttpStatusCode.Created &&
                await response.Content.ReadFromJsonAsync<TemplateDetails>() is { } created)
            {
                Show("Шаблон создан. Загрузите DOCX-шаблон оформления.", false);
                Navigation.NavigateTo($"templates/{created.Template.Id}");
            }
            else
                await ShowProblemAsync(response);
        });
    }

    private async Task UploadAsync()
    {
        await RunAsync(async () =>
        {
            using var form = new MultipartFormDataContent();
            var file = new StreamContent(printTemplate!.OpenReadStream(MaxFileBytes));
            file.Headers.ContentType = new MediaTypeHeaderValue(
                string.IsNullOrEmpty(printTemplate.ContentType) ? "application/octet-stream" : printTemplate.ContentType);
            form.Add(file, "file", printTemplate.Name);
            form.Add(new StringContent(details!.Template.Version.ToString()), "version");

            await ApplyAsync(await Http.PostAsync($"api/templates/{Id}/print-template", form), "Шаблон оформления загружен.");
        });
    }

    private async Task ChangeAsync(string action, string done)
    {
        await RunAsync(async () =>
        {
            // Шаблон сохраняется и публикуется вместе с несохранёнными значениями по умолчанию: иначе ответ сервера
            // перестроил бы форму и стёр их. Умолчания с ошибками — действие не выполняется, места ошибок показаны.
            if (defaultsDirty && action is "save" or "publish" && !await PutDefaultsAsync()) return;
            await ApplyAsync(await Http.PostAsJsonAsync($"api/templates/{Id}/{action}", new { version = details!.Template.Version }), done);
        });
    }

    private async Task CreateRevisionAsync()
    {
        await RunAsync(async () =>
        {
            var response = await Http.PostAsJsonAsync($"api/templates/{Id}/revisions", new { version = details!.Template.Version });
            if (response.StatusCode == HttpStatusCode.Created &&
                await response.Content.ReadFromJsonAsync<TemplateDetails>() is { } revision)
            {
                Show($"Создана редакция {revision.Template.Revision}. Прежняя остаётся опубликованной до публикации новой.", false);
                Navigation.NavigateTo($"templates/{revision.Template.Id}");
            }
            else
                await ShowProblemAsync(response);
        });
    }

    private async Task DeleteAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Удалить шаблон «{details!.Template.Name}»?"))
            return;
        await RunAsync(async () =>
        {
            var response = await Http.DeleteAsync($"api/templates/{Id}?version={details!.Template.Version}");
            if (response.StatusCode == HttpStatusCode.NoContent)
            {
                // Удаление уже подтверждено — второй вопрос о несохранённых умолчаниях не нужен.
                defaultsDirty = false;
                Navigation.NavigateTo("templates");
            }
            else
                await ShowProblemAsync(response);
        });
    }

    private async Task ApplyAsync(HttpResponseMessage response, string done)
    {
        if (response.IsSuccessStatusCode && await response.Content.ReadFromJsonAsync<TemplateDetails>() is { } updated)
        {
            details = updated;
            // Несохранённые правки умолчаний переживают другие действия (загрузку оформления): форма остаётся как есть.
            BuildDefaults(keepUnsaved: true);
            printTemplate = null;
            Show(done, false);
        }
        else
            await ShowProblemAsync(response);
    }

    private async Task DownloadPrintTemplateAsync()
    {
        await RunAsync(async () =>
        {
            var response = await Http.GetAsync($"api/templates/{Id}/print-template");
            if (!response.IsSuccessStatusCode)
            {
                await ShowProblemAsync(response);
                return;
            }
            await JS.InvokeVoidAsync("rpdfosDownload", await response.Content.ReadAsByteArrayAsync(), details!.PrintTemplateName,
                "application/vnd.openxmlformats-officedocument.wordprocessingml.document");
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        busy = true;
        message = null;
        problems = [];
        try
        {
            await action();
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
        }
        catch (IOException e)
        {
            Show($"Файл не прочитан: {e.Message}", true);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ShowProblemAsync(HttpResponseMessage response)
    {
        TemplateProblem? problem = null;
        try
        {
            problem = await response.Content.ReadFromJsonAsync<TemplateProblem>();
        }
        catch (System.Text.Json.JsonException)
        {
            // Тело не ProblemDetails — достаточно кода ответа.
        }
        // Заголовок и пояснение по-русски даёт сервер (ProblemDetails); по коду ответа — только когда тела нет.
        var text = response.StatusCode switch
        {
            HttpStatusCode.Conflict when problem?.Title == "Конфликт версий" =>
                "Шаблон изменён в другой сессии. Обновите страницу и повторите действие.",
            _ when problem?.Title is { } title =>
                problem.Errors is { Count: > 0 } || problem.Detail is null ? title : $"{title}. {problem.Detail}",
            HttpStatusCode.NotFound => "Шаблон не найден — возможно, он удалён в другой вкладке.",
            HttpStatusCode.Forbidden => "Недостаточно прав для этого действия.",
            >= HttpStatusCode.InternalServerError => "Ошибка сервера. Повторите действие позже.",
            _ => $"Действие не выполнено (код ответа {(int)response.StatusCode})."
        };
        Show(text, true);
        problems = problem?.Errors ?? [];
    }

    private void Show(string text, bool isError) => (message, messageIsError) = (text, isError);

    // Умолчания редактируются теми же полями и виджетами, что и документ: содержимое — умолчания шаблона, метаданных
    // документа (план, кандидаты) у шаблона нет.
    /// <param name="keepUnsaved">Несохранённые правки остаются в форме — после действий, которые умолчаний не меняют.</param>
    private void BuildDefaults(bool keepUnsaved = false)
    {
        if (details is null) return;
        if (!(keepUnsaved && defaultsDirty))
        {
            defaultsDirty = false;
            defaults = details.Defaults is { } d && JsonNode.Parse(d.GetRawText()) is JsonObject o ? o : [];
        }
        // Как в редакторе документа: правка отмечается по вводу (oninput), страница перерисовывается при первой —
        // чтобы кнопка сохранения и подтверждение ухода со страницы узнали о ней сразу.
        defaultsContext = new SchemaContext(details.Schema, defaults, new DocumentMetadata([], [], [], [], null, null),
            () => { defaultsDirty = true; StateHasChanged(); },
            () =>
            {
                if (defaultsDirty) return;
                defaultsDirty = true;
                StateHasChanged();
            })
        {
            Locked = !CanEditDefaults, Defaults = defaults, IsTemplate = true
        };
    }

    private JsonElement FieldSchema(string pointer)
    {
        var node = details!.Schema;
        foreach (var segment in pointer.TrimStart('/').Split('/'))
            node = defaultsContext!.Resolve(node.TryGetProperty("properties", out var p) && p.TryGetProperty(segment, out var next) ? next : default);
        return node;
    }

    // Объект, в котором лежит поле: промежуточные объекты создаются сразу — пустые сервер при сохранении отбросит.
    private JsonObject Container(string pointer)
    {
        var current = defaults;
        foreach (var segment in pointer.TrimStart('/').Split('/')[..^1])
        {
            if (current[segment] is not JsonObject next) current[segment] = next = new JsonObject();
            current = next;
        }
        return current;
    }

    private async Task SaveDefaultsAsync()
    {
        await RunAsync(async () =>
        {
            if (await PutDefaultsAsync()) Show("Значения по умолчанию сохранены.", false);
        });
    }

    /// <summary>Сохраняет значения по умолчанию; false — не сохранены, причина и места ошибок показаны.</summary>
    private async Task<bool> PutDefaultsAsync()
    {
        var body = new TemplateDefaultsRequest(details!.Template.Version, JsonDocument.Parse(defaults.ToJsonString()).RootElement);
        var response = await Http.PutAsJsonAsync($"api/templates/{Id}/defaults", body);
        if (response.StatusCode == HttpStatusCode.UnprocessableEntity)
        {
            // Места ошибок — подписями полей формы: «Интернет-ресурсы → № 2 → Адрес».
            using var problem = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
            Show(problem.RootElement.TryGetProperty("title", out var t) ? t.GetString() ?? "" : "Значения по умолчанию не сохранены", true);
            problems = problem.RootElement.TryGetProperty("errors", out var errors) && errors.ValueKind == JsonValueKind.Array
                ? errors.EnumerateArray().Select(e => $"{defaultsContext!.FieldTitle(e.GetProperty("path").GetString() ?? "")}: {e.GetProperty("message").GetString()}").ToList()
                : [];
            return false;
        }
        if (!response.IsSuccessStatusCode || await response.Content.ReadFromJsonAsync<TemplateDetails>() is not { } updated)
        {
            await ShowProblemAsync(response);
            return false;
        }
        details = updated;
        defaultsDirty = false;
        BuildDefaults();
        return true;
    }

    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        if (defaultsDirty && !await JS.InvokeAsync<bool>("confirm", "Значения по умолчанию не сохранены. Уйти со страницы?"))
            context.PreventNavigation();
    }

    // Цель закладки: для подписи — место и часть, для остальных — путь, поле, построитель или текст.
    private string TargetText(string kind, string target, string? part) => kind == "signature"
        ? $"{details?.Signatures.FirstOrDefault(s => s.Id == target)?.Title ?? target} · {TemplateTitles.Part(part)}"
        : target;

    // «вхождение 2: дательный падеж», «вхождение 2: своя цель — …»; номер — суффикс полного имени закладки.
    private string OccurrenceText(string baseName, string name, BookmarkTarget target, BookmarkOccurrence o)
    {
        var number = name.StartsWith(baseName) ? name[baseName.Length..] : name;
        var parts = new List<string>();
        if (o.Target is not null)
        {
            var kind = o.Kind ?? target.Kind;
            parts.Add($"своя цель — {TemplateTitles.Kind(kind)}: {TargetText(kind, o.Target, o.Part ?? target.Part)}");
        }
        if (o.Form is not null)
            parts.Add(TemplateTitles.Form(o.Form));
        return $"вхождение {number}: {string.Join(", ", parts)}";
    }
}
