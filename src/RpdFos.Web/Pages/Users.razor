@page "/users"
@attribute [Authorize(Roles = "admin")]
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@inject HttpClient Http

<PageTitle>Пользователи</PageTitle>

<h1>Пользователи</h1>

@if (accounts is null)
{
    <p>Загрузка…</p>
}
else
{
    <table class="table table-sm align-middle">
        <thead>
            <tr><th>Email</th><th>ФИО</th><th>Роли</th><th>Запись справочника сотрудников</th><th>Учётная запись</th></tr>
        </thead>
        <tbody>
            @foreach (var a in accounts)
            {
                <tr class="@(a.IsActive ? "" : "text-muted")">
                    <td>@a.Email</td>
                    <td>@a.FullName</td>
                    <td>
                        @* Ролей может быть несколько (этап 6, B1): заведующий кафедрой — и преподаватель, и согласующий. *@
                        @if (rolesFor == a.Id)
                        {
                            @foreach (var (roleCode, roleTitle) in Roles)
                            {
                                var boxId = $"role-{a.Id}-{roleCode}";
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="@boxId" checked="@editedRoles.Contains(roleCode)"
                                           @onchange="e => Toggle(editedRoles, roleCode, e.Value is true)" />
                                    <label class="form-check-label" for="@boxId">@roleTitle</label>
                                </div>
                            }
                            <div class="mt-1 text-nowrap">
                                <button class="btn btn-primary btn-sm" type="button" disabled="@(editedRoles.Count == 0)" @onclick="() => SetRolesAsync(a)">Сохранить</button>
                                <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="() => rolesFor = null">Отмена</button>
                            </div>
                        }
                        else
                        {
                            <div>@RolesTitle(a.Roles)</div>
                            <button class="btn btn-link btn-sm p-0" type="button" @onclick="() => EditRoles(a)">Изменить роли</button>
                        }
                    </td>
                    <td>@(a.Directory is { } d ? Describe(d) : "— не связана")</td>
                    <td>
                        @* Этап 5.2 (FR-ADM-01): временный пароль, отключение и возврат; запись справочника не меняется. *@
                        <div class="small mb-1">@(a.IsActive ? "активна" : "отключена — вход запрещён")</div>
                        @if (passwordFor == a.Id)
                        {
                            <div class="input-group input-group-sm" style="max-width: 320px">
                                <input class="form-control" type="password" placeholder="Новый временный пароль" @bind="newPassword" />
                                <button class="btn btn-primary" type="button" @onclick="() => SetPasswordAsync(a)">Задать</button>
                                <button class="btn btn-outline-secondary" type="button" @onclick="() => passwordFor = null">Отмена</button>
                            </div>
                        }
                        else
                        {
                            <button class="btn btn-link btn-sm p-0 me-2" type="button" @onclick="() => (passwordFor, newPassword) = (a.Id, string.Empty)">Новый пароль</button>
                            <button class="btn btn-link btn-sm p-0" type="button" @onclick="() => SetEnabledAsync(a, !a.IsActive)">
                                @(a.IsActive ? "Отключить" : "Вернуть")
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h2 class="h4 mt-4">Новый пользователь</h2>

<EditForm Model="model" OnValidSubmit="CreateAsync" style="max-width: 720px">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-2">
        <label class="form-label">Email</label>
        <InputText class="form-control" @bind-Value="model.Email" />
    </div>
    <div class="mb-2">
        <label class="form-label">ФИО полностью</label>
        <InputText class="form-control" @bind-Value="model.FullName" />
    </div>
    <div class="mb-2">
        <label class="form-label">Временный пароль</label>
        <InputText class="form-control" type="password" @bind-Value="model.Password" />
    </div>
    <fieldset class="mb-3">
        <legend class="form-label">Роли</legend>
        @foreach (var (roleCode, roleTitle) in Roles)
        {
            var boxId = $"new-role-{roleCode}";
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" id="@boxId" checked="@model.Roles.Contains(roleCode)"
                       @onchange="e => Toggle(model.Roles, roleCode, e.Value is true)" />
                <label class="form-check-label" for="@boxId">@roleTitle</label>
            </div>
        }
        <div class="form-text">Можно отметить несколько: заведующий кафедрой — и преподаватель, и утверждающий.</div>
    </fieldset>

    <fieldset class="mb-3">
        <legend class="form-label">Запись справочника сотрудников (необязательно)</legend>
        <p class="form-text mt-0">
            Если сотрудник уже есть в справочнике — например, заведующий или директор из файла должностей, —
            выберите его запись: учётная запись будет связана с ней. Иначе будет создана новая запись.
        </p>
        @if (selected is not null)
        {
            <p>
                Выбрана: <strong>@Describe(selected)</strong>
                <button type="button" class="btn btn-link" @onclick="() => selected = null">Сбросить</button>
            </p>
        }
        else
        {
            <div class="input-group mb-2">
                <input class="form-control" placeholder="Фамилия" @bind="surname" @bind:event="oninput" />
                <button type="button" class="btn btn-outline-secondary" @onclick="SearchAsync">Найти</button>
            </div>
            @if (candidates is not null)
            {
                @if (candidates.Count == 0)
                {
                    <p class="form-text">Записей без учётной записи с такой фамилией нет.</p>
                }
                else
                {
                    <ul class="list-group">
                        @foreach (var c in candidates)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                @Describe(c)
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => Select(c)">Выбрать</button>
                            </li>
                        }
                    </ul>
                }
            }
        }
    </fieldset>

    <button class="btn btn-primary" type="submit">Создать</button>
</EditForm>

@if (message is not null)
{
    <div class="alert @(messageIsError ? "alert-danger" : "alert-success") mt-3" role="status">@message</div>
}

@code {
    private static readonly (string Code, string Title)[] Roles =
    [
        ("teacher", "Преподаватель"), ("methodist", "Методист"), ("approver", "Утверждающий"), ("admin", "Администратор")
    ];

    private NewUser model = new();
    private List<Account>? accounts;
    private List<DirectoryRecord>? candidates;
    private DirectoryRecord? selected;
    private string surname = "";
    private string? message;
    private bool messageIsError;

    protected override async Task OnInitializedAsync() => await LoadAccountsAsync();

    private async Task LoadAccountsAsync()
    {
        try
        {
            accounts = await Http.GetFromJsonAsync<List<Account>>("api/admin/users");
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
        }
    }

    private async Task SearchAsync()
    {
        try
        {
            candidates = await Http.GetFromJsonAsync<List<DirectoryRecord>>(
                $"api/admin/directory?surname={Uri.EscapeDataString(surname.Trim())}");
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
        }
    }

    private void Select(DirectoryRecord record)
    {
        selected = record;
        candidates = null;
    }

    private async Task CreateAsync()
    {
        if (model.Roles.Count == 0)
        {
            (messageIsError, message) = (true, "Отметьте хотя бы одну роль.");
            return;
        }
        try
        {
            var response = await Http.PostAsJsonAsync("api/admin/users", new
            {
                model.Email, model.FullName, model.Password, Roles = model.Roles.ToArray(), DirectoryUserId = selected?.Id
            });
            if (response.IsSuccessStatusCode)
            {
                messageIsError = false;
                message = selected is null
                    ? $"Пользователь {model.Email} создан."
                    : $"Пользователь {model.Email} создан и связан с записью «{selected.ShortName}».";
                model = new();
                selected = null;
                surname = "";
                await LoadAccountsAsync();
                return;
            }

            messageIsError = true;
            var problem = await response.Content.ReadFromJsonAsync<Problem>();
            message = problem?.Errors is { Count: > 0 } errors
                ? string.Join(" ", errors.SelectMany(e => e.Value))
                : problem?.Detail ?? problem?.Title ?? $"Ответ сервера: {(int)response.StatusCode}";
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
        }
    }

    private Guid? rolesFor;
    private HashSet<string> editedRoles = [];

    private void EditRoles(Account account) => (rolesFor, editedRoles) = (account.Id, [.. account.Roles]);

    private static void Toggle(HashSet<string> roles, string role, bool on)
    {
        if (on) roles.Add(role);
        else roles.Remove(role);
    }

    private async Task SetRolesAsync(Account account)
    {
        await RunAsync(() => Http.PutAsJsonAsync($"api/admin/users/{account.Id}/roles", new { roles = editedRoles }),
            $"Роли {account.Email} изменены. У вошедшего пользователя они обновятся при следующем входе.");
        if (!messageIsError) rolesFor = null;
    }

    private Guid? passwordFor;
    private string newPassword = "";

    private async Task SetPasswordAsync(Account account)
    {
        await RunAsync(() => Http.PostAsJsonAsync($"api/admin/users/{account.Id}/password", new { password = newPassword }),
            $"Для {account.Email} задан новый временный пароль — сообщите его сотруднику.");
        if (!messageIsError) (passwordFor, newPassword) = (null, "");
    }

    private Task SetEnabledAsync(Account account, bool enabled) =>
        RunAsync(() => Http.PostAsync($"api/admin/users/{account.Id}/{(enabled ? "activate" : "deactivate")}", null),
            enabled ? $"Учётная запись {account.Email} возвращена." : $"Учётная запись {account.Email} отключена: вход запрещён.");

    // Действие с учётной записью: сообщение об итоге и обновлённый список.
    private async Task RunAsync(Func<Task<HttpResponseMessage>> send, string done)
    {
        try
        {
            var response = await send();
            if (response.IsSuccessStatusCode)
            {
                (messageIsError, message) = (false, done);
                await LoadAccountsAsync();
                return;
            }
            var problem = await response.Content.ReadFromJsonAsync<Problem>();
            (messageIsError, message) = (true, problem?.Errors is { Count: > 0 } errors
                ? string.Join(" ", errors.SelectMany(e => e.Value))
                : problem?.Detail ?? problem?.Title ?? $"Ответ сервера: {(int)response.StatusCode}");
        }
        catch (AccessTokenNotAvailableException e)
        {
            e.Redirect();
        }
    }

    // Названия ролей — в порядке списка ролей системы.
    private static string RolesTitle(IReadOnlyCollection<string> roles) =>
        roles.Count == 0 ? "—" : string.Join(", ", Roles.Where(r => roles.Contains(r.Code)).Select(r => r.Title));

    private static string Describe(DirectoryRecord r) =>
        string.Join(", ", new[] { r.ShortName, r.Position, r.Department }.Where(s => !string.IsNullOrEmpty(s)))
        + (r.IsActive ? "" : " (неактивна)");

    private sealed class NewUser
    {
        [Required(ErrorMessage = "Введите email"), EmailAddress(ErrorMessage = "Некорректный email")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Введите ФИО")]
        public string FullName { get; set; } = "";

        [Required(ErrorMessage = "Введите пароль"), MinLength(8, ErrorMessage = "Не короче 8 символов")]
        public string Password { get; set; } = "";

        public HashSet<string> Roles { get; } = ["teacher"];
    }

    private sealed record DirectoryRecord(
        Guid Id, string ShortName, string? FullName, string? Position, string? OfficialDesignation, string? Department, bool IsActive);
    private sealed record Account(Guid Id, string Email, string FullName, List<string> Roles, DirectoryRecord? Directory, bool IsActive = true);
    private sealed record Problem(string? Title, string? Detail, Dictionary<string, string[]>? Errors);
}
