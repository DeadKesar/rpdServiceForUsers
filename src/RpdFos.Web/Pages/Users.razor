@page "/users"
@attribute [Authorize(Roles = "admin")]
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@inject HttpClient Http

<PageTitle>Пользователи</PageTitle>

<h1>Новый пользователь</h1>

<EditForm Model="model" OnValidSubmit="CreateAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-2">
        <label class="form-label">Email</label>
        <InputText class="form-control" @bind-Value="model.Email" />
    </div>
    <div class="mb-2">
        <label class="form-label">ФИО</label>
        <InputText class="form-control" @bind-Value="model.FullName" />
    </div>
    <div class="mb-2">
        <label class="form-label">Временный пароль</label>
        <InputText class="form-control" type="password" @bind-Value="model.Password" />
    </div>
    <div class="mb-3">
        <label class="form-label">Роль</label>
        <InputSelect class="form-select" @bind-Value="model.Role">
            <option value="teacher">Преподаватель</option>
            <option value="methodist">Методист</option>
            <option value="approver">Утверждающий</option>
            <option value="admin">Администратор</option>
        </InputSelect>
    </div>

    <button class="btn btn-primary" type="submit">Создать</button>
</EditForm>

@if (message is not null)
{
    <p class="mt-3">@message</p>
}

@code {
    private readonly NewUser model = new();
    private string? message;

    private async Task CreateAsync()
    {
        var response = await Http.PostAsJsonAsync("api/admin/users", model);
        message = response.IsSuccessStatusCode
            ? $"Пользователь {model.Email} создан."
            : $"Ошибка {(int)response.StatusCode}: {await response.Content.ReadAsStringAsync()}";
    }

    private sealed class NewUser
    {
        [Required(ErrorMessage = "Введите email"), EmailAddress(ErrorMessage = "Некорректный email")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Введите ФИО")]
        public string FullName { get; set; } = "";

        [Required(ErrorMessage = "Введите пароль"), MinLength(8, ErrorMessage = "Не короче 8 символов")]
        public string Password { get; set; } = "";

        public string Role { get; set; } = "teacher";
    }
}
