<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <!-- Зачем: OpenIddict.AspNetCore 7.7.2 транзитивно тянет System.Security.Cryptography.Pkcs и .Xml 10.0.11
         с известными уязвимостями (NuGetAudit NU1902/NU1903). Явные ссылки поднимают их до исправленной версии;
         убрать, когда OpenIddict перейдёт на исправленные версии. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <!-- JavaScript без браузера: логику таблиц редактора (wwwroot/js/rpdfos-table-logic.js) проверяют чистые функции
         в интерпретаторе, а не Node. BSD-2-Clause; Acornima — BSD-3-Clause. -->
    <PackageReference Include="Jint" Version="4.18.0" />
    <!-- Текст PDF печатной формы: номера страниц оглавления сверяются с фактическими (этап 8, A13). Apache-2.0, та же версия, что в
         tools/RpdFos.Corpus; в поставку не входит. -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\RpdFos.Api\RpdFos.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Реальные файлы этапа 2 для тестов импорта, см. tests/fixtures/README.md. -->
    <None Include="..\fixtures\*.xlsx;..\fixtures\*.docx" LinkBase="fixtures" CopyToOutputDirectory="PreserveNewest" />
    <!-- Логика таблиц редактора: тот же файл, что грузит браузер. -->
    <None Include="..\..\src\RpdFos.Web\wwwroot\js\rpdfos-table-logic.js" Link="js\rpdfos-table-logic.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
